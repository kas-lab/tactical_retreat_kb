define

## Attributes

### ROSNode attributes
package sub attribute,
    value string;
executable sub attribute,
    value string;
lifecycle_state sub attribute,
    value string,
    regex "^(unconfigured|inactive|active|finalized)$";

### Runtime node attributes
node_name sub attribute,
    value string;
namespace sub attribute,
    value string;
start_time sub attribute,
    value datetime;
end_time sub attribute,
    value datetime;

### ROS interfaces attributes
name sub attribute,
    value string;
interface_type sub attribute,
    value string;
# topic_type sub attribute,
#     value string;
# service_type sub attribute,
#     value string;
# action_type sub attribute,
#     value string;

# topic_name sub attribute,
#     value string;
# service_name sub attribute,
#     value string;
# action_name sub attribute,
#     value string;

gid sub attribute,
    value long;

### QoS attributes
reliabilty sub attribute,
    value string,
    regex "^(BEST_EFFORT|RELIABLE)";
history sub attribute,
    value string,
    regex "^(KEEP_LAST|KEEP_ALL|UNKOWN)";
depth sub attribute,
    value long;
durability sub attribute,
    value string,
    regex "^(TRANSIENT_LOCAL|VOLATILE)";
deadline sub attribute,
    value double;  # 0.0 indicates infinite
lifespan sub attribute,
    value double;  # 0.0 indicates infinite
liveliness sub attribute,
    value string,
    regex "^(AUTOMATIC|MANUAL)";
lease_duration sub attribute,
    value double;  # 0.0 indicates infinite

### Parameter attributes
parameter_name sub attribute,
    value string;

default_value sub attribute,
    value boolean;

### Follows ROS2 ParameterValue name convention: https://docs.ros2.org/foxy/api/rcl_interfaces/msg/ParameterValue.html
bool_value sub attribute,
    value boolean;
integer_value sub attribute,
    value long;
double_value sub attribute,
    value double;
string_value sub attribute,
    value string;

### parameter value index
parameter_value_index sub attribute,
    value long;

## Entities

ROSNode sub entity,
    owns node_name @key,
    owns namespace,
    owns start_time,
    owns end_time,
    plays has_interface:node,
    plays has_parameter:node,
    plays has_parameter_value:node,
    plays node_deployment:node;

LifeCycleNode sub ROSNode,
    owns lifecycle_state;

### ROS interfaces
ROSInterface sub entity,
    abstract,
    owns name,
    owns interface_type,
    plays has_interface:afferent,
    plays has_interface:efferent;

TopicInterface sub ROSInterface,
    abstract,
    owns gid,
    plays has_qos:topic;
Subscriber sub TopicInterface,
    plays has_topic:subscriber;
Publisher sub TopicInterface,
    plays has_topic:publisher;

QoSProfile sub entity,
    owns reliabilty,
    owns history,
    owns depth,
    owns durability,
    owns deadline,
    owns lifespan,
    owns liveliness,
    owns lease_duration,
    plays has_qos:qos;

ServiceInterface sub ROSInterface,
    abstract;
ServiceClient sub ServiceInterface,
    plays has_service:client;
ServiceServer sub ServiceInterface,
    plays has_service:server;

ActionInterface sub ROSInterface,
    abstract;
ActionClient sub ActionInterface,
    plays has_action:client;
ActionServer sub ActionInterface,
    plays has_action:server;

has_qos sub relation,
    relates topic,
    relates qos;

has_interface sub relation,
    abstract,
    relates node,
    relates afferent,
    relates efferent;

has_topic sub has_interface,
    relates subscriber as afferent,
    relates publisher as efferent;

has_service sub has_interface,
    relates client as afferent,
    relates server as efferent;

has_action sub has_interface,
    relates client as afferent,
    relates server as efferent;

### Parameter related entities
Parameter sub entity,
    owns parameter_name,
    plays has_parameter:parameter,
    plays has_parameter_value:parameter;

ParameterBool sub Parameter;
ParameterInteger sub Parameter;
ParameterDouble sub Parameter;
ParameterString sub Parameter;

ParameterBoolArray sub Parameter;
ParameterIntegerArray sub Parameter;
ParameterStringArray sub Parameter;
ParameterDoubleArray sub Parameter;

ParameterValue sub entity,
    abstract,
    plays at_index:parameter_value,
    plays has_parameter_value:parameter_value;

ParameterValueBool sub ParameterValue,
    owns bool_value;
ParameterValueInteger sub ParameterValue,
    owns integer_value;
ParameterValueDouble sub ParameterValue,
    owns double_value;
ParameterValueString sub ParameterValue,
    owns string_value;

ParameterValueArray sub ParameterValue,
    plays at_index:parameter_array;

## Relations
has_parameter sub relation,
    relates node,
    relates parameter;

has_parameter_value sub relation,
    owns default_value,
    relates node,
    relates parameter,
    relates parameter_value;

at_index sub relation,
    owns parameter_value_index,
    relates parameter_array,
    relates parameter_value;

node_deployment sub relation,
    owns package,
    owns executable,
    relates node;
