define

## Attributes

### ROSNode attributes
package sub attribute,
    value string;
executable sub attribute,
    value string;
lifecycle_state sub attribute,
    value string;

### Runtime node attributes
node_name sub attribute,
    value string;
namespace sub attribute,
    value string;
start_time sub attribute,
    value datetime;
end_time sub attribute,
    value datetime;

### ROS interfaces attributes
topic_type sub attribute,
    value string;
service_type sub attribute,
    value string;
action_type sub attribute,
    value string;

topic_name sub attribute,
    value string;
service_name sub attribute,
    value string;
action_name sub attribute,
    value string;

### QoS attributes
reliabilty sub attribute,
    value string,
    regex "^(BEST_EFFORT|RELIABLE)";
history sub attribute,
    value string,
    regex "^(KEEP_LAST|KEEP_ALL|UNKOWN)";
depth sub attribute,
    value long;
durability sub attribute,
    value string,
    regex "^(TRANSIENT_LOCAL|VOLATILE)";
deadline sub attribute,
    value double;  # 0.0 indicates infinite
lifespan sub attribute,
    value double;  # 0.0 indicates infinite
liveliness sub attribute,
    value string,
    regex "^(AUTOMATIC|MANUAL)"; 
lease_duration sub attribute,
    value double;  # 0.0 indicates infinite

### Parameter attributes
parameter_name sub attribute,
    value string;

bool_value sub attribute,
    value boolean;
integer_value sub attribute,
    value long;
double_value sub attribute,
    value double;
string_value sub attribute,
    value string;

bool_array_value sub attribute,
    value string;
integer_array_value sub attribute,
    value string;
double_array_value sub attribute,
    value string;
string_array_value sub attribute,
    value string;

## Entities

ROSNode sub entity,
    owns package,
    owns executable,
    plays ros_topic:publisher,
    plays ros_topic:subscriber,
    plays ros_service:server,
    plays ros_service:client,
    plays ros_action:server,
    plays ros_action:client,
    plays has_parameter:node,
    plays runtime_node:node;

LifeCycleNode sub ROSNode,
    owns lifecycle_state;

QoSProfile sub entity,
    owns reliabilty,
    owns history,
    owns depth,
    owns durability,
    owns deadline,
    owns lifespan,
    owns liveliness, 
    owns lease_duration,
    plays ros_topic:qos;

Parameter sub entity,
    owns parameter_name,
    plays has_parameter:parameter;

ParameterBool sub Parameter,
    owns bool_value;
ParameterInteger sub Parameter,
    owns integer_value;
ParameterDouble sub Parameter,
    owns double_value;
ParameterString sub Parameter,
    owns string_value;

ParameterBoolArray sub Parameter,
    owns bool_array_value;
ParameterIntegerArray sub Parameter,
    owns integer_array_value;
ParameterDoubleArray sub Parameter,
    owns double_array_value;
ParameterStringArray sub Parameter,
    owns string_array_value;

## Relations
ros_interface sub relation,
    abstract;

ros_topic sub ros_interface,
    owns topic_type,
    owns topic_name,
    relates publisher,
    relates subscriber,
    relates qos;

ros_service sub ros_interface,
    owns service_name,
    owns service_type,
    relates server,
    relates client;

ros_action sub ros_interface,
    owns action_name,
    owns action_type,
    relates server,
    relates client;

has_parameter sub relation,
    relates node,
    relates parameter;

runtime_node sub relation,
    owns node_name @key,
    owns namespace,
    owns start_time,
    owns end_time,
    relates node;
