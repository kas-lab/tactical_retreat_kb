insert

## Examples from RELAXED paper
$smart_house isa System, has system_name "Smart House";

### Requirement 1.1
$foodpackage_proposition isa Proposition,
	has quantified_value 0.232321, # just an example, this should be inserted at runtime
	has description "The fridge detects and communicates information with food packages";

$food_packages_set isa FuzzySigmoid,
	has inflection_point 5.0,
	has expoent 0.5889;

$as_many_food_as_possible (set: $food_packages_set, term: $foodpackage_proposition) isa as_many_as_possible_expression;
$food_shall_expression (expression: $as_many_food_as_possible) isa shall_expression;

$r1_1 (system: $smart_house, expression: $food_shall_expression) isa relaxed_requirement,
	has requirement_name "R1.1 As many food as possible",
	has description "The fridge SHALL detect and communicate information with AS MANY food packages AS POSSIBLE.";

### Requirement 1.2
$dietplan_proposition isa Proposition,
	has quantified_value 1820, # just an example, this should be inserted at runtime
	has description "The fridge suggests a dietplan";

$calories_set isa FuzzyExponentialDecay,
	has expoent 0.01;

$calories_as_close_expression (set: $calories_set, term: $dietplan_proposition) isa as_close_as_possible_expression,
	has required_value 1800;

$calories_dietplan_shall_expression (expression: $calories_as_close_expression) isa shall_expression;

$calorie_consumption_proposition isa Proposition,
	has quantified_value 2200, # just an example, this should be inserted at runtime
	has description "The fridge adjusts the dietplan in line with Mary’s actual calorie consumption";

$calories_consumption_shall_expression (term: $calorie_consumption_proposition) isa shall_expression;

$r1_2 (system: $smart_house, expression: $calories_dietplan_shall_expression, expression: $calories_consumption_shall_expression) isa relaxed_requirement,
	has requirement_name "R1.2 Dietplan",
	has description "The fridge SHALL suggest a dietplan with total calories AS CLOSE AS POSSIBLE TO the daily ideal calories. The fridge SHALL adjust the dietplan in line with Mary’s actual calorie consumption.";

### Requirement 1.3
$liquid_intake_proposition isa Proposition,
	has quantified_value 1.9, # just an example, this should be inserted at runtime
	has description "The system ensures a liquid intake";

$liquid_set isa FuzzyExponentialDecay,
	has expoent -0.85;

$liquid_intake_as_close_expression (set: $liquid_set, term: $liquid_intake_proposition) isa as_close_as_possible_expression,
	has required_value 2.0;

$liquid_intake_shall_expression (expression: $liquid_intake_as_close_expression) isa shall_expression;

$minimum_liquid_intake_proposition isa Proposition,
	has quantified_value 1.5, # different from the other proposition I believe this is design time info
	has description "The system ensures minimum liquid intake";
$liquid_intake_before_expression (term: $minimum_liquid_intake_proposition) isa before_expression, has duration 21.0;
$minmum_liquid_intake_shall_expression (expression: $liquid_intake_before_expression) isa shall_expression;

$r1_3 (system: $smart_house, expression: $liquid_intake_shall_expression, expression: $minmum_liquid_intake_shall_expression) isa relaxed_requirement,
	has requirement_name "R1.3 Liquid intake",
	has description "The system SHALL ensure that Mary’s liquid intake is as AS CLOSE AS POSSIBLE TO ideal during the course of the day. The system SHALL ensure minimum liquid intake BEFORE bedtime.";

## Examples Mirte's MVP use case

$veloicity_proposition isa Proposition,
	has quantified_value 0.21221, # just an example, this should be inserted at runtime
	has description "The robot maintain its velocity";

$velocity_set isa FuzzyRationalDecay,
	has curvature 0.08;

$velocity_as_close_expression (set: $velocity_set, term: $veloicity_proposition) isa as_close_as_possible_expression,
	has required_value 0.26;

$velocity_shall_expression (expression: $velocity_as_close_expression) isa shall_expression;

$mirte isa System, has system_name "Mirte";

$velocity_requirement (system: $mirte, expression: $velocity_shall_expression) isa relaxed_requirement,
	has requirement_name "R1.1 Velocity",
	has description "The robot SHALL maintain its velocity AS CLOSE AS POSSIBLE TO 0.26 m/s.";