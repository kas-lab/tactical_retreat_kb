$ta_maxspeedinternal isa Tactic, has tactic_name "MaxSpeedInternal", has tactic_period 0;

# define Feature Model
$f_low_speed isa Feature, has feature_name "LOW_SPEED", has feature_mandatory false, has feature_selected true;
$f_med_speed isa Feature, has feature_name "MED_SPEED", has feature_mandatory false, has feature_selected false;
$f_hi_speed isa Feature, has feature_name "HI_SPEED", has feature_mandatory false, has feature_selected false;
$f_one_speed isa Feature, has feature_name "ONE_SPEED", has feature_mandatory false, has feature_selected false;
$f_velocity_smoother isa Feature, has feature_name "VELOCITY_SMOOTHER", has feature_mandatory false, has feature_selected true;

$context_model_node_node isa ROSNode,
            has node_name "context_model_node",
            has namespace "";
$context_model_node_node_pub isa Publisher,
has interface_name "nearest_object",
has interface_type "std_msgs/Float32";

(node: $context_model_node_node, publisher: $context_model_node_node_pub) isa has_topic;
$context_model_node_node_pub_1 isa Publisher,
has interface_name "movement_power",
has interface_type "std_msgs/Float32";

(node: $context_model_node_node, publisher: $context_model_node_node_pub_1) isa has_topic;
$t_measured_nearest_object isa Measure, has measure_name "nearest_object";

(measure: $t_measured_nearest_object, source: $bt_navigator_node_action_server, output: $context_model_node_node_pub) isa measurement_interface;
$t_measured_movement_power isa Measure, has measure_name "movement_power";

(measure: $t_measured_movement_power, source: $velocity_smoother_node_pub, output: $context_model_node_node_pub_1) isa measurement_interface;

$movement_power_greater_val isa ValueDouble, has double_value 40.0;
$movement_power_greater (lhs_value:$t_measured_movement_power, rhs_value: $movement_power_greater_val) isa inequality_expression, has operator ">";
$tactic_rule_min (tactic:$ta_maxspeedinternal, antecedent:$movement_power_greater, consequent:$f_low_speed ) isa tactic_rule, has rule_name "MIN";
$movement_power_less_val isa ValueDouble, has double_value 40.0;
$movement_power_less (lhs_value:$t_measured_movement_power, rhs_value: $movement_power_less_val) isa inequality_expression, has operator "<";
$movement_power_greater_1_val isa ValueDouble, has double_value 39.0;
$movement_power_greater_1 (lhs_value:$t_measured_movement_power, rhs_value: $movement_power_greater_1_val) isa inequality_expression, has operator ">";
$and_mov_mov (expression:$movement_power_less, expression:$movement_power_greater_1) isa and_expression;
$tactic_rule_med (tactic:$ta_maxspeedinternal, antecedent:$and_mov_mov, consequent:$f_med_speed ) isa tactic_rule, has rule_name "MED";
$movement_power_less_1_val isa ValueDouble, has double_value 39.0;
$movement_power_less_1 (lhs_value:$t_measured_movement_power, rhs_value: $movement_power_less_1_val) isa inequality_expression, has operator "<";
$tactic_rule_max (tactic:$ta_maxspeedinternal, antecedent:$movement_power_less_1, consequent:$f_hi_speed ) isa tactic_rule, has rule_name "MAX";
$max_velocity_param_pvalue_3 isa ValueArray;    
$sp_max_velocity (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $max_velocity_param_pvalue_3) isa set_nodes_parameters;

$low_speed_resolution (
    resolution_action: $sp_max_velocity
, variant: $f_low_speed) isa variant_resolution;
$max_velocity_param_pvalue_3 isa ValueArray;    
$sp_max_velocity_1 (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $max_velocity_param_pvalue_3) isa set_nodes_parameters;

$med_speed_resolution (
    resolution_action: $sp_max_velocity_1
, variant: $f_med_speed) isa variant_resolution;
$max_velocity_param_pvalue_3 isa ValueArray;    
$sp_max_velocity_2 (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $max_velocity_param_pvalue_3) isa set_nodes_parameters;

$hi_speed_resolution (
    resolution_action: $sp_max_velocity_2
, variant: $f_hi_speed) isa variant_resolution;
$odom_duration_param_pvalue isa ValueDouble;    
$sp_odom_duration (node: $velocity_smoother_node, parameter: $odom_duration_param, parameter_value: $odom_duration_param_pvalue) isa set_nodes_parameters;
$max_velocity_param_pvalue_3 isa ValueArray;    
$sp_max_velocity_3 (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $max_velocity_param_pvalue_3) isa set_nodes_parameters;

$one_speed_resolution (
    resolution_action: $sp_odom_duration, 
    resolution_action: $sp_max_velocity_3
, variant: $f_one_speed) isa variant_resolution;
$slc_velocity_smoother_inactive (node: $velocity_smoother_node) isa set_lifecycle_state, has lifecycle_state "inactive";

$velocity_smoother_resolution (
    resolution_action: $slc_velocity_smoother_inactive
, variant: $f_velocity_smoother) isa variant_resolution;
$res_rebetmc (tactic: $ta_maxspeedinternal, variant_resolution:$low_speed_resolution, variant_resolution:$med_speed_resolution, variant_resolution:$hi_speed_resolution, variant_resolution:$one_speed_resolution, variant_resolution:$velocity_smoother_resolution) isa resolution_model, 
    has resolution_model_name "rebetmc", has ros_system "rebet_mirte";



