match

$velocity_smoother_node isa LifeCycleNode,
    has node_name "velocity_smoother";
$max_velocity_param isa ParameterDoubleArray,
    has parameter_name "max_velocity";
$max_velocity_has_param_value (node: $velocity_smoother, parameter: $max_velocity_param, parameter_value: $param_value_array)
    isa has_parameter_value;
(parameter_array: $param_value_array, parameter_value: $param_value)
    isa at_index;
$param_value isa ParameterValueDouble;

fetch
    $param_value: attribute;
