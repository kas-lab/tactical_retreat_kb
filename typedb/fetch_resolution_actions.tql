match
    $r (tactic:$t, consequent:$c) isa tactic_rule, has rule_valid true;
    $c has term_name $consequent_name;
    (tactic:$t, variant_resolution:$vr) isa resolution_model;
    $vr (resolution_action:$res_action) isa variant_resolution, has variant_name $variant_name;
    $variant_name == $consequent_name;
fetch
    set_parameter_action:{
        match
            $res_action (node: $node, parameter: $parameter) isa! set_nodes_parameters;
        fetch
            $node: node_name;
            $parameter: parameter_name;
            param_values: {
                match
                    $parameter (parameter_value: $parameter_value) isa parameter;
                fetch
                  $parameter_value: attribute;
            };
    };
    set_lifecycle_action:{
        match
            $res_action (node: $node) isa! set_lifecycle_state;
        fetch
            $node: node_name;
            $res_action: lifecycle_state;
    };
