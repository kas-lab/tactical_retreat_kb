match

$velocity_smoother_node isa LifeCycleNode,
	has node_name "velocity_smoother";

insert

# context model
$ea_nearest_object isa EnvironmentalAttribute, has measure_name "ea_nearest_object";
$qa_movement_power isa QualityAttribute, has measure_name "qa_movement_power";

## example measurement
(measure: $ea_nearest_object) isa measurement,
        has measurement_time 2025-09-06T12:57:56.666,
        has measurement_value 0.09;

## Nearest object
$scan_filtered_pub isa Publisher,
	has interface_name '/scan_filtered',
    has interface_type 'sensor_msgs/msg/LaserScan';
$sensor_qos isa QoSProfile,
	has reliability 'BEST_EFFORT',
	has history 'KEEP_LAST',
	has depth 5,
	has durability 'VOLATILE',
	has lifespan 0,
	has deadline 0,
	has liveliness 'SYSTEM_DEFAULT',
	has lease_duration 0;
(interface: $scan_filtered_pub, qos: $sensor_qos) isa has_qos;
(measure: $ea_nearest_object, publisher: $scan_filtered_pub) isa measurement_interface,
    has measurement_function_name 'get_nearest_scan_distance_in_base',
    has measurement_function_lib 'ros_monitors.laser_scan_functions',
    has measurement_function_args 'base_link';

# define Feature Model
$f_max_speed isa Feature, has feature_name "MAX_SPEED";
$f_low_speed isa Feature, has feature_name "LOW_SPEED";
$f_hi_speed isa Feature, has feature_name "HIGH_SPEED";
$f_med_speed isa Feature, has feature_name "MED_SPEED";
$alternative (parent: $f_max_speed, child: $f_low_speed, child: $f_med_speed, child: $f_hi_speed) isa alternative;

# define MaxSpeedInternal Tactic
$ta_max_speed isa Tactic, has tactic_name "MaxSpeedInternal", has tactic_period 1.0;

# nearest_object < 0.1
$ineq_nearest_lower_than_10 (lhs_value:$ea_nearest_object) isa inequality_expression,
	has operator "<", has rhs_value 0.1;
# movement power > 40.0
$ineq_mv_pwer_greater_than_40  (lhs_value:$qa_movement_power) isa inequality_expression,
	has operator ">", has rhs_value 40.0;
# (nearest_object < 0.1) or (movement power > 40.0)
$or_expression (expression:$ineq_nearest_lower_than_10, expression:$ineq_mv_pwer_greater_than_40) isa or_expression;

# nearest_object > 0.15
$ineq_nearest_greater_than_15 (lhs_value:$ea_nearest_object) isa inequality_expression,
	has operator ">", has rhs_value 0.15;
# movement power < 40.0
$ineq_mv_pwer_lower_than_39  (lhs_value:$qa_movement_power) isa inequality_expression,
	has operator "<", has rhs_value 39.0;
# (nearest_object > 0.15) and (movement power < 40.0)
$and_expression (expression:$ineq_nearest_greater_than_15, expression:$ineq_mv_pwer_lower_than_39) isa and_expression;

$tatic_rule_min (tactic:$ta_max_speed, antecedent:$or_expression, consequent:$f_low_speed ) isa tactic_rule, has rule_name "MIN";
$tatic_rule_max (tactic:$ta_max_speed, antecedent:$and_expression, consequent:$f_hi_speed ) isa tactic_rule, has rule_name "MAX";
$tatic_rule_med (tactic:$ta_max_speed, antecedent:$ineq_nearest_greater_than_15, consequent:$f_med_speed ) isa tactic_rule, has rule_name "MED";

# define parameter max_speed
$p_max_speed isa Parameter, has parameter_name "max_velocity";

# define parameter values low
$p_max_velocity_x_low isa ParameterValueDouble, has double_value 0.10;
$p_max_velocity_y_low isa ParameterValueDouble, has double_value 0.0;
$p_max_velocity_z_low isa ParameterValueDouble, has double_value 1.0;
# define parameter array low
$p_max_speed_low_array isa ParameterValueArray;
$p_max_speed_low_array_0 (parameter_array: $p_max_speed_low_array, parameter_value: $p_max_velocity_x_low) isa at_index, has parameter_value_index 0;
$p_max_speed_low_array_1 (parameter_array: $p_max_speed_low_array, parameter_value: $p_max_velocity_y_low) isa at_index, has parameter_value_index 1;
$p_max_speed_low_array_2 (parameter_array: $p_max_speed_low_array, parameter_value: $p_max_velocity_z_low) isa at_index, has parameter_value_index 2;

# define parameter values med
$p_max_velocity_x_med isa ParameterValueDouble, has double_value 0.18;
$p_max_velocity_y_med isa ParameterValueDouble, has double_value 0.0;
$p_max_velocity_z_med isa ParameterValueDouble, has double_value 1.0;
# define parameter array med
$p_max_speed_med_array isa ParameterValueArray;
$p_max_speed_med_array_0 (parameter_array: $p_max_speed_med_array, parameter_value: $p_max_velocity_x_med) isa at_index, has parameter_value_index 0;
$p_max_speed_med_array_1 (parameter_array: $p_max_speed_med_array, parameter_value: $p_max_velocity_y_med) isa at_index, has parameter_value_index 1;
$p_max_speed_med_array_2 (parameter_array: $p_max_speed_med_array, parameter_value: $p_max_velocity_z_med) isa at_index, has parameter_value_index 2;

# define parameter values high
$p_max_velocity_x_high isa ParameterValueDouble, has double_value 0.26;
$p_max_velocity_y_high isa ParameterValueDouble, has double_value 0.0;
$p_max_velocity_z_high isa ParameterValueDouble, has double_value 1.0;
# define parameter array high
$p_max_speed_high_array isa ParameterValueArray;
$p_max_speed_high_array_0 (parameter_array: $p_max_speed_high_array, parameter_value: $p_max_velocity_x_high) isa at_index, has parameter_value_index 0;
$p_max_speed_high_array_1 (parameter_array: $p_max_speed_high_array, parameter_value: $p_max_velocity_y_high) isa at_index, has parameter_value_index 1;
$p_max_speed_high_array_2 (parameter_array: $p_max_speed_high_array, parameter_value: $p_max_velocity_z_high) isa at_index, has parameter_value_index 2;

# define set nodes parameter actions
$sp_max_speed_low (node: $velocity_smoother_node, parameter: $p_max_speed, parameter_value: $p_max_speed_low_array) isa set_nodes_parameters;
$sp_max_speed_med (node: $velocity_smoother_node, parameter: $p_max_speed, parameter_value: $p_max_speed_med_array) isa set_nodes_parameters;
$sp_max_speed_high (node: $velocity_smoother_node, parameter: $p_max_speed, parameter_value: $p_max_speed_high_array) isa set_nodes_parameters;

# define variant resolutions
$low_speed_resolution (resolution_action: $sp_max_speed_low, variant: $f_low_speed) isa variant_resolution;
$med_speed_resolution (resolution_action: $sp_max_speed_med, variant: $f_med_speed) isa variant_resolution;
$high_speed_resolution (resolution_action: $sp_max_speed_high, variant: $f_hi_speed) isa variant_resolution;

$res_rebetmc (tactic: $ta_max_speed,
	variant_resolution:$low_speed_resolution,
	variant_resolution:$med_speed_resolution,
	variant_resolution:$high_speed_resolution) isa resolution_model,
    has resolution_model_name "rebetmc", has ros_system "nav2";
