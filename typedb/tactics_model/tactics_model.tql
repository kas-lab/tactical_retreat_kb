define

ros_system sub attribute,
    value string;

name sub attribute,
    abstract,
    value string;

resolution_model_name sub name;
tactic_name sub name;
rule_name sub name;
term_name sub name;
variant_name sub name;

tactic_period sub attribute,
    value double;

tactic_resolution_model sub attribute,
    value string;

tactic_select_variant sub attribute,
    value string;

expression_valid sub attribute,
    value boolean;
rule_valid sub attribute,
    value boolean;

rhs_value sub attribute,
    value double;

operator sub attribute,
    value string,
    regex "^(<|<=|>|>=|==|!=)";

term_value sub attribute,
    value double;

### Relations
tactic_rule sub relation,
    owns rule_name @key,
    owns rule_valid,
    relates tactic,
    relates antecedent,
    relates consequent;

#### expressions
expression sub relation,
    abstract,
    owns expression_valid,
    plays tactic_rule:antecedent;

and_expression sub expression,
    relates expression,
    plays tactic_rule:consequent;

or_expression sub expression,
    relates expression;

inequality_expression sub expression,
    owns operator,
    owns rhs_value,
    relates lhs_value,
    plays and_expression:expression,
    plays or_expression:expression;

#### resolution model
resolution_model sub relation,
    owns resolution_model_name @key,
    owns ros_system,
    relates tactic,
    relates variant_resolution;

variant_resolution sub relation,
    relates resolution_action,
    relates variant,
    plays resolution_model:variant_resolution;

resolution_action sub relation,
    abstract,
    relates node,
    plays variant_resolution:resolution_action;

set_nodes_parameters sub resolution_action,
    relates parameter,
    relates parameter_value;

set_lifecycle_state sub resolution_action,
    owns lifecycle_state;

### Entities
Tactic sub entity,
    owns tactic_name @key,
    owns tactic_period,
    plays tactic_rule:tactic,
    plays resolution_model:tactic;

measure_name sub name;
description sub attribute,
    value string;

measurement_time sub attribute,
    value datetime;
measurement_value sub attribute,
    value double;
latest sub attribute,
    value boolean;

Measure sub entity,
    owns measure_name @key,
    owns description,
    plays measurement:measure,
    plays measurement_interface:measure,
    plays inequality_expression:lhs_value;

measurement sub relation,
    owns measurement_time,
    owns measurement_value,
    owns latest,
    relates measure;

measurement_function_name sub attribute,
    value string;
measurement_function_lib sub attribute,
    value string;
measurement_function_args sub attribute,
    value string;

measurement_interface sub relation,
    owns measurement_function_name,
    owns measurement_function_lib,
    owns measurement_function_args,
    relates measure,
    relates publisher,
    relates service,
    relates action;

Publisher plays measurement_interface:publisher;
ServiceServer plays measurement_interface:service;
ActionServer plays measurement_interface:action;

ROSNode plays resolution_action:node;

Parameter plays set_nodes_parameters:parameter;

ParameterValue plays set_nodes_parameters:parameter_value;

# rules
rule measurement_latest:
    when {
        $measurement (measure: $measure) isa measurement,
            has measurement_time $time,
            has measurement_value $measurement_value;
        not {
            $measurement2 (measure: $measure) isa measurement,
                has measurement_time $time2,
                has measurement_value $measurement_value2;
            $time2 > $time;
        };
    } then {
        $measurement has latest true;
    };

rule tactic_rule_valid:
    when {
        $tr (antecedent: $a) isa tactic_rule;
        $a isa expression, has expression_valid $expression_valid;
        ?rule_valid = $expression_valid;
    } then {
        $tr has rule_valid ?rule_valid;
    };

rule and_expression_valid:
    when {
        $and_exp (expression: $e) isa and_expression;
        $e has expression_valid true;
        not {
            $and_exp (expression: $invalid_e) isa and_expression;
            $invalid_e has expression_valid false;
        };
    } then {
        $and_exp has expression_valid true;
    };

rule and_expression_invalid:
    when {
        $and_exp (expression: $e) isa and_expression;
        $e has expression_valid false;
    } then {
        $and_exp has expression_valid false;
    };

rule or_expression_valid:
    when {
        $or_exp (expression: $e) isa or_expression;
        $e has expression_valid true;
    } then {
        $or_exp has expression_valid true;
    };

rule or_expression_invalid:
    when {
        $or_exp isa or_expression;
        not {
            $or_exp (expression: $valid_e) isa or_expression;
            $valid_e has expression_valid true;
        };
    } then {
        $or_exp has expression_valid false;
    };

rule inequality_expression_valid:
    when {
        $ineq_exp (lhs_value: $measure) isa inequality_expression,
            has rhs_value $rhs_value;
        (measure: $measure) isa measurement,
            has latest true, has measurement_value $measurement_value;
        {
            $ineq_exp has operator ">";
            $measurement_value > $rhs_value;
        } or {
            $ineq_exp has operator ">=";
            $measurement_value >= $rhs_value;
        } or {
            $ineq_exp has operator "<";
            $measurement_value < $rhs_value;
        } or {
            $ineq_exp has operator "<=";
            $measurement_value <= $rhs_value;
        } or {
            $ineq_exp has operator "==";
            $measurement_value == $rhs_value;
        } or {
            $ineq_exp has operator "!=";
            $measurement_value != $rhs_value;
        };
    } then {
        $ineq_exp has expression_valid  true;
    };

rule inequality_expression_invalid:
    when {
        $ineq_exp (lhs_value: $measure) isa inequality_expression,
            has rhs_value $rhs_value;
        {
            not {
                (measure: $measure) isa measurement,
                    has latest true,
                    has measurement_value $measurement_value;
            };
        } or {
            (measure: $measure) isa measurement,
                has latest true,
                has measurement_value $measurement_value;
            $ineq_exp has operator ">";
            $measurement_value <= $rhs_value;
        } or {
            (measure: $measure) isa measurement,
                has latest true,
                has measurement_value $measurement_value;
            $ineq_exp has operator ">=";
            $measurement_value < $rhs_value;
        } or {
            (measure: $measure) isa measurement,
                has latest true,
                has measurement_value $measurement_value;
            $ineq_exp has operator "<";
            $measurement_value >= $rhs_value;
        } or {
            (measure: $measure) isa measurement,
                has latest true,
                has measurement_value $measurement_value;
            $ineq_exp has operator "<=";
            $measurement_value > $rhs_value;
        } or {
            (measure: $measure) isa measurement,
                has latest true,
                has measurement_value $measurement_value;
            $ineq_exp has operator "==";
            $measurement_value != $rhs_value;
        } or {
            (measure: $measure) isa measurement,
                has latest true,
                has measurement_value $measurement_value;
            $ineq_exp has operator "!=";
            $measurement_value == $rhs_value;
        };
    } then {
        $ineq_exp has expression_valid  false;
    };


