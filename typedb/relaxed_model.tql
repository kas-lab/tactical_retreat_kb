define

## Attributes
name sub attribute,
	abstract,
	value string;

system_name sub name,
	value string;
start_time sub attribute,
	value datetime;

requirement_name sub name,
	value string;
description sub attribute,
	value string;

bool_value sub attribute,
	value boolean;
required_value sub attribute,
	value double;
quantified_value sub attribute,
	value double;

duration sub attribute,
	value double;

### fuzzy attributes

expoent sub attribute,
	value double;
inflection_point sub attribute,
	value double;
curvature sub attribute,
	value double;

## Entities
System sub entity,
	owns system_name @key,
	owns start_time,
	plays system_requirement:system;

Term sub entity,
	abstract,
	plays expression:term;

BoolTerm sub Term,
	owns bool_value;
Proposition sub Term,
	owns quantified_value,
	owns description;

FuzzyVariable sub entity,
	abstract;

## fuzzy set with a membership function m(x) with the form
FuzzySet sub FuzzyVariable,
	plays fuzzy_set_expression:set;

### "as many as possible" fuzzy membership functions

## exponential saturation membership function
## m(x) = 1 - e^(-expoent * x), expoent > 0
FuzzyExponentialSaturation sub FuzzySet,
	owns expoent; # speed of saturation

## sigmoid membership function
## m(x) = 1 / (1 + e ^ -expoent*(x - x0))
FuzzySigmoid sub FuzzySet,
	owns expoent,
	owns inflection_point; # where m(inflection_point) = 0.5

## bounded linear fraction membership function (monotonic)
## m(x) = x / (x + curvature), curvature > 0
FuzzyBoundedLinearFraction sub FuzzySet,
	owns curvature; # controls the curvature

### "as few as possible"/"as close as possible" fuzzy membership functions

## exponential decay membership function
## m(x) = e^(-expoent * x), expoent > 0
FuzzyExponentialDecay sub FuzzySet,
	owns expoent;

## rational decay membership function
## m(x) = curvature / (x + curvature), curvature > 0
FuzzyRationalDecay sub FuzzySet,
	owns curvature;


## Relations
system_requirement sub relation,
	abstract,
	relates system;

relaxed_requirement sub system_requirement,
	owns requirement_name @key,
	owns description,
	relates expression;

expression sub relation,
	abstract,
	relates expression,
	relates term,
	plays relaxed_requirement:expression,
	plays expression:expression;

shall_expression sub expression;

fuzzy_set_expression sub expression,
	abstract,
	relates set;

as_close_as_possible_expression sub fuzzy_set_expression,
	owns required_value;

as_many_as_possible_expression sub fuzzy_set_expression;

event_expression sub expression,
	abstract,
	owns duration;  # duration as double or datetime?

after_expression sub event_expression;
before_expression sub event_expression;