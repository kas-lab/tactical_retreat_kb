rule comparison_expression_tactic_rule_dependency_not_equal_double_effect:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression isa not_equal;
        (tr_dependency: $tr_dependency, lhs_double: $lhs_double) isa tr_dependency_lhs_double_operand;
        $lhs_double has double_value $value_lhs;
        (tr_dependency: $tr_dependency, rhs_effect: $rhs_effect) isa tr_dependency_rhs_effect_operand;
        $rhs_effect has resulting_effect_value $value_rhs;
        $value_lhs != $value_rhs;
    } then {
        $tr_dependency has fulfillment 1.0;
    };

rule comparison_expression_tactic_rule_dependency_not_equal_double_double:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression isa not_equal;
        (tr_dependency: $tr_dependency, lhs_double: $lhs_double) isa tr_dependency_lhs_double_operand;
        $lhs_double has double_value $value_lhs;
        (tr_dependency: $tr_dependency, rhs_double: $rhs_double) isa tr_dependency_rhs_double_operand;
        $rhs_double has double_value $value_rhs;
        $value_lhs != $value_rhs;
    } then {
        $tr_dependency has fulfillment 1.0;
    };

rule comparison_expression_tactic_rule_dependency_fulfillment_0:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression isa comparison_expression;
        not {$tr_dependency has fulfillment 1.0;};
    } then {
        $tr_dependency has fulfillment 0.0;
    };

rule fuzzy_expression_quantified_value_effect:
	when {
		$fuzzy_expression (effect: $effect) isa fuzzy_comparison_expression;
        $effect (effect_value: $term) isa effect, has resulting_effect_value $quantified_value;

        {
			$fuzzy_expression  has offset_value $offset;
			?quantified_value_ = $quantified_value + $offset;
		} or {
			not {$fuzzy_expression has offset_value $offset;};
			?quantified_value_ = $quantified_value;
		};
		?quantified_value__ = ?quantified_value_;

	} then {
		$fuzzy_expression has quantified_value ?quantified_value__;
	};

# rule fuzzy_decay_tactic_rule_dependency_effect:
rule fuzzy_unimodal_expr_tactic_rule_dependency_effect:
	when {
		$tr_dependency (dependent: $fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$fuzzy_expression (fuzzy_set: $fuzzy_set, term: $term) isa fuzzy_unimodal_expression;
	} then {
        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_unimodal_expression;
	};

rule fuzzy_ascend_expr_tactic_rule_dependency_effect:
	when {
		$tr_dependency (dependent: $fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$fuzzy_expression (fuzzy_set: $fuzzy_set, term: $term) isa fuzzy_ascend_expression;
	} then {
        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_ascend_expression;
	};

rule fuzzy_decay_expr_tactic_rule_dependency_effect:
	when {
		$tr_dependency (dependent: $fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$fuzzy_expression (fuzzy_set: $fuzzy_set, term: $term) isa fuzzy_decay_expression;
	} then {
        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_decay_expression;
	};

rule fuzzy_expr_tactic_rule_dependency_fulfillment:
	when {
        $tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$expr (term: $term, fuzzy_set: $fuzzy_set) isa fuzzy_comparison_expression;
        $effect (measure: $term) isa effect;

        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_comparison_expression,
			has membership_degree $membership_degree;
        ?membership_degree_ = $membership_degree;
	} then {
		$tr_dependency has fulfillment ?membership_degree_;
	};

### as_close_as_possible_fuzzy_expression rules
rule as_close_as_possible_tactic_rule_dependency_effect:
	when {
        $tr_dependency (dependent: $relaxed_fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$relaxed_fuzzy_expression (term: $term, fuzzy_set: $fuzzy_set) isa as_close_as_possible_expression;
	} then {
		(effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_unimodal_expression;
	};

rule as_close_as_possible_tactic_rule_dependency_offset:
	when {
		$tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$fuzzy_expr (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_unimodal_expression;
        $effect (measure: $term) isa effect;

        $expr (term: $term, fuzzy_set: $fuzzy_set) isa as_close_as_possible_expression,
			has required_value $required_value;
		?offset_value_ = -1.0 * $required_value;
	} then {
		$fuzzy_expr has offset_value ?offset_value_;
	};

rule as_close_as_possible_tactic_rule_dependency_fulfillment:
	when {
        $tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$expr (term: $term, fuzzy_set: $fuzzy_set) isa as_close_as_possible_expression;
        $effect (measure: $term) isa effect;

        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_unimodal_expression,
            has membership_degree $membership_degree;
        ?membership_degree_ = $membership_degree;
	} then {
        $tr_dependency has fulfillment ?membership_degree_;
	};

### as_many_as_possible_fuzzy_expression rules
rule as_many_as_possible_tactic_rule_dependency_effect:
	when {
        $tr_dependency (dependent: $relaxed_fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$relaxed_fuzzy_expression (term: $term, fuzzy_set: $fuzzy_set) isa as_many_as_possible_expression;
	} then {
		(effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_ascend_expression;
	};

rule as_many_as_possible_tactic_rule_dependency_fulfillment:
	when {
        $tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$expr (term: $term, fuzzy_set: $fuzzy_set) isa as_many_as_possible_expression;
        $effect (measure: $term) isa effect;

        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_ascend_expression,
			has membership_degree $membership_degree;
        ?membership_degree_ = $membership_degree;
	} then {
		$tr_dependency has fulfillment ?membership_degree_;
	};

rule as_few_as_possible_tactic_rule_dependency_effect:
	when {
        $tr_dependency (dependent: $relaxed_fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$relaxed_fuzzy_expression (term: $term, fuzzy_set: $fuzzy_set) isa as_few_as_possible_expression;
	} then {
		(effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_decay_expression;
	};

rule as_few_as_possible_tactic_rule_dependency_fulfillment:
	when {
        $tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$expr (term: $term, fuzzy_set: $fuzzy_set) isa as_few_as_possible_expression;
        $effect (measure: $term) isa effect;

		(effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_decay_expression,
			has membership_degree $membership_degree;
        ?membership_degree_ = $membership_degree;
	} then {
		$tr_dependency has fulfillment ?membership_degree_;
	};

# Rules for tactic_rule_impacts_*
rule tactic_rule_impacts_requirements:
    when {
        $requirement isa relaxed_requirement;
        $tactic_rule isa tactic_rule;
    } then {
        (tactic_rule: $tactic_rule, impacted: $requirement) isa tactic_rule_impacts_requirement;
    };

rule dependency_into_impacts_and:
    when {
        (dependent: $comp_exp, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $comp_exp ($measure) isa comparison_expression;
        $and_exp (expression:$comp_exp) isa and_expression;
        $measure isa Measure;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $measure) isa effect;
    } then {
        (impacted: $and_exp, tactic_rule: $tactic_rule) isa tactic_rule_impacts_and;
    };

rule tactic_rule_impacts_shall_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $requirement) isa tactic_rule_impacts_requirement;
        $requirement (expression: $shall_expression) isa relaxed_requirement;
        $shall_expression isa shall_expression;
    } then {
        (tactic_rule: $tactic_rule, impacted: $shall_expression) isa tactic_rule_impacts_shall_expression;
    };

rule tactic_rule_impacts_may_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $requirement) isa tactic_rule_impacts_requirement;
        $requirement (expression: $may_expression) isa relaxed_requirement;
        $may_expression isa may_expression;
    } then {
        (tactic_rule: $tactic_rule, impacted: $may_expression) isa tactic_rule_impacts_may_expression;
    };

rule tactic_rule_impacts_base_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $parent) isa tactic_rule_impacts;
        $parent (expression: $expression_child) isa expression;
        $expression_child isa $expression_type;
        {
            $expression_type sub atomic_expression;
        } or {
            $expression_type sub fuzzy_comparison_expression;
        } or {
            $expression_type sub relaxed_fuzzy_expression;
        } or {
            $expression_type sub not_expression;
        } or {
            $expression_type sub fuzzy_not;
        };
    } then {
        (tactic_rule: $tactic_rule, impacted: $expression_child) isa tactic_rule_impacts_base;
    };

rule tactic_rule_impacts_or_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $parent) isa tactic_rule_impacts;
        $parent (expression: $or_expression) isa expression;
        $or_expression isa $expression_type;
        {
            $expression_type sub or_expression;
        } or {
            $expression_type sub fuzzy_or;
        };
    } then {
        (tactic_rule: $tactic_rule, impacted: $or_expression) isa tactic_rule_impacts_or;
    };

rule tactic_rule_impacts_and_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $parent) isa tactic_rule_impacts;
        $parent (expression: $and_expression) isa expression;
        $and_expression isa $expression_type;
        {
            $expression_type sub and_expression;
        } or {
            $expression_type sub fuzzy_and;
        };
    } then {
        (tactic_rule: $tactic_rule, impacted: $and_expression) isa tactic_rule_impacts_and;
    };

# rules for evaluating expressions that don't directly depend on the effects of a tactic rule
# but might have sub-expression that depends on measures impacted by effects
rule tr_dependency_tr_impacts_fulfillment:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts;
    $tr_dependency (tactic_rule: $tactic_rule, dependent: $expression) isa tactic_rule_dependency,
        has fulfillment $fulfillment;
  } then {
    $tr_impacts has $fulfillment;
  };

rule tr_impacts_fulfillment_comparison:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_base;
    $expression isa $comparison_type, has membership_degree $membership_degree;
    {
        $comparison_type sub comparison_expression;
    } or {
        $comparison_type sub fuzzy_comparison_expression;
    } or {
        $comparison_type sub relaxed_fuzzy_expression;
    };
    not {$tr_dependency (tactic_rule: $tactic_rule, dependent: $expression) isa tactic_rule_dependency;};
    ?fulfillment = $membership_degree;
  } then {
    $tr_impacts has fulfillment ?fulfillment;
  };

rule tr_impacts_fulfillment_proposition:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_base;
    $expression isa propositional_expression, has membership_degree $membership_degree;
    ?fulfillment = $membership_degree;
  } then {
    $tr_impacts has fulfillment ?fulfillment;
  };

rule not_expression_tr_impacts_fulfillment:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, impacted: $not_expr) isa tactic_rule_impacts_base;
    $not_expr (expression: $expression) isa $not_type;

    {
        $not_type sub not_expression;
    } or {
        $not_type sub fuzzy_not;
    };

    (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_base,
        has fulfillment $fulfillment;

    ?negated_fulfillment = 1.0 - $fulfillment;
  } then {
    $tr_impacts has fulfillment ?negated_fulfillment;
  };

rule or_expression_tr_impacts_fulfillment :
	when {
        $tr_impacts (tactic_rule: $tactic_rule, impacted: $or_expr) isa tactic_rule_impacts_or;

        $or_expr (expression: $expression) isa expression;

        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts,
            has fulfillment $fulfillment;

        not {
            $or_expr (expression: $another_expression) isa expression;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts,
                has fulfillment $another_fulfillment;
            $another_fulfillment > $fulfillment;
		};
	} then {
        $tr_impacts has $fulfillment;
	};

rule and_expression_tr_impacts_fulfillment :
	when {
        $tr_impacts (tactic_rule: $tactic_rule, impacted: $and_expr) isa tactic_rule_impacts_and;

        $and_expr (expression: $expression) isa expression;

        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts,
            has fulfillment $fulfillment;

        not {
            $and_expr (expression: $another_expression) isa expression;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts,
                has fulfillment $another_fulfillment;
            $another_fulfillment < $fulfillment;
		};
	} then {
        $tr_impacts has $fulfillment;
	};

rule shall_expression_tr_impacts_fulfillment :
	when {
        $tr_shall (tactic_rule: $tactic_rule, impacted: $shall_expr) isa tactic_rule_impacts_shall_expression;

        $shall_expr (expression: $expression) isa shall_expression;

        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts,
            has fulfillment $fulfillment;

        not {
            $shall_expr (expression: $another_expression) isa expression;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts,
                has fulfillment $another_fulfillment;
            $another_fulfillment < $fulfillment;
		};
	} then {
        $tr_shall has $fulfillment;
	};

rule may_expression_tr_impacts_fulfillment :
	when {
        $tr_may (tactic_rule: $tactic_rule, impacted: $may_expr) isa tactic_rule_impacts_may_expression;

        $may_expr (expression: $expression) isa may_expression;

        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts,
            has fulfillment $fulfillment;

        not {
            $may_expr (expression: $another_expression) isa expression;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts,
                has fulfillment $another_fulfillment;
            $another_fulfillment > $fulfillment;
		};
	} then {
        $tr_may has $fulfillment;
	};

rule requirement_tr_impacts_fulfillment :
	when {
        $tr_req (tactic_rule: $tactic_rule, impacted: $requirement) isa tactic_rule_impacts_requirement;
        $requirement (expression: $expression) isa relaxed_requirement;
        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts,
            has fulfillment $fulfillment;

        not {
            $requirement (expression: $another_expression) isa relaxed_requirement;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts,
                has fulfillment $another_fulfillment;
            $another_fulfillment < $fulfillment;
		};
	} then {
        $tr_req has $fulfillment;
	};

# In-effect scoped tactic_rule_impacts_* rules for potential requirement queries
rule tactic_rule_impacts_in_effect_requirements:
    when {
        $requirement isa relaxed_requirement, has in_effect true;
        $tactic_rule isa tactic_rule;
    } then {
        (tactic_rule: $tactic_rule, impacted: $requirement) isa tactic_rule_impacts_requirement_in_effect;
    };

rule tactic_rule_impacts_in_effect_shall_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $requirement) isa tactic_rule_impacts_requirement_in_effect;
        $requirement (expression: $shall_expression) isa relaxed_requirement;
        $shall_expression isa shall_expression;
    } then {
        (tactic_rule: $tactic_rule, impacted: $shall_expression) isa tactic_rule_impacts_shall_expression_in_effect;
    };

rule tactic_rule_impacts_in_effect_may_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $requirement) isa tactic_rule_impacts_requirement_in_effect;
        $requirement (expression: $may_expression) isa relaxed_requirement;
        $may_expression isa may_expression;
    } then {
        (tactic_rule: $tactic_rule, impacted: $may_expression) isa tactic_rule_impacts_may_expression_in_effect;
    };

rule tactic_rule_impacts_in_effect_base_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $parent) isa tactic_rule_impacts_in_effect;
        $parent (expression: $expression_child) isa expression;
        $expression_child isa $expression_type;
        {
            $expression_type sub atomic_expression;
        } or {
            $expression_type sub fuzzy_comparison_expression;
        } or {
            $expression_type sub relaxed_fuzzy_expression;
        } or {
            $expression_type sub not_expression;
        } or {
            $expression_type sub fuzzy_not;
        };
    } then {
        (tactic_rule: $tactic_rule, impacted: $expression_child) isa tactic_rule_impacts_base_in_effect;
    };

rule tactic_rule_impacts_in_effect_or_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $parent) isa tactic_rule_impacts_in_effect;
        $parent (expression: $or_expression) isa expression;
        $or_expression isa $expression_type;
        {
            $expression_type sub or_expression;
        } or {
            $expression_type sub fuzzy_or;
        };
    } then {
        (tactic_rule: $tactic_rule, impacted: $or_expression) isa tactic_rule_impacts_or_in_effect;
    };

rule tactic_rule_impacts_in_effect_and_transitivity:
    when {
        (tactic_rule: $tactic_rule, impacted: $parent) isa tactic_rule_impacts_in_effect;
        $parent (expression: $and_expression) isa expression;
        $and_expression isa $expression_type;
        {
            $expression_type sub and_expression;
        } or {
            $expression_type sub fuzzy_and;
        };
    } then {
        (tactic_rule: $tactic_rule, impacted: $and_expression) isa tactic_rule_impacts_and_in_effect;
    };

rule tr_dependency_tr_impacts_in_effect_fulfillment:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_in_effect;
    $tr_dependency (tactic_rule: $tactic_rule, dependent: $expression) isa tactic_rule_dependency,
        has fulfillment $fulfillment;
  } then {
    $tr_impacts has $fulfillment;
  };

rule tr_impacts_in_effect_fulfillment_comparison:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_base_in_effect;
    $expression isa $comparison_type, has membership_degree $membership_degree;
    {
        $comparison_type sub comparison_expression;
    } or {
        $comparison_type sub fuzzy_comparison_expression;
    } or {
        $comparison_type sub relaxed_fuzzy_expression;
    };
    not {$tr_dependency (tactic_rule: $tactic_rule, dependent: $expression) isa tactic_rule_dependency;};
    ?fulfillment = $membership_degree;
  } then {
    $tr_impacts has fulfillment ?fulfillment;
  };

rule tr_impacts_in_effect_fulfillment_proposition:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_base_in_effect;
    $expression isa propositional_expression, has membership_degree $membership_degree;
    ?fulfillment = $membership_degree;
  } then {
    $tr_impacts has fulfillment ?fulfillment;
  };

rule not_expression_tr_impacts_in_effect_fulfillment:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, impacted: $not_expr) isa tactic_rule_impacts_base_in_effect;
    $not_expr (expression: $expression) isa $not_type;

    {
        $not_type sub not_expression;
    } or {
        $not_type sub fuzzy_not;
    };

    (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_in_effect,
        has fulfillment $fulfillment;

    ?negated_fulfillment = 1.0 - $fulfillment;
  } then {
    $tr_impacts has fulfillment ?negated_fulfillment;
  };

rule or_expression_tr_impacts_in_effect_fulfillment:
	when {
        $tr_impacts (tactic_rule: $tactic_rule, impacted: $or_expr) isa tactic_rule_impacts_or_in_effect;

        $or_expr (expression: $expression) isa expression;

        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_in_effect,
            has fulfillment $fulfillment;

        not {
            $or_expr (expression: $another_expression) isa expression;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts_in_effect,
                has fulfillment $another_fulfillment;
            $another_fulfillment > $fulfillment;
		};
	} then {
        $tr_impacts has $fulfillment;
	};

rule and_expression_tr_impacts_in_effect_fulfillment:
	when {
        $tr_impacts (tactic_rule: $tactic_rule, impacted: $and_expr) isa tactic_rule_impacts_and_in_effect;

        $and_expr (expression: $expression) isa expression;

        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_in_effect,
            has fulfillment $fulfillment;

        not {
            $and_expr (expression: $another_expression) isa expression;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts_in_effect,
                has fulfillment $another_fulfillment;
            $another_fulfillment < $fulfillment;
		};
	} then {
        $tr_impacts has $fulfillment;
	};

rule shall_expression_tr_impacts_in_effect_fulfillment:
	when {
        $tr_shall (tactic_rule: $tactic_rule, impacted: $shall_expr) isa tactic_rule_impacts_shall_expression_in_effect;

        $shall_expr (expression: $expression) isa shall_expression;

        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_in_effect,
            has fulfillment $fulfillment;

        not {
            $shall_expr (expression: $another_expression) isa expression;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts_in_effect,
                has fulfillment $another_fulfillment;
            $another_fulfillment < $fulfillment;
		};
	} then {
        $tr_shall has $fulfillment;
	};

rule may_expression_tr_impacts_in_effect_fulfillment:
	when {
        $tr_may (tactic_rule: $tactic_rule, impacted: $may_expr) isa tactic_rule_impacts_may_expression_in_effect;

        $may_expr (expression: $expression) isa may_expression;

        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_in_effect,
            has fulfillment $fulfillment;

        not {
            $may_expr (expression: $another_expression) isa expression;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts_in_effect,
                has fulfillment $another_fulfillment;
            $another_fulfillment > $fulfillment;
		};
	} then {
        $tr_may has $fulfillment;
	};

rule requirement_tr_impacts_in_effect_fulfillment:
	when {
        $tr_req (tactic_rule: $tactic_rule, impacted: $requirement) isa tactic_rule_impacts_requirement_in_effect;
        $requirement (expression: $expression) isa relaxed_requirement;
        (tactic_rule: $tactic_rule, impacted: $expression) isa tactic_rule_impacts_in_effect,
            has fulfillment $fulfillment;

        not {
            $requirement (expression: $another_expression) isa relaxed_requirement;
            (tactic_rule: $tactic_rule, impacted: $another_expression) isa tactic_rule_impacts_in_effect,
                has fulfillment $another_fulfillment;
            $another_fulfillment < $fulfillment;
		};
	} then {
        $tr_req has $fulfillment;
	};

rule resolution_model_tactic_rule_impacts_requirement_in_effect:
    when {
        $resolution_model (tactic: $tactic) isa resolution_model;
        $tactic_rule (tactic: $tactic) isa tactic_rule;
        $tr_req (tactic_rule: $tactic_rule, impacted: $requirement)
            isa tactic_rule_impacts_requirement_in_effect;
        $requirement isa relaxed_requirement, has in_effect true;
    } then {
        (resolution_model: $resolution_model,
            tactic_rule: $tactic_rule,
            impacted: $requirement)
            isa resolution_model_tactic_rule_impacts_requirement_in_effect;
    };

rule resolution_model_tactic_rule_impacts_requirement_in_effect_fulfillment:
    when {
        $rm_tr_req (
            resolution_model: $resolution_model,
            tactic_rule: $tactic_rule,
            impacted: $requirement
        ) isa resolution_model_tactic_rule_impacts_requirement_in_effect;
        $tr_req (tactic_rule: $tactic_rule, impacted: $requirement)
            isa tactic_rule_impacts_requirement_in_effect,
            has fulfillment $fulfillment;
        $resolution_model isa resolution_model;
    } then {
        $rm_tr_req has $fulfillment;
    };
