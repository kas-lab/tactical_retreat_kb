define

measure_dependency sub relation,
    relates dependent,
    relates measure;
Measure plays measure_dependency:measure;
expression plays measure_dependency:dependent;
system_requirement plays measure_dependency:dependent;

fuzzy_comparison_expression relates effect;
fuzzy_comparison_expression relates tactic_rule_dependency;
effect plays fuzzy_comparison_expression:effect;

# direct dependency on effect
tactic_rule_dependency sub relation,
    owns fulfillment,
    relates tactic_rule,
    relates dependent,
    plays fuzzy_comparison_expression:tactic_rule_dependency;
expression plays tactic_rule_dependency:dependent;
system_requirement plays tactic_rule_dependency:dependent;
tactic_rule plays tactic_rule_dependency:tactic_rule;

# hypothetical_value sub attribute,
#     value double;

# Measure owns hypothetical_value;

# relaxed_expression plays measure_dependency:dependent;
# system_requirement plays measure_dependency:dependent;

# hypothetical_fulfillment sub relation,
#     owns fulfillment,
#     relates effect,
#     relates relaxed_expression;
# relaxed_expression plays hypothetical_fulfillment:relaxed_expression;
# effect plays hypothetical_fulfillment:effect;

# direct or indirect dependency
tactic_rule_impacts sub relation,
    owns fulfillment,
    relates tactic_rule,
    relates expression;
# relaxed_requirement plays tactic_impact:requirement;
expression plays tactic_rule_impacts:expression;
tactic_rule plays tactic_rule_impacts:tactic_rule;

rule comparison_expression_measure_dependency:
    when {
        $expression ($measure) isa comparison_expression;
        $measure isa Measure;
    } then {
        (dependent: $expression, measure: $measure) isa measure_dependency;
    };

rule fuzzy_expression_measure_dependency:
    when {
        $expression (term: $measure) isa fuzzy_comparison_expression;
        $measure isa Measure;
    } then {
        (dependent: $expression, measure: $measure) isa measure_dependency;
    };

rule relaxed_fuzzy_expression_measure_dependency:
    when {
        $expression (term: $measure) isa relaxed_fuzzy_expression;
        $measure isa Measure;
    } then {
        (dependent: $expression, measure: $measure) isa measure_dependency;
    };

rule expression_measure_dependency_transitivity:
    when {
        $expression_parent (expression: $expression_child) isa expression;
        (dependent: $expression_child, measure: $measure) isa measure_dependency;
    } then {
        (dependent: $expression_parent, measure: $measure) isa measure_dependency;
    };

rule requirement_measure_dependency:
    when {
		$requirement (expression: $expression) isa system_requirement;
        (dependent: $expression, measure: $measure) isa measure_dependency;
    } then {
        (dependent: $requirement, measure: $measure) isa measure_dependency;
    };

rule comparison_expression_tactic_rule_dependency:
    when {
        $expression ($measure) isa comparison_expression;
        $measure isa Measure;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $measure) isa effect;
    } then {
        (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
    };

rule fuzzy_expression_tactic_rule_dependency:
    when {
        $expression (term: $measure) isa fuzzy_comparison_expression;
        $measure isa Measure;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $measure) isa effect;
    } then {
        (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
    };

rule relaxed_fuzzy_expression_tactic_rule_dependency:
    when {
        $expression (term: $measure) isa relaxed_fuzzy_expression;
        $measure isa Measure;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $measure) isa effect;
    } then {
        (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
    };

# tactic_rule_impacts

rule tactic_rule_impacts:
    when {
        $requirement (expression: $expression) isa relaxed_requirement;
        $tactic_rule isa tactic_rule;
    } then {
        (tactic_rule: $tactic_rule, expression: $expression) isa tactic_rule_impacts;
    };

rule tactic_rule_impacts_transitivity:
    when {
        $expression_parent (expression: $expression_child) isa expression;
        (tactic_rule: $tactic_rule, expression: $expression_parent) isa tactic_rule_impacts;
        # (dependent: $expression_child, measure: $measure) isa measure_dependency;
    } then {
        (tactic_rule: $tactic_rule, expression: $expression_child) isa tactic_rule_impacts;
    };

# TODO: try to implement something similar to the fuzzy_expression, so it is not needed to
# repeat all the logic here
rule comparison_expression_double_and_integers_tactic_rule_dependency_fulfillment:
    when {
        $tr_dependency (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $expression (lhs_value: $lhs, rhs_value: $rhs) isa $comparsion_type;

        {
            $tactic_rule (effect: $effect_lhs, effect: $effect_rhs) isa tactic_rule;

            $effect_lhs (measure: $lhs) isa effect, has resulting_effect_value $value_lhs;
            $effect_rhs (measure: $rhs) isa effect, has resulting_effect_value $value_rhs;
        } or {
            not {
                $tactic_rule (effect: $effect_lhs, effect: $effect_rhs) isa tactic_rule;
                $effect_lhs (measure: $lhs) isa effect;
                $effect_rhs (measure: $rhs) isa effect;
            };

            $tactic_rule (effect: $effect_lhs) isa tactic_rule;
            $effect_lhs (measure: $lhs) isa effect, has resulting_effect_value $value_lhs;

            $rhs isa Measure;
            (measure: $rhs, measurement_value: $mv_rhs) isa measurement,
                has latest true;
            $mv_rhs isa ValueDouble, has double_value $value_rhs;
        } or {
            not {
                $tactic_rule (effect: $effect_lhs, effect: $effect_rhs) isa tactic_rule;
                $effect_lhs (measure: $lhs) isa effect;
                $effect_rhs (measure: $rhs) isa effect;
            };

            $tactic_rule (effect: $effect_lhs) isa tactic_rule;
            $effect_lhs (measure: $lhs) isa effect, has resulting_effect_value $value_lhs;

            $rhs isa Measure;
            (measure: $rhs, measurement_value: $mv_rhs) isa measurement,
                has latest true;
            $mv_rhs isa ValueInteger, has integer_value $value_rhs;
        } or {

            $tactic_rule (effect: $effect_lhs) isa tactic_rule;
            $effect_lhs (measure: $lhs) isa effect, has resulting_effect_value $value_lhs;

            $rhs isa ValueDouble, has double_value $value_rhs;
        } or {
            $tactic_rule (effect: $effect_lhs) isa tactic_rule;
            $effect_lhs (measure: $lhs) isa effect, has resulting_effect_value $value_lhs;

            $rhs isa ValueInteger, has integer_value $value_rhs;
        } or {
            not {
                $tactic_rule (effect: $effect_lhs, effect: $effect_rhs) isa tactic_rule;
                $effect_lhs (measure: $lhs) isa effect;
                $effect_rhs (measure: $rhs) isa effect;
            };
            $lhs isa Measure;
            (measure: $lhs, measurement_value: $mv_lhs) isa measurement,
                has latest true;
            $mv_lhs isa ValueDouble, has double_value $value_lhs;

            $tactic_rule (effect: $effect_rhs) isa tactic_rule;
            $effect_rhs (measure: $rhs) isa effect, has resulting_effect_value $value_rhs;
        } or {
            not {
                $tactic_rule (effect: $effect_lhs, effect: $effect_rhs) isa tactic_rule;
                $effect_lhs (measure: $lhs) isa effect;
                $effect_rhs (measure: $rhs) isa effect;
            };
            $lhs isa Measure;
            (measure: $lhs, measurement_value: $mv_lhs) isa measurement,
                has latest true;
            $mv_lhs isa ValueInteger, has integer_value $value_lhs;

            $tactic_rule (effect: $effect_rhs) isa tactic_rule;
            $effect_rhs (measure: $rhs) isa effect, has resulting_effect_value $value_rhs;
        } or {
            $lhs isa ValueDouble, has double_value $value_lhs;

            $tactic_rule (effect: $effect_rhs) isa tactic_rule;
            $effect_rhs (measure: $rhs) isa effect, has resulting_effect_value $value_rhs;
        } or {
            $lhs isa ValueInteger, has integer_value $value_lhs;

            $tactic_rule (effect: $effect_rhs) isa tactic_rule;
            $effect_rhs (measure: $rhs) isa effect, has resulting_effect_value $value_rhs;
        };

        {
            $comparsion_type sub less_than;
            $value_lhs < $value_rhs;
        } or {
            $comparsion_type sub less_than_equal;
            $value_lhs <= $value_rhs;
        } or {
            $comparsion_type sub greater_than;
            $value_lhs > $value_rhs;
        } or {
            $comparsion_type sub greater_than_equal;
            $value_lhs >= $value_rhs;
        } or {
            $comparsion_type sub equal;
            $value_lhs == $value_rhs;
        } or {
            $comparsion_type sub not_equal;
            $value_lhs != $value_rhs;
        };
    } then {
        $tr_dependency has fulfillment 1.0;
    };

rule comparison_expression_tactic_rule_dependency_fulfillment_0:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression isa comparison_expression;
        not {$tr_dependency has fulfillment 1.0;};
    } then {
        $tr_dependency has fulfillment 0.0;
    };

rule fuzzy_expression_quantified_value_effect:
	when {
		$fuzzy_expression (effect: $effect) isa fuzzy_comparison_expression;
        $effect (effect_value: $term) isa effect, has resulting_effect_value $quantified_value;

        {
			$fuzzy_expression  has offset_value $offest;
			?quantified_value_ = $quantified_value + $offest;
		} or {
			not {$fuzzy_expression has offset_value $offest;};
			?quantified_value_ = $quantified_value;
		};
		?quantified_value__ = ?quantified_value_;

	} then {
		$fuzzy_expression has quantified_value ?quantified_value__;
	};

# rule fuzzy_decay_tactic_rule_dependency_effect:
rule fuzzy_unimodal_expr_tactic_rule_dependency_effect:
	when {
		$tr_dependency (dependent: $fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$fuzzy_expression (fuzzy_set: $fuzzy_set, term: $term) isa fuzzy_unimodal_expression;
	} then {
        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_unimodal_expression;
	};

rule fuzzy_ascend_expr_tactic_rule_dependency_effect:
	when {
		$tr_dependency (dependent: $fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$fuzzy_expression (fuzzy_set: $fuzzy_set, term: $term) isa fuzzy_ascend_expression;
	} then {
        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_ascend_expression;
	};

rule fuzzy_decay_expr_tactic_rule_dependency_effect:
	when {
		$tr_dependency (dependent: $fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$fuzzy_expression (fuzzy_set: $fuzzy_set, term: $term) isa fuzzy_decay_expression;
	} then {
        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_decay_expression;
	};

rule fuzzy_expr_tactic_rule_dependency_fulfillment:
	when {
        $tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$expr (term: $term, fuzzy_set: $fuzzy_set) isa fuzzy_comparison_expression;
        $effect (measure: $term) isa effect;

        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_comparison_expression,
			has membership_degree $membership_degree;
        ?membership_degree_ = $membership_degree;
	} then {
		$tr_dependency has fulfillment ?membership_degree_;
	};

### as_close_as_possible_fuzzy_expression rules
rule as_close_as_possible_tactic_rule_dependency_effect:
	when {
        $tr_dependency (dependent: $relaxed_fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$relaxed_fuzzy_expression (term: $term, fuzzy_set: $fuzzy_set) isa as_close_as_possible_expression;
	} then {
		(effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_unimodal_expression;
	};

rule as_close_as_possible_tactic_rule_dependency_offset:
	when {
		$tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$fuzzy_expr (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_unimodal_expression;
        $effect (measure: $term) isa effect;

        $expr (term: $term, fuzzy_set: $fuzzy_set) isa as_close_as_possible_expression,
			has required_value $required_value;
		?offset_value_ = -1.0 * $required_value;
	} then {
		$fuzzy_expr has offset_value ?offset_value_;
	};

rule as_close_as_possible_tactic_rule_dependency_fulfillment:
	when {
        $tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$expr (term: $term, fuzzy_set: $fuzzy_set) isa as_close_as_possible_expression;
        $effect (measure: $term) isa effect;

        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_unimodal_expression,
            has membership_degree $membership_degree;
        ?membership_degree_ = $membership_degree;
	} then {
        $tr_dependency has fulfillment ?membership_degree_;
	};

### as_many_as_possible_fuzzy_expression rules
rule as_many_as_possible_tactic_rule_dependency_effect:
	when {
        $tr_dependency (dependent: $relaxed_fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$relaxed_fuzzy_expression (term: $term, fuzzy_set: $fuzzy_set) isa as_many_as_possible_expression;
	} then {
		(effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_ascend_expression;
	};

rule as_many_as_possible_tactic_rule_dependency_fulfillment:
	when {
        $tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$expr (term: $term, fuzzy_set: $fuzzy_set) isa as_many_as_possible_expression;
        $effect (measure: $term) isa effect;

        (effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_ascend_expression,
			has membership_degree $membership_degree;
        ?membership_degree_ = $membership_degree;
	} then {
		$tr_dependency has fulfillment ?membership_degree_;
	};

rule as_few_as_possible_tactic_rule_dependency_effect:
	when {
        $tr_dependency (dependent: $relaxed_fuzzy_expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $term) isa effect;
		$relaxed_fuzzy_expression (term: $term, fuzzy_set: $fuzzy_set) isa as_few_as_possible_expression;
	} then {
		(effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_decay_expression;
	};

rule as_few_as_possible_tactic_rule_dependency_fulfillment:
	when {
        $tr_dependency (dependent: $expr, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
		$expr (term: $term, fuzzy_set: $fuzzy_set) isa as_few_as_possible_expression;
        $effect (measure: $term) isa effect;

		(effect: $effect, fuzzy_set:$fuzzy_set, tactic_rule_dependency: $tr_dependency) isa fuzzy_decay_expression,
			has membership_degree $membership_degree;
        ?membership_degree_ = $membership_degree;
	} then {
		$tr_dependency has fulfillment ?membership_degree_;
	};

# rules for evaluating expressions that don't depend on the measure but might have
# sub-expression that depends on measures impacted by effects
rule tr_dependency_tr_impacts_fulfillment:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, expression: $expression) isa tactic_rule_impacts;
    $tr_dependency (tactic_rule: $tactic_rule, dependent: $expression) isa tactic_rule_dependency,
        has fulfillment $fulfillment;
  } then {
    $tr_impacts has $fulfillment;
  };

rule tr_impacts_fulfillment_comparison:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, expression: $expression) isa tactic_rule_impacts;
    $expression isa $comparison_type, has membership_degree $membership_degree;
    {
        $comparison_type sub comparison_expression;
    } or {
        $comparison_type sub fuzzy_comparison_expression;
    } or {
        $comparison_type sub relaxed_fuzzy_expression;
    };
    not {$tr_dependency (tactic_rule: $tactic_rule, dependent: $expression) isa tactic_rule_dependency;};
    ?fulfillment = $membership_degree;
  } then {
    $tr_impacts has fulfillment ?fulfillment;
  };

rule tr_impacts_fulfillment_proposition:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, expression: $expression) isa tactic_rule_impacts;
    $expression isa propositional_expression, has membership_degree $membership_degree;
    ?fulfillment = $membership_degree;
  } then {
    $tr_impacts has fulfillment ?fulfillment;
  };

rule not_expression_tr_impacts_fulfillment:
  when {
    $tr_impacts (tactic_rule: $tactic_rule, expression: $not_expr) isa tactic_rule_impacts;
    $not_expr (expression: $expression) isa $not_type;

    {
        $not_type sub not_expression;
    } or {
        $not_type sub fuzzy_not;
    };

    (tactic_rule: $tactic_rule, expression: $expression) isa tactic_rule_impacts,
        has fulfillment $fulfillment;

    ?negated_fulfillment = 1.0 - $fulfillment;
  } then {
    $tr_impacts has fulfillment ?negated_fulfillment;
  };

rule or_expression_tr_impacts_fulfillment :
	when {
        $or_expr (expression: $expression) isa! fuzzy_or;
        $tr_impacts (tactic_rule: $tactic_rule, expression: $or_expr) isa tactic_rule_impacts;
        # $or_expr (expression: $expression) isa $or_type;


        # {
        #     $or_type sub or_expression;
        # } or {
        #     $or_type sub fuzzy_or;
        # };

        (tactic_rule: $tactic_rule, expression: $expression) isa tactic_rule_impacts,
            has fulfillment $fulfillment;

        not {
			# $or_expr (expression: $another_expression) isa $or_type;
			$or_expr (expression: $another_expression) isa! fuzzy_or;
            $another_expression isa $another_expression_type;
            {
                $another_expression_type sub atomic_expression;
            } or {
                $another_expression_type sub not_expression;
            } or {
                $another_expression_type sub fuzzy_not;
            } or {
                $another_expression_type sub fuzzy_comparison_expression;
            };
            # atomic_expression. not expression, fuzzy_not, fuzzy_comparison_expression
            $tr_impacts_2 (tactic_rule: $tactic_rule, expression: $another_expression) isa tactic_rule_impacts,
                has fulfillment $another_fulfillment;

            $another_fulfillment > $fulfillment;
		};

	} then {
        $tr_impacts has $fulfillment;
	};

