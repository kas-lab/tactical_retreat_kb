        (tr_dependency: $tr_dependency, rhs_effect: $rhs_effect) isa tr_dependency_rhs_effect_operand;
        $rhs_effect has resulting_effect_value $value_rhs;
        $value_lhs == $value_rhs;
    } then {
        $tr_dependency has fulfillment 1.0;
    };

