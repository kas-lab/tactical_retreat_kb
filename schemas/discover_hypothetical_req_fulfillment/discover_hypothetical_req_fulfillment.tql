define

fuzzy_comparison_expression relates effect;
fuzzy_comparison_expression relates tactic_rule_dependency;
effect plays fuzzy_comparison_expression:effect;

# direct dependency on effect
tactic_rule_dependency sub relation,
    owns fulfillment,
    relates tactic_rule,
    relates dependent,
    plays fuzzy_comparison_expression:tactic_rule_dependency;
expression plays tactic_rule_dependency:dependent;
system_requirement plays tactic_rule_dependency:dependent;
tactic_rule plays tactic_rule_dependency:tactic_rule;

# direct or indirect dependency
tactic_rule_impacts sub relation,
    owns fulfillment,
    relates tactic_rule;
tactic_rule plays tactic_rule_impacts:tactic_rule;

# stratified fulfillment subtypes to avoid negation cycles
tactic_rule_impacts_base sub tactic_rule_impacts,
    relates impacted;
atomic_expression plays tactic_rule_impacts_base:impacted;
fuzzy_comparison_expression plays tactic_rule_impacts_base:impacted;
relaxed_fuzzy_expression plays tactic_rule_impacts_base:impacted;
not_expression plays tactic_rule_impacts_base:impacted;
fuzzy_not plays tactic_rule_impacts_base:impacted;

tactic_rule_impacts_or sub tactic_rule_impacts,
    relates impacted;
or_expression plays tactic_rule_impacts_or:impacted;
fuzzy_or plays tactic_rule_impacts_or:impacted;

tactic_rule_impacts_and sub tactic_rule_impacts,
    relates impacted;
and_expression plays tactic_rule_impacts_and:impacted;
fuzzy_and plays tactic_rule_impacts_and:impacted;

tactic_rule_impacts_shall_expression sub tactic_rule_impacts,
    relates impacted;
shall_expression plays tactic_rule_impacts_shall_expression:impacted;

tactic_rule_impacts_may_expression sub tactic_rule_impacts,
    relates impacted;
may_expression plays tactic_rule_impacts_may_expression:impacted;

tactic_rule_impacts_requirement sub tactic_rule_impacts,
    relates impacted;
relaxed_requirement plays tactic_rule_impacts_requirement:impacted;

# in-effect-scoped tactic_rule impacts used by potential requirement queries
tactic_rule_impacts_in_effect sub relation,
    owns fulfillment,
    relates tactic_rule;
tactic_rule plays tactic_rule_impacts_in_effect:tactic_rule;

tactic_rule_impacts_base_in_effect sub tactic_rule_impacts_in_effect,
    relates impacted;
atomic_expression plays tactic_rule_impacts_base_in_effect:impacted;
fuzzy_comparison_expression plays tactic_rule_impacts_base_in_effect:impacted;
relaxed_fuzzy_expression plays tactic_rule_impacts_base_in_effect:impacted;
not_expression plays tactic_rule_impacts_base_in_effect:impacted;
fuzzy_not plays tactic_rule_impacts_base_in_effect:impacted;

tactic_rule_impacts_or_in_effect sub tactic_rule_impacts_in_effect,
    relates impacted;
or_expression plays tactic_rule_impacts_or_in_effect:impacted;
fuzzy_or plays tactic_rule_impacts_or_in_effect:impacted;

tactic_rule_impacts_and_in_effect sub tactic_rule_impacts_in_effect,
    relates impacted;
and_expression plays tactic_rule_impacts_and_in_effect:impacted;
fuzzy_and plays tactic_rule_impacts_and_in_effect:impacted;

tactic_rule_impacts_shall_expression_in_effect sub tactic_rule_impacts_in_effect,
    relates impacted;
shall_expression plays tactic_rule_impacts_shall_expression_in_effect:impacted;

tactic_rule_impacts_may_expression_in_effect sub tactic_rule_impacts_in_effect,
    relates impacted;
may_expression plays tactic_rule_impacts_may_expression_in_effect:impacted;

tactic_rule_impacts_requirement_in_effect sub tactic_rule_impacts_in_effect,
    relates impacted;
relaxed_requirement plays tactic_rule_impacts_requirement_in_effect:impacted;

# resolution-model-scoped in-effect requirement impacts for hot query path
resolution_model_tactic_rule_impacts_requirement_in_effect sub relation,
    owns fulfillment,
    relates resolution_model,
    relates tactic_rule,
    relates impacted;
resolution_model plays resolution_model_tactic_rule_impacts_requirement_in_effect:resolution_model;
tactic_rule plays resolution_model_tactic_rule_impacts_requirement_in_effect:tactic_rule;
relaxed_requirement plays resolution_model_tactic_rule_impacts_requirement_in_effect:impacted;


tr_dependency_lhs_double_operand sub relation,
    relates tr_dependency,
    relates lhs_double;
tactic_rule_dependency plays tr_dependency_lhs_double_operand:tr_dependency;
ValueDouble plays tr_dependency_lhs_double_operand:lhs_double;

tr_dependency_rhs_double_operand sub relation,
    relates tr_dependency,
    relates rhs_double;
tactic_rule_dependency plays tr_dependency_rhs_double_operand:tr_dependency;
ValueDouble plays tr_dependency_rhs_double_operand:rhs_double;

tr_dependency_lhs_effect_operand sub relation,
    relates tr_dependency,
    relates lhs_effect;
tactic_rule_dependency plays tr_dependency_lhs_effect_operand:tr_dependency;
effect plays tr_dependency_lhs_effect_operand:lhs_effect;

tr_dependency_rhs_effect_operand sub relation,
    relates tr_dependency,
    relates rhs_effect;
tactic_rule_dependency plays tr_dependency_rhs_effect_operand:tr_dependency;
effect plays tr_dependency_rhs_effect_operand:rhs_effect;

tr_dependency_lhs_measure_without_effect sub relation,
    relates tr_dependency,
    relates lhs_measure;
tactic_rule_dependency plays tr_dependency_lhs_measure_without_effect:tr_dependency;
Measure plays tr_dependency_lhs_measure_without_effect:lhs_measure;

tr_dependency_rhs_measure_without_effect sub relation,
    relates tr_dependency,
    relates rhs_measure;
tactic_rule_dependency plays tr_dependency_rhs_measure_without_effect:tr_dependency;
Measure plays tr_dependency_rhs_measure_without_effect:rhs_measure;


# Rules for inferring direct dependency on a tactic_rule
rule comparison_expression_tactic_rule_dependency:
    when {
        $expression ($measure) isa comparison_expression;
        $measure isa Measure;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $measure) isa effect;
    } then {
        (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
    };

rule fuzzy_expression_tactic_rule_dependency:
    when {
        $expression (term: $measure) isa fuzzy_comparison_expression;
        $measure isa Measure;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $measure) isa effect;
    } then {
        (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
    };

rule relaxed_fuzzy_expression_tactic_rule_dependency:
    when {
        $expression (term: $measure) isa relaxed_fuzzy_expression;
        $measure isa Measure;
        $tactic_rule (effect: $effect) isa tactic_rule;
        $effect (measure: $measure) isa effect;
    } then {
        (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
    };


# Rules for inferring the hypothetical fulfillment of expressions that directly
# depend on a tactic rule effect
rule comparison_expression_tactic_rule_dependency_lhs_effect:
    when {
        $tr_dependency (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $expression (lhs_value: $lhs) isa comparison_expression;
        $tactic_rule (effect: $effect_lhs) isa tactic_rule;
        $effect_lhs (measure: $lhs) isa effect;
    } then {
        (tr_dependency: $tr_dependency, lhs_effect: $effect_lhs) isa tr_dependency_lhs_effect_operand;
    };

rule comparison_expression_tactic_rule_dependency_lhs_literal_double:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression (lhs_value: $lhs) isa comparison_expression;
        $lhs isa ValueDouble;
    } then {
        (tr_dependency: $tr_dependency, lhs_double: $lhs) isa tr_dependency_lhs_double_operand;
    };

rule comparison_expression_tactic_rule_dependency_lhs_measure_without_effect:
    when {
        $tr_dependency (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $expression (lhs_value: $lhs) isa comparison_expression;
        $lhs isa Measure;
        not {
            $tactic_rule (effect: $effect_lhs) isa tactic_rule;
            $effect_lhs (measure: $lhs) isa effect;
        };
    } then {
        (tr_dependency: $tr_dependency, lhs_measure: $lhs) isa tr_dependency_lhs_measure_without_effect;
    };

rule comparison_expression_tactic_rule_dependency_lhs_measure_double:
    when {
        (tr_dependency: $tr_dependency, lhs_measure: $lhs) isa tr_dependency_lhs_measure_without_effect;
        (measure: $lhs, measurement_value: $mv_lhs) isa measurement,
            has latest true;
        $mv_lhs isa ValueDouble;
    } then {
        (tr_dependency: $tr_dependency, lhs_double: $mv_lhs) isa tr_dependency_lhs_double_operand;
    };

rule comparison_expression_tactic_rule_dependency_rhs_effect:
    when {
        $tr_dependency (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $expression (rhs_value: $rhs) isa comparison_expression;
        $tactic_rule (effect: $effect_rhs) isa tactic_rule;
        $effect_rhs (measure: $rhs) isa effect;
    } then {
        (tr_dependency: $tr_dependency, rhs_effect: $effect_rhs) isa tr_dependency_rhs_effect_operand;
    };

rule comparison_expression_tactic_rule_dependency_rhs_literal_double:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression (rhs_value: $rhs) isa comparison_expression;
        $rhs isa ValueDouble;
    } then {
        (tr_dependency: $tr_dependency, rhs_double: $rhs) isa tr_dependency_rhs_double_operand;
    };

rule comparison_expression_tactic_rule_dependency_rhs_measure_without_effect:
    when {
        $tr_dependency (dependent: $expression, tactic_rule: $tactic_rule) isa tactic_rule_dependency;
        $expression (rhs_value: $rhs) isa comparison_expression;
        $rhs isa Measure;
        not {
            $tactic_rule (effect: $effect_rhs) isa tactic_rule;
            $effect_rhs (measure: $rhs) isa effect;
        };
    } then {
        (tr_dependency: $tr_dependency, rhs_measure: $rhs) isa tr_dependency_rhs_measure_without_effect;
    };

rule comparison_expression_tactic_rule_dependency_rhs_measure_double:
    when {
        (tr_dependency: $tr_dependency, rhs_measure: $rhs) isa tr_dependency_rhs_measure_without_effect;
        (measure: $rhs, measurement_value: $mv_rhs) isa measurement,
            has latest true;
        $mv_rhs isa ValueDouble;
    } then {
        (tr_dependency: $tr_dependency, rhs_double: $mv_rhs) isa tr_dependency_rhs_double_operand;
    };

rule comparison_expression_tactic_rule_dependency_less_than_effect_effect:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression isa less_than;
        (tr_dependency: $tr_dependency, lhs_effect: $lhs_effect) isa tr_dependency_lhs_effect_operand;
        $lhs_effect has resulting_effect_value $value_lhs;
        (tr_dependency: $tr_dependency, rhs_effect: $rhs_effect) isa tr_dependency_rhs_effect_operand;
        $rhs_effect has resulting_effect_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $tr_dependency has fulfillment 1.0;
    };

rule comparison_expression_tactic_rule_dependency_less_than_effect_double:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression isa less_than;
        (tr_dependency: $tr_dependency, lhs_effect: $lhs_effect) isa tr_dependency_lhs_effect_operand;
        $lhs_effect has resulting_effect_value $value_lhs;
        (tr_dependency: $tr_dependency, rhs_double: $rhs_double) isa tr_dependency_rhs_double_operand;
        $rhs_double has double_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $tr_dependency has fulfillment 1.0;
    };

rule comparison_expression_tactic_rule_dependency_less_than_double_effect:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression isa less_than;
        (tr_dependency: $tr_dependency, lhs_double: $lhs_double) isa tr_dependency_lhs_double_operand;
        $lhs_double has double_value $value_lhs;
        (tr_dependency: $tr_dependency, rhs_effect: $rhs_effect) isa tr_dependency_rhs_effect_operand;
        $rhs_effect has resulting_effect_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $tr_dependency has fulfillment 1.0;
    };

rule comparison_expression_tactic_rule_dependency_less_than_double_double:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
        $expression isa less_than;
        (tr_dependency: $tr_dependency, lhs_double: $lhs_double) isa tr_dependency_lhs_double_operand;
        $lhs_double has double_value $value_lhs;
        (tr_dependency: $tr_dependency, rhs_double: $rhs_double) isa tr_dependency_rhs_double_operand;
        $rhs_double has double_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $tr_dependency has fulfillment 1.0;
    };

rule comparison_expression_tactic_rule_dependency_less_than_equal_effect_effect:
    when {
        $tr_dependency (dependent: $expression) isa tactic_rule_dependency;
