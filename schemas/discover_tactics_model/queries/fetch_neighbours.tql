match
    $node isa ROSNode, has node_name 'bt_navigator_navigate_to_pose_rclcpp';
    let $neighbour in neighbours($node);
fetch
    $neighbour: node_name;

match
    $node isa ROSNode, has node_name 'controller_server';
    let $neighbour in neighbours($node);
fetch
    $neighbour: node_name;

match
    $node isa ROSNode, has node_name 'bt_navigator';
    let $neighbour in neighbours($node);
fetch
    $neighbour: node_name;
