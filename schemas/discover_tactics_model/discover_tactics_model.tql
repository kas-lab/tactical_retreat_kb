define

# This rule could be potentially optimized if we use `has_topic` instead of `has_interface`.
# However, if we later start considering ServiceClients and ActionClients as neighbours,
# we would need to re-write the rule

fun direct_neighbours($node: ROSNode) -> { ROSNode }:
  match
    {
      (node: $node, subnode: $nb) isa subnode;
    } or {
      (node: $node, client: $b_client) isa has_action;
      $b_client has interface_name $b_iname, has interface_type $b_itype;
      $b_server isa ActionServer, has interface_name $b_iname, has interface_type $b_itype;
      (node: $nb, server: $b_server) isa has_action;
      not { $nb is $node; };
    } or {
      (node: $node, publisher: $c_pub) isa has_topic;
      $c_pub has interface_name $c_iname, has interface_type $c_itype;
      $c_sub isa Subscriber, has interface_name $c_iname, has interface_type $c_itype;
      (node: $nb, subscriber: $c_sub) isa has_topic;
    } or {
      (node: $node, subscriber: $d_sub) isa has_topic;
      $d_sub has interface_name $d_iname, has interface_type $d_itype;
      $d_pub isa Publisher, has interface_name $d_iname, has interface_type $d_itype;
      (node: $nb, publisher: $d_pub) isa has_topic;
    };
  return { $nb };

fun neighbours($node: ROSNode) -> { ROSNode }:
  match
    {
      let $nb in direct_neighbours($node);
    } or {
      (node: $node, subnode: $e_sn) isa subnode;
      let $nb in neighbours($e_sn);
    };
  return { $nb };

fun connected_nodes($root: ROSNode) -> { ROSNode }:
  match
    {
      let $conn in direct_neighbours($root);
    } or {
      let $via in connected_nodes($root);
      let $conn in direct_neighbours($via);
    };
    not { $conn is $root; };
  return { $conn };

fun interface_hosts($interface: ROSInterface) -> { ROSNode }:
  match
    {
      $interface isa ActionServer;
      (node: $host, server: $interface) isa has_action;
    } or {
      $interface isa ServiceServer;
      (node: $host, server: $interface) isa has_service;
    } or {
      $interface isa Publisher;
      (node: $host, publisher: $interface) isa has_topic;
    };
  return { $host };

fun tactic_rule_consequent_features($tr: tactic_rule) -> { Feature }:
  match
    $tr links (consequent: $fa);
    {
      $fa links (activation: $feat);
    } or {
      $fa links (deactivation: $feat);
    };
  return { $feat };

fun resolution_model_tactic_rules($rm: resolution_model) -> { tactic_rule }:
  match
    $rm links (tactic: $rm_tactic, variant_resolution: $vr);
    let $feat in tactic_rule_consequent_features($tr);
    $tr isa tactic_rule, links (tactic: $rm_tactic);
    $vr links (variant: $feat);
  return { $tr };

fun tactic_rule_target_nodes($tr: tactic_rule, $rm: resolution_model) -> { ROSNode }:
  match
    let $feat in tactic_rule_consequent_features($tr);
    $rm links (variant_resolution: $vr);
    $vr links (variant: $feat, resolution_action: $ra);
    $ra links (node: $target);
  return { $target };

fun applicable_tactics($interface: ROSInterface, $rm: resolution_model) -> { tactic_rule }:
  match
    let $host in interface_hosts($interface);
    let $tr in resolution_model_tactic_rules($rm);
    let $target in tactic_rule_target_nodes($tr, $rm);
    {
      $target is $host;
    } or {
      let $conn in connected_nodes($host);
      $target is $conn;
    };
  return { $tr };
