define

### Discover applicable tactics things and rules
relation neighbours,
    relates node,
    relates neighbour @card(0..);

ROSNode plays neighbours:node;
ROSNode plays neighbours:neighbour;

relation connected_nodes,
    relates node,
    relates connected @card(0..);

ROSNode plays connected_nodes:node;
ROSNode plays connected_nodes:connected;

relation applicable_tactics,
    relates interface,
    relates resolution_model,
    relates tactic_rule @card(0..);

ROSInterface plays applicable_tactics:interface;
resolution_model plays applicable_tactics:resolution_model;
tactic_rule plays applicable_tactics:tactic_rule;


# This rule could be potentially optimized if we use `has_topic` instead of `has_interface`.
# However, if we later start considering ServiceClients and ActionClients as neighbours,
# we would need to re-write the rule






