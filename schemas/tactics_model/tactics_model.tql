define

attribute ros_system, value string;

attribute name @abstract, value string;

attribute resolution_model_name sub name;
attribute tactic_name sub name;
attribute rule_name sub name;
attribute variant_name sub name;

attribute tactic_resolution_model, value string;

attribute tactic_select_variant, value string;

### Tactic
entity Tactic,
    owns tactic_name @key,
    plays tactic_rule:tactic,
    plays resolution_model:tactic;

relation tactic_rule,
    owns rule_name @key,
    relates tactic @card(1),
    relates antecedent @card(0..),  # should this be 1..?
    relates consequent @card(0..), # should this be 1..?
    relates effect @card(0..);

### effect

# attribute resulting_effect_value, value double;
relation effect @abstract,
    # owns resulting_effect_value,
    relates measure,
    plays tactic_rule:effect;

relation absolute_effect sub effect,
    relates effect_value;

relation relative_effect sub effect,
    relates effect_value;

Measure plays effect:measure;
Value plays absolute_effect:effect_value;
ValueSingleton plays relative_effect:effect_value;

#### connection with logical_expression model
logical_expression plays tactic_rule:antecedent;

# feature adaptation
relation feature_adaptation,
    relates deactivation @card(0..),
    relates activation @card(0..),
    plays tactic_rule:consequent;

# Connection with feature model
Feature plays variant_resolution:variant;
Feature plays feature_adaptation:activation;
Feature plays feature_adaptation:deactivation;

#### resolution model
relation resolution_model,
    owns resolution_model_name @key,
    owns ros_system,
    relates tactic @card(1..),
    relates variant_resolution @card(0..);

relation variant_resolution @abstract,
    relates resolution_action @card(0..),
    relates variant @card(1),
    plays resolution_model:variant_resolution;

relation variant_activation sub variant_resolution;
relation variant_deactivation sub variant_resolution;

relation resolution_action @abstract,
    relates node,
    plays variant_resolution:resolution_action;

#### Connection to ROS model
ROSNode plays resolution_action:node;

relation set_nodes_parameters sub resolution_action,
    relates parameter,
    relates parameter_value;

Parameter plays set_nodes_parameters:parameter;
Value plays set_nodes_parameters:parameter_value;

relation set_lifecycle_state sub resolution_action,
    owns lifecycle_state;

fun set_nodes_parameters_feasible($ra: set_nodes_parameters) -> boolean:
  match
    $ra links (node: $node);
    not { $node has end_time $_; };
  let $r = true; return first $r;

fun set_lifecycle_state_feasible($ra: set_lifecycle_state) -> boolean:
  match
    $ra links (node: $node);
    $node has lifecycle_state $current;
    $ra has lifecycle_state $target;
    { $current == "active";
      { $target == "active"; } or { $target == "inactive"; } or { $target == "finalized"; };
    } or {
      $current == "inactive";
      { $target == "active"; } or { $target == "inactive"; } or
      { $target == "unconfigured"; } or { $target == "finalized"; };
    } or {
      $current == "unconfigured";
      { $target == "inactive"; } or { $target == "unconfigured"; } or { $target == "finalized"; };
    } or {
      $current == "finalized"; $target == "finalized";
    };
  let $r = true; return first $r;

fun resolution_action_feasible($ra: resolution_action) -> boolean:
  match
    { $ra isa set_nodes_parameters; true == set_nodes_parameters_feasible($ra); } or
    { $ra isa set_lifecycle_state;  true == set_lifecycle_state_feasible($ra); };
  let $r = true; return first $r;

fun variant_resolution_feasible($vr: variant_resolution) -> boolean:
  match
    not {
      $vr links (resolution_action: $ra_vr);
      not { true == resolution_action_feasible($ra_vr); };
    };
  let $r = true; return first $r;

fun resulting_effect_value($eff: relative_effect) -> double:
  match
    $eff links (measure: $meas_r, effect_value: $delta_val);
    (measure: $meas_r, measurement_value: $cur_val) isa measurement, has latest true;
    $cur_val has double_value $current;
    $delta_val has double_value $delta;
    let $result = $current + $delta;
  return first $result;

fun tactic_rule_valid($tr: tactic_rule) -> boolean:
  match
    not {
      $tr links (antecedent: $ante);
      not { true == expression_valid($ante); };
    };
    not {
      $tr links (consequent: $fa_c);
      $fa_c links (activation: $f_act);
      $f_act has selectable false;
    };
    not {
      $tr links (consequent: $fa_vr);
      $fa_vr links (activation: $f_vr);
      $vr_check links (variant: $f_vr);
      not { true == variant_resolution_feasible($vr_check); };
    };
  let $r = true; return first $r;
