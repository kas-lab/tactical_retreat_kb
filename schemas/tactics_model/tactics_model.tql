define

attribute ros_system, value string;

attribute name @abstract, value string;

attribute resolution_model_name sub name;
attribute tactic_name sub name;
attribute rule_name sub name;
attribute variant_name sub name;

attribute tactic_resolution_model, value string;

attribute tactic_select_variant, value string;

attribute rule_valid, value boolean;

attribute feasible, value boolean;

### Tactic
entity Tactic,
    owns tactic_name @key,
    plays tactic_rule:tactic,
    plays resolution_model:tactic;

relation tactic_rule,
    owns rule_name @key,
    owns rule_valid,
    relates tactic,
    relates antecedent @card(0..),
    relates consequent,
    relates effect @card(0..);

### effect

attribute resulting_effect_value, value double;
relation effect @abstract,
    owns resulting_effect_value,
    relates measure,
    plays tactic_rule:effect;

relation absolute_effect sub effect,
    relates effect_value;

relation relative_effect sub effect,
    relates effect_value;

Measure plays effect:measure;
Value plays absolute_effect:effect_value;
ValueDouble plays relative_effect:effect_value;
ValueInteger plays relative_effect:effect_value;

#### connection with logical_expression model
logical_expression plays tactic_rule:antecedent;

# feature adaptation
relation feature_adaptation,
    relates deactivation,
    relates activation,
    plays tactic_rule:consequent;

# Connection with feature model
Feature plays variant_resolution:variant;
Feature plays feature_adaptation:activation;
Feature plays feature_adaptation:deactivation;

#### resolution model
relation resolution_model,
    owns resolution_model_name @key,
    owns ros_system,
    relates tactic,
    relates variant_resolution @card(0..);

relation variant_resolution @abstract,
    owns feasible,
    relates resolution_action,
    relates variant,
    plays resolution_model:variant_resolution;

relation variant_activation sub variant_resolution;
relation variant_deactivation sub variant_resolution;

relation resolution_action @abstract,
    owns feasible,
    relates node,
    plays variant_resolution:resolution_action;

#### Connection to ROS model
ROSNode plays resolution_action:node;

relation set_nodes_parameters sub resolution_action,
    relates parameter,
    relates parameter_value;

Parameter plays set_nodes_parameters:parameter;
Value plays set_nodes_parameters:parameter_value;

relation set_lifecycle_state sub resolution_action,
    owns lifecycle_state;

