define

attribute expression_name, value string;
attribute expression_satisfied, value boolean;

relation expression @abstract,
    owns expression_name @unique;  # to make it possible to query the expression

# logical expressions
relation logical_expression sub expression,
    owns expression_satisfied,
    relates operand;

## negation expression
relation not_expression sub logical_expression,
    relates expression,
    plays and_expression:expression,
    plays or_expression:expression;

## atomic expressions
relation atomic_expression sub logical_expression,
    plays not_expression:expression,
    plays and_expression:expression,
    plays or_expression:expression;

relation propositional_expression sub atomic_expression,
	relates atom;

relation comparison_expression sub atomic_expression,
    relates lhs_value,
    relates rhs_value;

relation less_than sub comparison_expression;
relation less_than_equal sub comparison_expression;
relation greater_than sub comparison_expression;
relation greater_than_equal sub comparison_expression;
relation equal sub comparison_expression;
relation not_equal sub comparison_expression;

## compound expression
relation compound_expression sub logical_expression;

relation and_expression sub compound_expression,
    relates expression @card(0..);

relation or_expression sub compound_expression,
    relates expression @card(0..),
    plays and_expression:expression;

### Helper types for comparison operand resolution
relation comparison_double_operand_pair,
    relates expression,
    relates lhs_double,
    relates rhs_double;
comparison_expression plays comparison_double_operand_pair:expression;

relation comparison_integer_operand_pair,
    relates expression,
    relates lhs_integer,
    relates rhs_integer;
comparison_expression plays comparison_integer_operand_pair:expression;

relation comparison_string_operand_pair,
    relates expression,
    relates lhs_string,
    relates rhs_string;
comparison_expression plays comparison_string_operand_pair:expression;

relation comparison_bool_operand_pair,
    relates expression,
    relates lhs_bool,
    relates rhs_bool;
comparison_expression plays comparison_bool_operand_pair:expression;

### Rules for comparison expressions
