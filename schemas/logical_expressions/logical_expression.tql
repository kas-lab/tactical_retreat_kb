rule and_expression_satisfied:
    when {
        $and_exp (expression: $e) isa and_expression;
        not {$e is $and_exp;};
        $e has expression_satisfied true;

        $invalid_e isa logical_expression;
        not {
            $invalid_e is $and_exp;
            $e is $invalid_e;
        };

        not {
            # $e is not $and_exp;
            $and_exp (expression: $invalid_e) isa and_expression;
            $invalid_e has expression_satisfied false;
        };
    } then {
        $and_exp has expression_satisfied true;
    };

