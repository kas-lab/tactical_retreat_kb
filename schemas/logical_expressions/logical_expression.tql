rule comparison_expression_double_less_than_satisfied:
    when {
        $expr isa less_than;
        (expression: $expr, lhs_double: $lhs, rhs_double: $rhs) isa comparison_double_operand_pair;
        $lhs has double_value $value_lhs;
        $rhs has double_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $expr has expression_satisfied true;
    };

rule comparison_expression_double_less_than_equal_satisfied:
    when {
        $expr isa less_than_equal;
        (expression: $expr, lhs_double: $lhs, rhs_double: $rhs) isa comparison_double_operand_pair;
        $lhs has double_value $value_lhs;
        $rhs has double_value $value_rhs;
        $value_lhs <= $value_rhs;
    } then {
        $expr has expression_satisfied true;
    };

rule comparison_expression_double_greater_than_satisfied:
    when {
        $expr isa greater_than;
        (expression: $expr, lhs_double: $lhs, rhs_double: $rhs) isa comparison_double_operand_pair;
        $lhs has double_value $value_lhs;
        $rhs has double_value $value_rhs;
        $value_lhs > $value_rhs;
    } then {
        $expr has expression_satisfied true;
    };

rule comparison_expression_double_greater_than_equal_satisfied:
    when {
        $expr isa greater_than_equal;
        (expression: $expr, lhs_double: $lhs, rhs_double: $rhs) isa comparison_double_operand_pair;
        $lhs has double_value $value_lhs;
        $rhs has double_value $value_rhs;
        $value_lhs >= $value_rhs;
    } then {
        $expr has expression_satisfied true;
    };

rule comparison_expression_double_equal_satisfied:
    when {
        $expr isa equal;
        (expression: $expr, lhs_double: $lhs, rhs_double: $rhs) isa comparison_double_operand_pair;
        $lhs has double_value $value_lhs;
        $rhs has double_value $value_rhs;
        $value_lhs == $value_rhs;
    } then {
        $expr has expression_satisfied true;
    };

rule comparison_expression_double_not_equal_satisfied:
    when {
        $expr isa not_equal;
        (expression: $expr, lhs_double: $lhs, rhs_double: $rhs) isa comparison_double_operand_pair;
        $lhs has double_value $value_lhs;
        $rhs has double_value $value_rhs;
        $value_lhs != $value_rhs;
    } then {
        $expr has expression_satisfied true;
    };

