### Helper types for comparison operand resolution
relation comparison_double_operand_pair,
    relates expression,
    relates lhs_double,
    relates rhs_double;
comparison_expression plays comparison_double_operand_pair:expression;
ValueDouble plays comparison_double_operand_pair:lhs_double;
ValueDouble plays comparison_double_operand_pair:rhs_double;

relation comparison_integer_operand_pair,
    relates expression,
    relates lhs_integer,
    relates rhs_integer;
comparison_expression plays comparison_integer_operand_pair:expression;
ValueInteger plays comparison_integer_operand_pair:lhs_integer;
ValueInteger plays comparison_integer_operand_pair:rhs_integer;

relation comparison_string_operand_pair,
    relates expression,
    relates lhs_string,
    relates rhs_string;
comparison_expression plays comparison_string_operand_pair:expression;
ValueString plays comparison_string_operand_pair:lhs_string;
ValueString plays comparison_string_operand_pair:rhs_string;

relation comparison_bool_operand_pair,
    relates expression,
    relates lhs_bool,
    relates rhs_bool;
comparison_expression plays comparison_bool_operand_pair:expression;
ValueBool plays comparison_bool_operand_pair:lhs_bool;
ValueBool plays comparison_bool_operand_pair:rhs_bool;

