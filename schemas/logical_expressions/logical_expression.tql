define

attribute expression_name, value string;

relation expression @abstract,
    owns expression_name @unique;  # to make it possible to query the expression

# logical expressions
relation logical_expression @abstract, sub expression;

## negation expression
relation not_expression sub logical_expression,
    relates expression,
    plays and_expression:expression,
    plays or_expression:expression;

## atomic expressions
relation atomic_expression @abstract, sub logical_expression,
    plays not_expression:expression,
    plays and_expression:expression,
    plays or_expression:expression;

relation propositional_expression sub atomic_expression,
	relates atom @card(1);

relation comparison_expression sub atomic_expression,
    relates lhs_value @card(1),
    relates rhs_value @card(1);

relation less_than sub comparison_expression;
relation less_than_equal sub comparison_expression;
relation greater_than sub comparison_expression;
relation greater_than_equal sub comparison_expression;
relation equal sub comparison_expression;
relation not_equal sub comparison_expression;

## compound expression
relation compound_expression @abstract, sub logical_expression;

relation and_expression sub compound_expression,
    relates expression @card(0..);

relation or_expression sub compound_expression,
    relates expression @card(0..),
    plays and_expression:expression;

#### connection with the context model
##### The measure entity can be interpreted as a Variable
Measure plays comparison_expression:lhs_value;
Measure plays comparison_expression:rhs_value;

Value plays comparison_expression:lhs_value;
Value plays comparison_expression:rhs_value;

# ValueBool plays propositional_expression:atom;
Value plays propositional_expression:atom;
Measure plays propositional_expression:atom;

#### Schema-level functions (TypeDB 3 replacement for TypeDB 2 rules)
#
# Variant A: unified comparison_valid replaces 6 per-op functions.
# atomic_valid is a 2-branch dispatcher: propositional or comparison.

fun propositional_valid($e: propositional_expression) -> boolean:
  match
    $e links (atom: $atom);
    { $atom has bool_value true; } or {
      (measure: $atom, measurement_value: $mv) isa measurement, has latest true;
      $mv has bool_value true;
    };
  let $r = true; return first $r;

fun comparison_valid($e: comparison_expression) -> boolean:
  match
    $e links (lhs_value: $lhs); $e links (rhs_value: $rhs);
    { $lhs has data_value $l; } or {
      (measure: $lhs, measurement_value: $lmv) isa measurement, has latest true;
      $lmv has data_value $l;
    };
    { $rhs has data_value $r; } or {
      (measure: $rhs, measurement_value: $rmv) isa measurement, has latest true;
      $rmv has data_value $r;
    };
    { $e isa less_than;          $l < $r; } or
    { $e isa less_than_equal;    $l <= $r; } or
    { $e isa greater_than;       $l > $r; } or
    { $e isa greater_than_equal; $l >= $r; } or
    { $e isa equal;              $l == $r; } or
    { $e isa not_equal;          not { $l == $r; }; };
  let $ok = true; return first $ok;

fun atomic_valid($e: logical_expression) -> boolean:
  match
    { $e isa propositional_expression; true == propositional_valid($e); } or
    { $e isa comparison_expression;    true == comparison_valid($e); };
  let $r = true; return first $r;

fun not_valid($e: not_expression) -> boolean:
  match
    $e links (expression: $e2);
    not {true == atomic_valid($e2);};
  let $r = true; return first $r;

fun or_valid($or_exp: or_expression) -> boolean:
  match
    $or_exp links (expression: $e);
    {
        $e isa atomic_expression;
        true == atomic_valid($e);
    } or {
        $e isa not_expression;
        true == not_valid($e);
    };
    # true == expression_valid($e);
  let $r = true; return first $r;

fun and_valid($and_expr: and_expression) -> boolean:
  match
    not {
      $and_expr links (expression: $e);
      not {
        { $e isa atomic_expression; true == atomic_valid($e); } or
        { $e isa not_expression;    true == not_valid($e); } or
        { $e isa or_expression;     true == or_valid($e); };
      };
    };
  let $r = true; return first $r;

# expression_valid: handles compound expressions with subs that may be 1-level compound.
# Covers max depth 3: and -> or -> not -> atomic.
fun expression_valid($e: logical_expression) -> boolean:
  match
    { $e isa atomic_expression; true == atomic_valid($e); } or
    { $e isa not_expression; true == not_valid($e); } or
    { $e isa or_expression;  true == or_valid($e); } or
    { $e isa and_expression;  true == and_valid($e); };
  let $r = true; return first $r;
