rule equal_bool_measure_satisfied:
    when {
        $lhs isa Measure;
        (measure: $lhs, measurement_value: $mv_lhs) isa measurement,
            has latest true;
        $mv_lhs isa ValueBool, has bool_value $value_lhs;
        $rhs isa Measure;
        (measure: $rhs, measurement_value: $mv_rhs) isa measurement,
            has latest true;
        $mv_rhs isa ValueBool, has bool_value $value_rhs;

        $equal_expr (lhs_value: $lhs, rhs_value: $rhs) isa equal;
        $value_lhs == $value_rhs;
    } then {
        $equal_expr has expression_satisfied true;
    };

