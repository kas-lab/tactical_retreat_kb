### not equal rules
rule not_equal_double_values_satisfied:
    when {
        $lhs isa ValueDouble, has double_value $value_lhs;
        $rhs isa ValueDouble, has double_value $value_rhs;

        $not_equal_expr (lhs_value: $lhs, rhs_value: $rhs) isa not_equal;
        $value_lhs != $value_rhs;
    } then {
        $not_equal_expr has expression_satisfied true;
    };

rule not_equal_integer_values_satisfied:
