define

attribute expression_name, value string;
attribute expression_satisfied, value boolean;

relation expression @abstract,
    owns expression_name @unique;  # to make it possible to query the expression

# logical expressions
relation logical_expression @abstract extends expression,
    owns expression_satisfied;

## negation expression
relation not_expression extends logical_expression,
    relates expression,
    plays and_expression:expression,
    plays or_expression:expression;

## atomic expressions
relation atomic_expression @abstract extends logical_expression,
    plays not_expression:expression,
    plays and_expression:expression,
    plays or_expression:expression;

relation propositional_expression extends atomic_expression,
	relates atom;

relation comparison_expression @abstract extends atomic_expression,
    relates lhs_value,
    relates rhs_value;

relation less_than extends comparison_expression;
relation less_than_equal extends comparison_expression;
relation greater_than extends comparison_expression;
relation greater_than_equal extends comparison_expression;
relation equal extends comparison_expression;
relation not_equal extends comparison_expression;

## compound expression
relation compound_expression @abstract extends logical_expression;

relation and_expression extends compound_expression,
    relates expression;

relation or_expression extends compound_expression,
    relates expression,
    plays and_expression:expression;

#### connection with the context model
##### The measure entity can be interpreted as a Variable
Measure plays comparison_expression:lhs_value;
Measure plays comparison_expression:rhs_value;

Value plays comparison_expression:lhs_value;
Value plays comparison_expression:rhs_value;

ValueBool plays propositional_expression:atom;
Measure plays propositional_expression:atom;

