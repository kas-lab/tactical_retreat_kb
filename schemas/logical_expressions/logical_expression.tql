#### equal rules
rule equal_double_values_satisfied:
    when {
        $lhs isa ValueDouble, has double_value $value_lhs;
        $rhs isa ValueDouble, has double_value $value_rhs;

        $equal_expr (lhs_value: $lhs, rhs_value: $rhs) isa equal;
        $value_lhs == $value_rhs;
    } then {
        $equal_expr has expression_satisfied true;
    };

rule equal_integer_values_satisfied:
    when {
        $lhs isa ValueInteger, has integer_value $value_lhs;
        $rhs isa ValueInteger, has integer_value $value_rhs;

        $equal_expr (lhs_value: $lhs, rhs_value: $rhs) isa equal;
        $value_lhs == $value_rhs;
    } then {
        $equal_expr has expression_satisfied true;
    };

rule equal_string_values_satisfied:
    when {
        $lhs isa ValueString, has string_value $value_lhs;
        $rhs isa ValueString, has string_value $value_rhs;

