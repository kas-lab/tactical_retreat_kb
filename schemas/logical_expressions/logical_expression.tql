        $rhs isa Measure;
        (measure: $rhs, measurement_value: $mv_rhs) isa measurement,
            has latest true;
        $mv_rhs isa ValueInteger, has integer_value $value_rhs;

        $less_than_expr (lhs_value: $lhs, rhs_value: $rhs) isa less_than;
        $value_lhs < $value_rhs;
