define

### fuzzy membership attribute
attribute membership_degree, value double;

attribute offset_value, value double;

### fuzzy membership entity ("functions")
entity FuzzySet @abstract,
	owns offset_value;

entity AscendSet extends FuzzySet,
	plays fuzzy_ascend_expression:fuzzy_set;
entity DecaySet extends FuzzySet,
	plays fuzzy_decay_expression:fuzzy_set;
entity UnimodalSet extends FuzzySet,
	plays fuzzy_unimodal_expression:fuzzy_set;

### fuzzy membership attributes
attribute exponent, value double;
attribute inflection_point, value double;
attribute curvature, value double;

attribute a, value double;
attribute b, value double;
attribute c, value double;

attribute sigma, value double;
attribute center, value double;

### Triangular, guassian etc membership functions (not necessarly descend or ascend)

# μ(x) =  (x – a) / (b – a), a ≤ x ≤ b
# μ(x) = (c – x) / (c – b), b ≤ x ≤ c
entity FuzzyTriangular extends UnimodalSet,
	owns a,
	owns b,
	owns c;

# μ(x) = e^(-0.5*( ( (x - center) / sigma)^2 ) )
entity FuzzyGaussian extends UnimodalSet,
	owns sigma,
	owns center;

### Ascend fuzzy membership functions

## exponential saturation membership function
## m(x) = 1 - e^(-exponent * x), exponent > 0
entity FuzzyExponentialSaturation extends AscendSet,
	owns exponent; # speed of saturation

## sigmoid membership function
## m(x) = 1 / (1 + e ^ -exponent*(x - x0))
entity FuzzySigmoid extends AscendSet,
	owns exponent,
	owns inflection_point; # where m(inflection_point) = 0.5

## bounded linear fraction membership function (monotonic)
## m(x) = x / (x + curvature), curvature > 0
entity FuzzyBoundedLinearFraction extends AscendSet,
	owns curvature; # controls the curvature

### Decay fuzzy membership functions

## exponential decay membership function
## m(x) = e^(-exponent * x), exponent > 0
entity FuzzyExponentialDecay extends DecaySet,
	owns exponent;

## rational decay membership function
## m(x) = curvature / (x + curvature), curvature > 0
entity FuzzyRationalDecay extends DecaySet,
	owns curvature;

### Fuzzy expressions
attribute quantified_value, value double;

relation fuzzy_expression @abstract extends expression,
	owns membership_degree,
	owns quantified_value,
	owns offset_value;

relation fuzzy_comparison_expression extends fuzzy_expression,
	plays fuzzy_and:expression,
	plays fuzzy_or:expression,
	plays fuzzy_not:expression,
	relates term;

relation fuzzy_decay_expression extends fuzzy_comparison_expression,
	relates fuzzy_set;
relation fuzzy_ascend_expression extends fuzzy_comparison_expression,
	relates fuzzy_set;
relation fuzzy_unimodal_expression extends fuzzy_comparison_expression,
	relates fuzzy_set;

## compound expression
relation fuzzy_operator @abstract extends fuzzy_expression;

relation fuzzy_and extends fuzzy_operator,
    relates expression;

relation fuzzy_or extends fuzzy_operator,
    relates expression,
    plays fuzzy_and:expression;

relation fuzzy_not extends fuzzy_operator,
    relates expression,
	plays fuzzy_and:expression,
    plays fuzzy_or:expression;


#### connection with logical_expression model
atomic_expression owns membership_degree;
atomic_expression plays fuzzy_not:expression;
atomic_expression plays fuzzy_and:expression;
atomic_expression plays fuzzy_or:expression;

not_expression owns membership_degree;
not_expression plays fuzzy_and:expression;
not_expression plays fuzzy_or:expression;

ValueInteger plays fuzzy_comparison_expression:term;
ValueDouble plays fuzzy_comparison_expression:term;
Measure plays fuzzy_comparison_expression:term;






