rule comparison_expression_state_dependency_greater_than_equal_double_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa greater_than_equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
