# ── Fulfillment computation: equal ───────────────────────────────────────────

rule comparison_expression_state_dependency_equal_interval_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs == $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_equal_interval_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs == $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_equal_double_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs == $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_equal_double_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs == $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };


# ── Fulfillment computation: not_equal ───────────────────────────────────────

rule comparison_expression_state_dependency_not_equal_interval_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa not_equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs != $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_not_equal_interval_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa not_equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs != $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_not_equal_double_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa not_equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs != $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_not_equal_double_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa not_equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs != $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };


# ── Complement rules: unfulfilled (0.0) ──────────────────────────────────────
# One rule per operator × operand-combo (6 × 4 = 24).  Each checks the
# arithmetic complement of the corresponding 1.0 rule so that negation is never
# used over `fulfillment` — this avoids the TypeDB stratification cycle that
# arises when compound-expression fulfillment rules also own `fulfillment`.

# ── less_than false ────────────────────────────────────────────────────────
rule comparison_expression_state_dependency_less_than_interval_interval_false:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs >= $value_rhs;
    } then { $sd has fulfillment 0.0; };

rule comparison_expression_state_dependency_less_than_interval_double_false:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs >= $value_rhs;
    } then { $sd has fulfillment 0.0; };

rule comparison_expression_state_dependency_less_than_double_interval_false:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs >= $value_rhs;
    } then { $sd has fulfillment 0.0; };

rule comparison_expression_state_dependency_less_than_double_double_false:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs >= $value_rhs;
    } then { $sd has fulfillment 0.0; };


# ── less_than_equal false ──────────────────────────────────────────────────
rule comparison_expression_state_dependency_less_than_equal_interval_interval_false:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than_equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs > $value_rhs;
    } then { $sd has fulfillment 0.0; };

rule comparison_expression_state_dependency_less_than_equal_interval_double_false:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than_equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs > $value_rhs;
    } then { $sd has fulfillment 0.0; };

rule comparison_expression_state_dependency_less_than_equal_double_interval_false:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than_equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
