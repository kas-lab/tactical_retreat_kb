define

# Hypothetical fulfillment of comparison_expression given a system_state.
#
# Design mirrors the tactic_rule analogue in
#   discover_hypothetical_req_fulfillment.tql,
# replacing tactic_rule_dependency → state_dependency and
#           effect.resulting_effect_value → symbolic_interval_definition.median_bound_value.
#
# The core idea: a state_dependency relates a system_state to a
# comparison_expression whose operands involve the measures that define that
# state.  For each such dependency we ask "if we were in this state, would
# this comparison be satisfied?"  The answer is derived from the
# median_bound_value of the symbolic interval assigned to the relevant measure
# in that state, rather than from the live measurement value.
#
# NOTE on fulfillment attribute: also defined in relaxed_model.tql.
# When loading both schemas into the same database, remove this definition
# and source fulfillment from the common base schema.

fulfillment sub attribute,
    value double;

state_dependency sub relation,
    abstract,
    owns fulfillment,
    relates system_state,
    relates dependent;

# Concrete subtype used for leaf (comparison / fuzzy) expressions.
# The compound subtypes (sd_not, sd_or, …) are declared later.
comparison_state_dependency sub state_dependency;

state plays state_dependency:system_state;
expression plays state_dependency:dependent;

# Infer which expressions depend on which system states
## Infer the state dependencies of comparison expressions based on the symbolic intervals they reference.
rule comparison_expression_state_dependency:
    when {
        $expression ($measure) isa comparison_expression;
        $measure isa Measure;
        $system_state (median_valuation: $med_val) isa state;
        $med_val (measure: $measure) isa MedianValuation;
    } then {
        (system_state: $system_state, dependent: $expression) isa comparison_state_dependency;
    };

rule fuzzy_expression_state_dependency:
    when {
        $expression (term: $measure) isa fuzzy_comparison_expression;
        $measure isa Measure;
        $system_state (median_valuation: $med_val) isa state;
        $med_val (measure: $measure) isa MedianValuation;
    } then {
        (system_state: $system_state, dependent: $expression) isa comparison_state_dependency;
    };

rule relaxed_fuzzy_expression_state_dependency:
    when {
        $expression (term: $measure) isa relaxed_fuzzy_expression;
        $measure isa Measure;
        $system_state (median_valuation: $med_val) isa state;
        $med_val (measure: $measure) isa MedianValuation;
    } then {
        (system_state: $system_state, dependent: $expression) isa comparison_state_dependency;
    };

# ── Operand-tagging helper relations ─────────────────────────────────────────
# Analogues of tr_dependency_*_operand from
# discover_hypothetical_req_fulfillment.tql.

# lhs/rhs resolves to a concrete double value (literal or current measurement).
sd_lhs_double_operand sub relation,
    relates sd_dependency,
    relates lhs_double;
state_dependency plays sd_lhs_double_operand:sd_dependency;
ValueDouble plays sd_lhs_double_operand:lhs_double;

sd_rhs_double_operand sub relation,
    relates sd_dependency,
    relates rhs_double;
state_dependency plays sd_rhs_double_operand:sd_dependency;
ValueDouble plays sd_rhs_double_operand:rhs_double;

# lhs/rhs is a Measure whose hypothetical value is given by a symbolic
# interval in the system_state (via median_bound_value).
sd_lhs_interval_operand sub relation,
    relates sd_dependency,
    relates lhs_interval;
state_dependency plays sd_lhs_interval_operand:sd_dependency;
MedianValuation plays sd_lhs_interval_operand:lhs_interval;

sd_rhs_valuation_operand sub relation,
    relates sd_dependency,
    relates rhs_valuation;
state_dependency plays sd_rhs_valuation_operand:sd_dependency;
MedianValuation plays sd_rhs_valuation_operand:rhs_valuation;

# lhs/rhs is a Measure NOT covered by the state's intervals;
# its value is resolved from the latest live measurement instead.
sd_lhs_measure_without_interval sub relation,
    relates sd_dependency,
    relates lhs_measure;
state_dependency plays sd_lhs_measure_without_interval:sd_dependency;
Measure plays sd_lhs_measure_without_interval:lhs_measure;

sd_rhs_measure_without_interval sub relation,
    relates sd_dependency,
    relates rhs_measure;
state_dependency plays sd_rhs_measure_without_interval:sd_dependency;
Measure plays sd_rhs_measure_without_interval:rhs_measure;


# ── Operand classification rules ─────────────────────────────────────────────

# lhs is a Measure covered by an interval of a label in the system_state.
rule comparison_expression_state_dependency_lhs_interval:
    when {
        $sd (dependent: $expression, system_state: $state) isa state_dependency;
        $expression (lhs_value: $lhs) isa comparison_expression;
        $lhs isa Measure;
        $state (median_valuation: $med_val) isa state;
        $med_val (measure: $lhs) isa MedianValuation;
    } then {
        (sd_dependency: $sd, lhs_interval: $med_val) isa sd_lhs_interval_operand;
    };

# rhs is a Measure covered by an interval of a label in the system_state.
rule comparison_expression_state_dependency_rhs_valuation:
    when {
        $sd (dependent: $expression, system_state: $state) isa state_dependency;
        $expression (rhs_value: $rhs) isa comparison_expression;
        $rhs isa Measure;
        $state (median_valuation: $med_val) isa state;
        $med_val (measure: $rhs) isa MedianValuation;
    } then {
        (sd_dependency: $sd, rhs_valuation: $med_val) isa sd_rhs_valuation_operand;
    };

# lhs is a literal ValueDouble.
rule comparison_expression_state_dependency_lhs_literal_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression (lhs_value: $lhs) isa comparison_expression;
        $lhs isa ValueDouble;
    } then {
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
    };

# rhs is a literal ValueDouble.
rule comparison_expression_state_dependency_rhs_literal_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression (rhs_value: $rhs) isa comparison_expression;
        $rhs isa ValueDouble;
    } then {
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
    };

# lhs is a Measure NOT covered by the state's intervals.
rule comparison_expression_state_dependency_lhs_measure_without_interval:
    when {
        $sd (dependent: $expression, system_state: $state) isa state_dependency;
        $expression (lhs_value: $lhs) isa comparison_expression;
        $lhs isa Measure;
        not {
            $state (median_valuation: $med_val) isa state;
            $med_val (measure: $lhs) isa MedianValuation;
        };
    } then {
        (sd_dependency: $sd, lhs_measure: $lhs) isa sd_lhs_measure_without_interval;
    };

# rhs is a Measure NOT covered by the state's intervals.
rule comparison_expression_state_dependency_rhs_measure_without_interval:
    when {
        $sd (dependent: $expression, system_state: $state) isa state_dependency;
        $expression (rhs_value: $rhs) isa comparison_expression;
        $rhs isa Measure;
        not {
            $state (median_valuation: $med_val) isa state;
            $med_val (measure: $rhs) isa MedianValuation;
        };
    } then {
        (sd_dependency: $sd, rhs_measure: $rhs) isa sd_rhs_measure_without_interval;
    };

# Lift a measure-without-interval to its latest double measurement value,
# so the fulfillment rules only need to handle double operands.
rule comparison_expression_state_dependency_lhs_measure_double:
    when {
        (sd_dependency: $sd, lhs_measure: $lhs) isa sd_lhs_measure_without_interval;
        (measure: $lhs, measurement_value: $mv) isa measurement,
            has latest true;
        $mv isa ValueDouble;
    } then {
        (sd_dependency: $sd, lhs_double: $mv) isa sd_lhs_double_operand;
    };

rule comparison_expression_state_dependency_rhs_measure_double:
    when {
        (sd_dependency: $sd, rhs_measure: $rhs) isa sd_rhs_measure_without_interval;
        (measure: $rhs, measurement_value: $mv) isa measurement,
            has latest true;
        $mv isa ValueDouble;
    } then {
        (sd_dependency: $sd, rhs_double: $mv) isa sd_rhs_double_operand;
    };


# ── Fulfillment computation: less_than ───────────────────────────────────────

rule comparison_expression_state_dependency_less_than_interval_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_less_than_interval_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_less_than_double_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_less_than_double_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs < $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };


# ── Fulfillment computation: less_than_equal ─────────────────────────────────

rule comparison_expression_state_dependency_less_than_equal_interval_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than_equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs <= $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_less_than_equal_interval_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than_equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs <= $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_less_than_equal_double_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than_equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs <= $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_less_than_equal_double_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa less_than_equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs <= $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };


# ── Fulfillment computation: greater_than ────────────────────────────────────

rule comparison_expression_state_dependency_greater_than_interval_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa greater_than;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs > $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_greater_than_interval_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa greater_than;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs > $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_greater_than_double_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa greater_than;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs > $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_greater_than_double_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa greater_than;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs > $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };


# ── Fulfillment computation: greater_than_equal ──────────────────────────────

rule comparison_expression_state_dependency_greater_than_equal_interval_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa greater_than_equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs >= $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_greater_than_equal_interval_double:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa greater_than_equal;
        (sd_dependency: $sd, lhs_interval: $lhs) isa sd_lhs_interval_operand;
        $lhs has median_bound_value $value_lhs;
        (sd_dependency: $sd, rhs_double: $rhs) isa sd_rhs_double_operand;
        $rhs has double_value $value_rhs;
        $value_lhs >= $value_rhs;
    } then {
        $sd has fulfillment 1.0;
    };

rule comparison_expression_state_dependency_greater_than_equal_double_interval:
    when {
        $sd (dependent: $expression) isa state_dependency;
        $expression isa greater_than_equal;
        (sd_dependency: $sd, lhs_double: $lhs) isa sd_lhs_double_operand;
        $lhs has double_value $value_lhs;
        (sd_dependency: $sd, rhs_valuation: $rhs) isa sd_rhs_valuation_operand;
        $rhs has median_bound_value $value_rhs;
        $value_lhs >= $value_rhs;
    } then {
