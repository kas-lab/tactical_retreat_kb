define

## Attributes
attribute system_name, value string;
attribute start_time, value datetime;

### requirement attributes
attribute requirement_name, value string;
attribute description, value string;
attribute in_effect, value boolean;

attribute fulfillment, value double;

### event expr attributes
attribute event_duration, value double;  # what unit should we use? seconds?
attribute event_end_duration, value double;

### fuzzy expr attributes
attribute required_value, value double;
attribute required_period, value double;

## Entities
entity System,
	owns system_name @key,
	owns start_time,
	plays system_requirement:system;

## Relations
relation system_requirement @abstract,
	owns in_effect,
	relates system;

relation relaxed_requirement extends system_requirement,
	owns requirement_name @key,
	owns description,
	owns fulfillment,
	relates expression;

relation relaxed_expression @abstract extends expression,
	owns fulfillment,
	plays relaxed_requirement:expression;

relation atomic_relaxed_expression @abstract extends relaxed_expression,
	relates expression,
	plays shall_expression:expression,
    plays may_expression:expression,
	plays until_expression:after;

relation compound_relaxed_expression @abstract extends relaxed_expression;

relation shall_expression extends compound_relaxed_expression,
	relates expression;
relation may_expression extends compound_relaxed_expression,
	relates expression,
	plays shall_expression:expression;

relation eventually_expression extends atomic_relaxed_expression;

### Event expressions
relation event_expression @abstract extends atomic_relaxed_expression,
	owns event_duration;

relation after_expression extends event_expression;
relation before_expression extends event_expression;
relation in_expression extends event_expression,
	owns event_end_duration;

### Until expression
relation until_expression extends relaxed_expression,
	relates before,
	relates after,
	plays shall_expression:expression,
	plays may_expression:expression;

#### Fuzzy set expression

relation relaxed_fuzzy_expression @abstract extends relaxed_expression,
	owns membership_degree,
	relates term,
	plays shall_expression:expression,
	plays may_expression:expression,
	plays atomic_relaxed_expression:expression;

# can have any membership function
relation as_close_as_possible_expression extends relaxed_fuzzy_expression,
	owns required_value,
	relates fuzzy_set;

relation as_many_as_possible_expression extends relaxed_fuzzy_expression,
	relates fuzzy_set;
relation as_few_as_possible_expression extends relaxed_fuzzy_expression,
	relates fuzzy_set;

# can have any membership function
relation freq_as_close_as_possible_expression extends relaxed_fuzzy_expression,
	owns required_period,
	relates fuzzy_set;

relation as_early_as_possible_expression extends relaxed_fuzzy_expression,
	relates fuzzy_set;
relation as_late_as_possible_expression extends relaxed_fuzzy_expression,
	relates fuzzy_set;

# connection to fuzzy_expression model
fuzzy_expression relates relaxed_expression;
relaxed_fuzzy_expression plays fuzzy_expression:relaxed_expression;
relaxed_fuzzy_expression plays fuzzy_and:expression;
relaxed_fuzzy_expression plays fuzzy_or:expression;
relaxed_fuzzy_expression plays fuzzy_not:expression;

AscendSet plays as_many_as_possible_expression:fuzzy_set;
AscendSet plays as_late_as_possible_expression:fuzzy_set;

DecaySet plays as_few_as_possible_expression:fuzzy_set;
DecaySet plays as_early_as_possible_expression:fuzzy_set;

UnimodalSet plays as_close_as_possible_expression:fuzzy_set;
UnimodalSet plays freq_as_close_as_possible_expression:fuzzy_set;

# connection to logical_expression model
# TODO: check if we can just make proposition_expression play the role of a expression in relaxed_expression
# instead of one by one
propositional_expression plays atomic_relaxed_expression:expression;

logical_expression plays shall_expression:expression;
logical_expression plays may_expression:expression;

# TODO: can logical_expression play these roles?
propositional_expression plays until_expression:before;
propositional_expression plays until_expression:after;

ValueInteger plays relaxed_fuzzy_expression:term;
ValueDouble plays relaxed_fuzzy_expression:term;
Measure plays relaxed_fuzzy_expression:term;

propositional_expression owns fulfillment;

fuzzy_operator plays shall_expression:expression;
fuzzy_operator plays may_expression:expression;

fuzzy_expression owns fulfillment;




