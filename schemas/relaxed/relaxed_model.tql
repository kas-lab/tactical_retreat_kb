define

## Attributes
system_name sub attribute,
	value string;
start_time sub attribute,
	value datetime;

### requirement attributes
requirement_name sub attribute,
	value string;
description sub attribute,
	value string;
in_effect sub attribute,
	value boolean;

fulfillment sub attribute,
	value double;

### event expr attributes
event_duration sub attribute,
	value double;  # what unit should we use? seconds?
event_end_duration sub attribute,
	value double;

### fuzzy expr attributes
required_value sub attribute,
	value double;
required_period sub attribute,
	value double;

## Entities
System sub entity,
	owns system_name @key,
	owns start_time,
	plays system_requirement:system;

## Relations
system_requirement sub relation,
	abstract,
	owns in_effect,
	relates system;

relaxed_requirement sub system_requirement,
	owns requirement_name @key,
	owns description,
	owns fulfillment,
	relates expression;

relaxed_expression sub expression,
	abstract,
	owns fulfillment,
	plays relaxed_requirement:expression;

atomic_relaxed_expression sub relaxed_expression,
	abstract,
	relates expression,
	plays shall_expression:expression,
    plays may_expression:expression,
	plays until_expression:after;

compound_relaxed_expression sub relaxed_expression,
	abstract;

shall_expression sub compound_relaxed_expression,
	relates expression;
may_expression sub compound_relaxed_expression,
	relates expression,
	plays shall_expression:expression;

eventually_expression sub atomic_relaxed_expression;

### Event expressions
event_expression sub atomic_relaxed_expression,
	abstract,
	owns event_duration;

after_expression sub event_expression;
before_expression sub event_expression;
in_expression sub event_expression,
	owns event_end_duration;

### Until expression
until_expression sub relaxed_expression,
	relates before,
	relates after,
	plays shall_expression:expression,
	plays may_expression:expression;

#### Fuzzy set expression

relaxed_fuzzy_expression sub relaxed_expression,
	abstract,
	owns membership_degree,
	relates proposition,
	plays shall_expression:expression,
	plays may_expression:expression,
	plays atomic_relaxed_expression:expression;

# can have any membership function
as_close_as_possible_expression sub relaxed_fuzzy_expression,
	owns required_value,
	relates fuzzy_set;

as_many_as_possible_expression sub relaxed_fuzzy_expression,
	relates fuzzy_set;
as_few_as_possible_expression sub relaxed_fuzzy_expression,
	relates fuzzy_set;

# can have any membership function
freq_as_close_as_possible_expression sub relaxed_fuzzy_expression,
	owns required_period,
	relates fuzzy_set;

as_early_as_possible_expression sub relaxed_fuzzy_expression,
	relates fuzzy_set;
as_late_as_possible_expression sub relaxed_fuzzy_expression,
	relates fuzzy_set;

# connection to fuzzy_expression model
fuzzy_expression relates relaxed_expression;
relaxed_fuzzy_expression plays fuzzy_expression:relaxed_expression;
relaxed_fuzzy_expression plays fuzzy_and:expression;
relaxed_fuzzy_expression plays fuzzy_or:expression;
relaxed_fuzzy_expression plays fuzzy_not:expression;

AscendSet plays as_many_as_possible_expression:fuzzy_set;
AscendSet plays as_late_as_possible_expression:fuzzy_set;

DecaySet plays as_few_as_possible_expression:fuzzy_set;
DecaySet plays as_early_as_possible_expression:fuzzy_set;

UnimodalSet plays as_close_as_possible_expression:fuzzy_set;
UnimodalSet plays freq_as_close_as_possible_expression:fuzzy_set;

# connection to logical_expression model
# TODO: check if we can just make proposition_expression play the role of a proposition in relaxed_expression
# instead of one by one
propositional_expression plays atomic_relaxed_expression:expression;

logical_expression plays shall_expression:expression;
logical_expression plays may_expression:expression;

# TODO: can logical_expression play these roles?
propositional_expression plays until_expression:before;
propositional_expression plays until_expression:after;
propositional_expression plays relaxed_fuzzy_expression:proposition;

propositional_expression owns fulfillment;

fuzzy_operator plays shall_expression:expression;
fuzzy_operator plays may_expression:expression;

fuzzy_expression owns fulfillment;

rule as_close_as_possible_fuzzy_expression:
	when {
		$expr (proposition: $proposition, fuzzy_set: $fuzzy_set) isa as_close_as_possible_expression;
	} then {
		(proposition: $proposition, fuzzy_set:$fuzzy_set, relaxed_expression: $expr) isa fuzzy_unimodal_expression;
	};

rule as_close_as_possible_fuzzy_expression_offset:
	when {
		$fuzzy_expr (proposition: $proposition, fuzzy_set:$fuzzy_set, relaxed_expression: $expr) isa fuzzy_unimodal_expression;
		$expr (proposition: $proposition, fuzzy_set: $fuzzy_set) isa as_close_as_possible_expression,
			has required_value $required_value;
		?offset_value_ = -1.0 * $required_value;
	} then {
		$fuzzy_expr has offset_value ?offset_value_;
	};

rule as_close_as_possible_membership:
	when {
		$expr isa as_close_as_possible_expression;
		(relaxed_expression: $expr) isa fuzzy_unimodal_expression,
			has membership_degree $membership_degree;
	} then {
		$expr has $membership_degree;
	};

### as_many_as_possible_fuzzy_expression rules
rule as_many_as_possible_fuzzy_expression:
	when {
		$expr (proposition: $proposition, fuzzy_set: $fuzzy_set) isa as_many_as_possible_expression;
	} then {
		(proposition: $proposition, fuzzy_set:$fuzzy_set, relaxed_expression: $expr) isa fuzzy_ascend_expression;
	};

rule as_many_as_possible_membership:
	when {
		$expr isa as_many_as_possible_expression;
		(relaxed_expression: $expr) isa fuzzy_ascend_expression,
			has membership_degree $membership_degree;
	} then {
		$expr has $membership_degree;
	};

### as_few_as_possible_fuzzy_expression rules
rule as_few_as_possible_fuzzy_expression:
	when {
		$expr (proposition: $proposition, fuzzy_set: $fuzzy_set) isa as_few_as_possible_expression;
	} then {
		(proposition: $proposition, fuzzy_set:$fuzzy_set, relaxed_expression: $expr) isa fuzzy_decay_expression;
	};

rule as_few_as_possible_membership:
	when {
		$expr isa as_few_as_possible_expression;
		(relaxed_expression: $expr) isa fuzzy_decay_expression,
			has membership_degree $membership_degree;
	} then {
		$expr has $membership_degree;
	};

### TODO: freq_as_close_as_possible_expression rules
### TODO: as_early_as_possible_expression rules
### TODO: as_late_as_possible_expression rules

## relaxed_fuzzy_fulfillment

rule fuzzy_fulfillment:
	when {
		$fuzzy_expression isa fuzzy_expression,
			has membership_degree $membership_degree;
		?fulfillment_ = $membership_degree;
	} then {
		$fuzzy_expression has fulfillment ?fulfillment_;
	};

rule relaxed_fuzzy_fulfillment:
	when {
		$expr isa relaxed_fuzzy_expression;
		(relaxed_expression: $expr) isa fuzzy_expression,
			has fulfillment $fulfillment;
	} then {
		$expr has $fulfillment;
	};

## expressions fulfillment rules

#  shall_expression: returns min fulfillment among its operands.
rule shall_expression_fulfillment :
	when {
		$shall_expression (expression: $expression) isa! shall_expression;
		$expression has fulfillment $fulfillment;
		not {
			$shall_expression (expression: $b) isa! shall_expression;
			$b has fulfillment $b_fulfillment;
			$b_fulfillment < $fulfillment;
		};
	} then {
		$shall_expression has $fulfillment;
	};

# may_expression: returns max fulfillment among its operands.
rule may_expression_fulfillment :
	when {
		$may_expression (expression: $expression) isa! may_expression;
		$expression has fulfillment $fulfillment;

		not {
			$may_expression (expression: $b) isa! may_expression;
			$b has fulfillment $b_fulfillment;
			$b_fulfillment > $fulfillment;
		};
	} then {
		$may_expression has $fulfillment;
	};

## TODO: add rule for eventually_expression
## TODO: add rule for until_expression
## TODO: add rule for after_expression
## TODO: add rule for before_expression
## TODO: add rule for in_expression

## requirement fulfillment
## interpreting multiple exoressions as a fuzzy and with resolution fulfillment = min(fulfillment1, fulfillment2, ...)
rule requirement_fulfillment :
	when {
		$req (expression: $expression) isa relaxed_requirement;
		$expression has fulfillment $fulfillment;

		not {
			$req (expression: $b) isa relaxed_requirement;
			$b has fulfillment $b_fulfillment;
			$b_fulfillment < $fulfillment;
		};
		?fulfillment_ = $fulfillment;
	} then {
		$req has fulfillment ?fulfillment_;
	};

## crisp proposition fulfillment
rule crisp_proposition_fulfillment_measure_bool_true:
	when {
		$propositional_expression (term: $measure) isa! propositional_expression;
        (measure:$measure, measurement_value: $mv) isa measurement, has latest true;
        $mv isa! ValueBool, has bool_value true;
	} then {
		$propositional_expression has fulfillment 1.0;
	};

rule crisp_proposition_fulfillment_measure_bool_false:
	when {
		$propositional_expression (term: $measure) isa! propositional_expression;
        (measure:$measure, measurement_value: $mv) isa measurement, has latest true;
        $mv isa! ValueBool, has bool_value false;
	} then {
		$propositional_expression has fulfillment 0.0;
	};

rule crisp_proposition_fulfillment_true:
   when {
    $propositional_expression (term: $value) isa! propositional_expression;
	$value isa! ValueBool, has bool_value true;
  } then {
    $propositional_expression has fulfillment 1.0;
  };

rule crisp_proposition_fulfillment_false:
  when {
    $propositional_expression (term: $value) isa! propositional_expression;
	$value isa! ValueBool, has bool_value false;
  } then {
    $propositional_expression has fulfillment 0.0;
  };
