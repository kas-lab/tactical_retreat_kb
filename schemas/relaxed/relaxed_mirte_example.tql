match

$qa_movement_power isa Measure,
	has measure_name "qa_movement_power"; # watt?

insert

## Examples Mirte's MVP use case

$velocity_measure isa Measure,
	has measure_name "velocity_measure",
	has description "The robot's velocity";

# just an example, the measurement should be inserted at runtime
$current_vel isa ValueDouble, has double_value 0.22221;
(measure:$velocity_measure , measurement_value: $current_vel) isa measurement, has measurement_time 2025-08-06T10:57:56.666;

$velocity_set isa FuzzyTriangular,
	has a -0.5,
	has b 0.0,
	has c 0.5;

$velocity_as_close_expression (unimodal_membership: $velocity_set, term: $velocity_measure) isa as_close_as_possible_expression,
	has required_value 0.26;

$velocity_shall_expression (relaxed_expression: $velocity_as_close_expression) isa shall_expression;

$mirte isa System, has system_name "Mirte";

$velocity_requirement (system: $mirte, relaxed_expression: $velocity_shall_expression) isa relaxed_requirement,
	has requirement_name "R1.1 Velocity",
	has in_effect true,
	has description "The robot SHALL maintain its velocity AS CLOSE AS POSSIBLE TO 0.26 m/s.";

# fake mirte requirement
$mv_pwr_fuzzy_set isa FuzzyExponentialDecay,
	has exponent 0.2;

$as_few_mv_pwr_as_possible (decay_membership: $mv_pwr_fuzzy_set, term: $qa_movement_power) isa as_few_as_possible_expression;
$mv_pwr_shall_expression (relaxed_expression: $as_few_mv_pwr_as_possible) isa shall_expression;

$mv_power_requirement (system: $mirte, relaxed_expression: $mv_pwr_shall_expression) isa relaxed_requirement,
	has requirement_name "R1.2 Movement Power",
	has in_effect true,
	has description "The robot SHALL maintain its movement power AS FEW AS POSSIBLE.";
