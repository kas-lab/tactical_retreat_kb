define

## connection with logical_expression model
Feature plays propositional_expression:proposition;

### Rules for propositional_expression
rule propositional_expression_feature_satisfied :
	when {
		$propositional_expression (proposition: $feature) isa propositional_expression;
        $feature isa Feature, has selected true;
	} then {
		$propositional_expression has expression_satisfied true;
	};
