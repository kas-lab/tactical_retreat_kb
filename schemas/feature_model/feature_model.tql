define

# Attributes
feature_name sub attribute,
    value string;

selected sub attribute,
    value boolean;

mandatory sub attribute,
    value boolean;

# Relations
feature_hierarchy sub relation,
    relates parent,
    relates child;

feature_siblings sub relation,
    relates sibling;

feature_subtree sub relation,
    relates root,
    relates member;

alternative sub feature_hierarchy; # exclusive or (XOR)
or_group sub feature_hierarchy;

cross_tree_constraint sub relation,
    relates constraint,
    relates constrained;

excludes_constraint sub cross_tree_constraint;
requires_constraint sub cross_tree_constraint;

# Entities
Feature sub entity,
    owns feature_name @key,
    owns selected,
    owns mandatory,
    plays feature_hierarchy:parent,
    plays feature_hierarchy:child,
    plays cross_tree_constraint:constraint,
    plays cross_tree_constraint:constrained,
    plays feature_siblings:sibling,
    plays feature_subtree:member,
    plays feature_subtree:root;


# Rules

rule siblings:
    when {
        (parent: $f_parent, child: $f_child) isa feature_hierarchy;
        (parent: $f_parent, child: $f_child_2) isa feature_hierarchy;
        not {$f_child is $f_child_2;};
    } then {
        (sibling: $f_child, sibling: $f_child_2) isa feature_siblings;
    };

rule subtree:
    when {
        (parent: $root, child: $f_child) isa feature_hierarchy;
    } then {
        (root: $root, member: $f_child) isa feature_subtree;
    };

rule subtree_recursive:
    when {
        (root: $root, member: $f_ancestor) isa feature_subtree;
        (parent: $f_ancestor, child: $f_descendant) isa feature_hierarchy;
    } then {
        (root: $root, member: $f_descendant) isa feature_subtree;
    };