define

## Attributes

### ROSNode attributes
attribute package, value string;
attribute executable, value string;
attribute lifecycle_state, value string @regex("^(unconfigured|inactive|active|finalized)$");
attribute lifecycle_transition, value string @regex("^(configure|shutdown|activate|deactivate|cleanup)$");

#### Should only be used by is_node_active rule
attribute is_active, value boolean;

### Runtime node attributes
attribute node_name, value string;
attribute namespace, value string;
attribute start_time, value datetime;
attribute end_time, value datetime;

### ROS interfaces attributes
attribute interface_name, value string;
attribute interface_type, value string;

attribute gid, value integer;

### QoS attributes
attribute reliability, value string @regex("^(BEST_EFFORT|RELIABLE|SYSTEM_DEFAULT)");
attribute history, value string @regex("^(KEEP_LAST|KEEP_ALL|UNKNOWN|SYSTEM_DEFAULT)");
attribute depth, value integer;
attribute durability, value string @regex("^(TRANSIENT_LOCAL|VOLATILE|SYSTEM_DEFAULT)");
attribute deadline, value integer;  # 0 indicates infinite
attribute lifespan, value integer;  # 0 indicates infinite
attribute liveliness, value string @regex("^(AUTOMATIC|MANUAL_BY_TOPIC|SYSTEM_DEFAULT)");
attribute lease_duration, value integer;  # 0 indicates infinite

### Parameter attributes
attribute parameter_name, value string;

attribute default_value, value boolean;

## Entities

attribute running, value boolean;

entity ROSNode,
    owns node_name @key,
    owns namespace @card(0..1),
    owns start_time @card(0..1),
    owns end_time @card(0..1),
    owns running @card(0..1),
    plays has_interface:node @card(0..),
    plays has_parameter:node @card(0..),
    plays has_parameter_value:node @card(0..),
    plays node_deployment:node @card(0..1),
    plays process_group:node @card(0..),
    plays subnode:subnode @card(0..);

entity LifeCycleNode sub ROSNode,
    owns lifecycle_state @card(0..1);

### ROS interfaces
entity ROSInterface @abstract,
    owns interface_name @card(1),
    owns interface_type @card(1),
    plays has_interface:afferent @card(0..),
    plays has_interface:efferent @card(0..);

entity TopicInterface sub ROSInterface,
    owns gid @card(0..),
    plays has_qos:interface;
entity Subscriber sub TopicInterface,
    plays has_topic:subscriber @card(0..);
entity Publisher sub TopicInterface,
    plays has_topic:publisher @card(0..);

entity QoSProfile,
    owns reliability @card(0..1),
    owns history @card(0..1),
    owns depth @card(0..1),
    owns durability @card(0..1),
    owns deadline @card(0..1),
    owns lifespan @card(0..1),
    owns liveliness @card(0..1),
    owns lease_duration @card(0..1),
    plays has_qos:qos @card(0..);

entity ServiceInterface sub ROSInterface;
entity ServiceClient sub ServiceInterface,
    plays has_service:client @card(0..);
entity ServiceServer sub ServiceInterface,
    plays has_service:server @card(0..);

entity ActionInterface sub ROSInterface;
entity ActionClient sub ActionInterface,
    plays has_action:client @card(0..);
entity ActionServer sub ActionInterface,
    plays has_action:server @card(0..);

relation has_qos,
    relates interface @card(1),
    relates qos @card(1);

relation has_interface @abstract,
    relates node,
    relates afferent,
    relates efferent;

relation has_topic sub has_interface,
    relates subscriber as afferent,
    relates publisher as efferent;

relation has_service sub has_interface,
    relates client as afferent,
    relates server as efferent;

relation has_action sub has_interface,
    relates client as afferent,
    relates server as efferent;

#### Connection to context model
Publisher plays measurement_interface:source;
Publisher plays measurement_interface:output;
ServiceServer plays measurement_interface:source;
ActionServer plays measurement_interface:source;

### Parameter related entities
entity Parameter,
    owns parameter_name @card(1),
    plays has_parameter:parameter,
    plays has_parameter_value:parameter;

entity ParameterBool sub Parameter;
entity ParameterInteger sub Parameter;
entity ParameterDouble sub Parameter;
entity ParameterString sub Parameter;

entity ParameterBoolArray sub Parameter;
entity ParameterIntegerArray sub Parameter;
entity ParameterStringArray sub Parameter;
entity ParameterDoubleArray sub Parameter;

Value plays has_parameter_value:parameter_value;

## Relations
relation has_parameter,
    relates node @card(1),
    relates parameter @card(0..);

relation has_parameter_value,
    owns default_value @card(1),
    relates node @card(1),
    relates parameter @card(1),
    relates parameter_value @card(1);

relation node_deployment,
    owns package @card(1),
    owns executable @card(1),
    relates node @card(1);

relation process_group,
    relates node @card(0..);

relation subnode sub process_group,
    relates subnode @card(0..);


