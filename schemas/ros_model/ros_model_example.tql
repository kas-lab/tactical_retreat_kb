insert

## Define ROS nodes

### Mirte exemplar nodes
$mirte_bt_node isa LifeCycleNode,
	has node_name "mirte_bt",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $mirte_bt_node) isa node_deployment,
	has package "LifeCycleNode",
	has executable "mirte_bt";

### Nav2 nodes
$amcl_node isa LifeCycleNode,
	has node_name "amcl",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $amcl_node) isa node_deployment,
	has package "nav2_amcl",
	has executable "amcl";

$behavior_server_node isa LifeCycleNode,
	has node_name "behavior_server",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $behavior_server_node) isa node_deployment,
	has package "nav2_behaviors",
	has executable "behavior_server";

$bt_navigator_node isa LifeCycleNode,
	has node_name "bt_navigator",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $bt_navigator_node) isa node_deployment,
	has package "nav2_bt_navigator",
	has executable "bt_navigator";

$bt_navigator_navigate_through_poses_rclcpp_node isa ROSNode,
	has node_name "bt_navigator_navigate_through_poses_rclcpp",
	has namespace "",
	has start_time 2025-08-06T10:56:12.111;

$bt_navigator_navigate_to_pose_rclcpp_node isa ROSNode,
	has node_name "bt_navigator_navigate_to_pose_rclcpp",
	has namespace "",
	has start_time 2025-08-06T10:56:12.111;

(node: $bt_navigator_node,
	subnode: $bt_navigator_navigate_through_poses_rclcpp_node,
	subnode: $bt_navigator_navigate_to_pose_rclcpp_node) isa subnode;

$controller_server_node isa LifeCycleNode,
	has node_name "controller_server",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $controller_server_node) isa node_deployment,
	has package "nav2_controller",
	has executable "controller_server";

$map_server_node isa LifeCycleNode,
	has node_name "map_server",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $map_server_node) isa node_deployment,
	has package "nav2_map_server",
	has executable "nav2_map_server";


$planner_server_node isa LifeCycleNode,
	has node_name "planner_server",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $planner_server_node) isa node_deployment,
	has package "nav2_planner",
	has executable "planner_server";

$smoother_server_node isa LifeCycleNode,
	has node_name "smoother_server",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $smoother_server_node) isa node_deployment,
	has package "nav2_smoother",
	has executable "smoother_server";

$velocity_smoother_node isa LifeCycleNode,
	has node_name "velocity_smoother",
	has namespace "",
	has running true;
(node: $velocity_smoother_node) isa node_deployment,
	has package "nav2_velocity_smoother",
	has executable "velocity_smoother";

$relay_node isa ROSNode,
	has node_name "relay_node_cmd_vel",
	has namespace "",
	has start_time 2025-08-06T10:57:56.666;
(node: $relay_node) isa node_deployment,
	has package "topic_tools",
	has executable "relay";

## How to model these nodes?
# /controller_manager Where is this node launched from?
# /global_costmap/global_costmap [LifeCycle] Where is this node launched from?
# /local_costmap/local_costmap [LifeCycle] Where is this node launched from?

## Define parameters

### velocity_smoother_node parameters
$max_velocity_param isa ParameterDoubleArray,
	has parameter_name "max_velocity";

$odom_topic_param isa ParameterString,
	has parameter_name "odom_topic";

$odom_duration_param isa ParameterDouble,
	has parameter_name "odom_duration";

$velocity_smoother_parameters (
	node: $velocity_smoother_node,
	parameter:$max_velocity_param,
	parameter:$odom_topic_param,
	parameter:$odom_duration_param) isa has_parameter;

# define default parameters max_velocity
$default_max_velocity_x isa ValueDouble, has double_value 0.26;
$default_max_velocity_y isa ValueDouble, has double_value 0.0;
$default_max_velocity_z isa ValueDouble, has double_value 1.0;

$default_max_velocity_param_value isa ValueArray;
(array: $default_max_velocity_param_value,
array_value: $default_max_velocity_x)
	isa at_index, has index 0;
(array: $default_max_velocity_param_value,
array_value: $default_max_velocity_y)
	isa at_index, has index 1;
(array: $default_max_velocity_param_value,
array_value: $default_max_velocity_z)
	isa at_index, has index 2;

(node: $velocity_smoother_node,
parameter: $max_velocity_param,
parameter_value: $default_max_velocity_param_value)
	isa has_parameter_value, has default_value true;

# default param odom_topic
$default_odom_topic isa ValueString, has string_value "/odom";
(node: $velocity_smoother_node,
parameter: $odom_topic_param,
parameter_value: $default_odom_topic)
	isa has_parameter_value, has default_value true;

# default odom duration
$default_odom_duration isa ValueDouble, has double_value 1.0;
(node: $velocity_smoother_node,
parameter: $odom_duration_param,
parameter_value: $default_odom_duration)
	isa has_parameter_value, has default_value true;

## Define ROS services

### set_initial_pose service
$amcl_init_pose_server isa ServiceServer,
	has interface_name "/set_initial_pose",
	has interface_type "nav2_msgs/srv/SetInitialPose";
(node: $amcl_node, server: $amcl_init_pose_server) isa has_service;

$mirte_bt_init_pose_client isa ServiceClient,
	has interface_name "/set_initial_pose",
	has interface_type "nav2_msgs/srv/SetInitialPose";
(node: $mirte_bt_node, client: $mirte_bt_init_pose_client) isa has_service;

## Define ROS actions

### navigate_to_pose action
$bt_navigator_navigate_to_pose_server isa ActionServer,
	has interface_name "/navigate_to_pose",
	has interface_type "nav2_msgs/action/NavigateToPose";
(node: $bt_navigator_node, server: $bt_navigator_navigate_to_pose_server) isa has_action;

$bt_navigator_navigate_to_pose_client isa ActionClient,
	has interface_name "/navigate_to_pose",
	has interface_type "nav2_msgs/action/NavigateToPose";
(node: $bt_navigator_node, client: $bt_navigator_navigate_to_pose_client) isa has_action;

$mirte_bt_navigate_to_pose_client isa ActionClient,
	has interface_name "/navigate_to_pose",
	has interface_type "nav2_msgs/action/NavigateToPose";
(node: $mirte_bt_node, client: $mirte_bt_navigate_to_pose_client) isa has_action;

### compute_path_to_pose action
$planner_server_compute_path_to_pose_server isa ActionServer,
	has interface_name "/compute_path_to_pose",
	has interface_type "nav2_msgs/action/ComputePathToPose";
(node: $planner_server_node, server: $planner_server_compute_path_to_pose_server) isa has_action;

$bt_navigator_compute_path_to_pose_client isa ActionClient,
	has interface_name "/compute_path_to_pose",
	has interface_type "nav2_msgs/action/ComputePathToPose";
(node: $bt_navigator_navigate_to_pose_rclcpp_node, client: $bt_navigator_compute_path_to_pose_client) isa has_action;

### follow_path action
$controller_server_follow_path_server isa ActionServer,
	has interface_name "/follow_path",
	has interface_type "nav2_msgs/action/FollowPath";
(node: $controller_server_node, server: $controller_server_follow_path_server) isa has_action;

$bt_navigator_navigate_to_pose_follow_path_client isa ActionClient,
	has interface_name "/follow_path",
	has interface_type "nav2_msgs/action/FollowPath";
(node: $bt_navigator_navigate_to_pose_rclcpp_node, client: $bt_navigator_navigate_to_pose_follow_path_client) isa has_action;

$bt_navigator_navigate_through_poses_follow_path_client isa ActionClient,
	has interface_name "/follow_path",
	has interface_type "nav2_msgs/action/FollowPath";
(node: $bt_navigator_navigate_through_poses_rclcpp_node, client: $bt_navigator_navigate_through_poses_follow_path_client) isa has_action;

## Define ROS topics

$cmd_vel_qos isa QoSProfile,
	has reliability "RELIABLE",
	has history "KEEP_LAST",
	has depth 10,
	has durability "VOLATILE",
	has lifespan 0,
	has deadline 0,
	has liveliness "AUTOMATIC",
	has lease_duration 0;

### cmd_vel topic
$velocity_smoother_cmd_vel_pub isa Publisher,
	has interface_name "/cmd_vel",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $velocity_smoother_cmd_vel_pub, qos: $cmd_vel_qos) isa has_qos;
(node: $velocity_smoother_node, publisher: $velocity_smoother_cmd_vel_pub) isa has_topic;

$behavior_server_cmd_vel_sub isa Subscriber,
	has interface_name "/cmd_vel",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $behavior_server_cmd_vel_sub, qos: $cmd_vel_qos) isa has_qos;
(node: $behavior_server_node, subscriber: $behavior_server_cmd_vel_sub) isa has_topic;

$relay_node_cmd_vel_sub isa Subscriber,
	has interface_name "/cmd_vel",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $relay_node_cmd_vel_sub, qos: $cmd_vel_qos) isa has_qos;
(node: $relay_node, subscriber: $relay_node_cmd_vel_sub) isa has_topic;

### cmd_vel_nav topic
$controller_server_cmd_vel_nav_pub isa Publisher,
	has interface_name "/cmd_vel_nav",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $controller_server_cmd_vel_nav_pub, qos: $cmd_vel_qos) isa has_qos;
(node: $controller_server_node, publisher: $controller_server_cmd_vel_nav_pub) isa has_topic;

$velocity_smoother_cmd_vel_nav_sub isa Subscriber,
	has interface_name "/cmd_vel_nav",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $velocity_smoother_cmd_vel_nav_sub, qos: $cmd_vel_qos) isa has_qos;
(node: $velocity_smoother_node, subscriber: $velocity_smoother_cmd_vel_nav_sub) isa has_topic;


## bt_navigator node (from generated.tql)

$bt_navigator_node_sub isa Subscriber,
has interface_name "goal_pose",
has interface_type "geometry_msgs/PoseStamped";
(node: $bt_navigator_node, subscriber: $bt_navigator_node_sub) isa has_topic;

$bt_navigator_node_sub_1 isa Subscriber,
has interface_name "odom",
has interface_type "nav_msgs/Odometry";
(node: $bt_navigator_node, subscriber: $bt_navigator_node_sub_1) isa has_topic;

$bt_navigator_node_sub_2 isa Subscriber,
has interface_name "tf",
has interface_type "tf2_msgs/TFMessage";
(node: $bt_navigator_node, subscriber: $bt_navigator_node_sub_2) isa has_topic;

$bt_navigator_node_sub_3 isa Subscriber,
has interface_name "tf_static",
has interface_type "tf2_msgs/TFMessage";
(node: $bt_navigator_node, subscriber: $bt_navigator_node_sub_3) isa has_topic;

$bt_navigator_node_pub isa Publisher,
has interface_name "~/transition_event",
has interface_type "lifecycle_msgs/TransitionEvent";
(node: $bt_navigator_node, publisher: $bt_navigator_node_pub) isa has_topic;

$bt_navigator_node_service_server isa ServiceServer,
has interface_name "~/change_state",
has interface_type "lifecycle_msgs/ChangeState";
(node: $bt_navigator_node, server: $bt_navigator_node_service_server) isa has_service;

$bt_navigator_node_service_server_1 isa ServiceServer,
has interface_name "~/get_available_states",
has interface_type "lifecycle_msgs/GetAvailableStates";
(node: $bt_navigator_node, server: $bt_navigator_node_service_server_1) isa has_service;

$bt_navigator_node_service_server_2 isa ServiceServer,
has interface_name "~/get_available_transitions",
has interface_type "lifecycle_msgs/GetAvailableTransitions";
(node: $bt_navigator_node, server: $bt_navigator_node_service_server_2) isa has_service;

$bt_navigator_node_service_server_3 isa ServiceServer,
has interface_name "~/get_state",
has interface_type "lifecycle_msgs/GetState";
(node: $bt_navigator_node, server: $bt_navigator_node_service_server_3) isa has_service;

$bt_navigator_node_service_server_4 isa ServiceServer,
has interface_name "~/get_transition_graph",
has interface_type "lifecycle_msgs/GetAvailableTransitions";
(node: $bt_navigator_node, server: $bt_navigator_node_service_server_4) isa has_service;