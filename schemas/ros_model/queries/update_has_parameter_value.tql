match

$velocity_smoother_node isa LifeCycleNode,
    has node_name "velocity_smoother";
$max_velocity_param isa ParameterDoubleArray,
    has parameter_name "max_velocity";
$max_velocity_has_param_value (node: $velocity_smoother,
    parameter: $max_velocity_param)
    isa has_parameter_value;

delete $max_velocity_has_param_value isa has_parameter_value;

insert

# define default parameters max_velocity
$medium_max_velocity_x isa ValueSingleton, has double_value 0.18;
$medium_max_velocity_y isa ValueSingleton, has double_value 0.0;
$medium_max_velocity_z isa ValueSingleton, has double_value 1.0;

$medium_max_velocity_param_value isa ValueArray;
(array: $medium_max_velocity_param_value, array_value: $medium_max_velocity_x)
    isa at_index, has index 0;
(array: $medium_max_velocity_param_value, array_value: $medium_max_velocity_y)
    isa at_index, has index 1;
(array: $medium_max_velocity_param_value, array_value: $medium_max_velocity_z)
    isa at_index, has index 2;

(node: $velocity_smoother, parameter: $max_velocity_param,
    parameter_value: $medium_max_velocity_param_value)
    isa has_parameter_value;
