define

entity Value @abstract,
    plays at_index:array_value;

attribute bool_value, value boolean;
attribute integer_value, value integer;
attribute double_value, value double;
attribute string_value, value string;

entity ValueSingleton, sub Value;
entity ValueBool, sub ValueSingleton,
    owns bool_value;
entity ValueInteger, sub ValueSingleton,
    owns integer_value;
entity ValueDouble, sub ValueSingleton,
    owns double_value;
entity ValueString, sub ValueSingleton,
    owns string_value;

entity ValueArray, sub Value,
    plays at_index:array;

attribute index, value integer;
relation at_index,
    owns index,
    relates array,
    relates array_value;


