define

entity Value @abstract,
    plays at_index:array_value;

attribute bool_value, value boolean;
attribute integer_value, value integer;
attribute double_value, value double;
attribute string_value, value string;

entity ValueSingleton extends Value;
entity ValueBool extends ValueSingleton,
    owns bool_value;
entity ValueInteger extends ValueSingleton,
    owns integer_value;
entity ValueDouble extends ValueSingleton,
    owns double_value;
entity ValueString extends ValueSingleton,
    owns string_value;

entity ValueArray extends Value,
    plays at_index:array;

attribute index, value integer;
relation at_index,
    owns index,
    relates array,
    relates array_value;


