define

attribute measure_name, value string;
attribute description, value string;

attribute measurement_time, value datetime;

attribute latest, value boolean;

entity Measure,
    owns measure_name @key,
    owns description,
    plays measurement:measure,
    plays measurement_interface:measure;


relation measurement,
    owns measurement_time @card(1),
    owns latest @card(0..1),
    relates measure @card(1),
    relates measurement_value @card(1);

### connection with data structure model
Value plays measurement:measurement_value;

attribute measurement_function_name, value string;
attribute measurement_function_lib, value string;
attribute measurement_function_args, value string;
attribute measurement_proxy, value boolean;
attribute measurement_period, value integer;
attribute service_request_kwargs, value string;

relation measurement_interface,
    owns measurement_function_name @card(1),
    owns measurement_function_lib @card(0..1),
    owns measurement_function_args @card(0..),
    owns measurement_proxy @card(0..1),
    owns measurement_period @card(0..1),
    owns service_request_kwargs @card(0..),
    relates measure @card(1),
    relates source @card(1),
    relates output @card(0..1);