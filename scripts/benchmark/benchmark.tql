## Define ROS topics

$cmd_vel_qos isa QoSProfile,
	has reliability "RELIABLE",
	has history "KEEP_LAST",
	has depth 10,
	has durability "VOLATILE",
	has lifespan 0,
	has deadline 0,
	has liveliness "AUTOMATIC",
	has lease_duration 0;

### cmd_vel topic
$velocity_smoother_cmd_vel_pub isa Publisher,
	has interface_name "/cmd_vel",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $velocity_smoother_cmd_vel_pub, qos: $cmd_vel_qos) isa has_qos;
(node: $velocity_smoother_node, publisher: $velocity_smoother_cmd_vel_pub) isa has_topic;

$behavior_server_cmd_vel_sub isa Subscriber,
	has interface_name "/cmd_vel",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $behavior_server_cmd_vel_sub, qos: $cmd_vel_qos) isa has_qos;
(node: $behavior_server_node, subscriber: $behavior_server_cmd_vel_sub) isa has_topic;

$relay_node_cmd_vel_sub isa Subscriber,
	has interface_name "/cmd_vel",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $relay_node_cmd_vel_sub, qos: $cmd_vel_qos) isa has_qos;
(node: $relay_node, subscriber: $relay_node_cmd_vel_sub) isa has_topic;

### cmd_vel_nav topic
$controller_server_cmd_vel_nav_pub isa Publisher,
	has interface_name "/cmd_vel_nav",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $controller_server_cmd_vel_nav_pub, qos: $cmd_vel_qos) isa has_qos;
(node: $controller_server_node, publisher: $controller_server_cmd_vel_nav_pub) isa has_topic;

$velocity_smoother_cmd_vel_nav_sub isa Subscriber,
	has interface_name "/cmd_vel_nav",
	has interface_type "geometry_msgs/msg/Twist";
(interface: $velocity_smoother_cmd_vel_nav_sub, qos: $cmd_vel_qos) isa has_qos;
(node: $velocity_smoother_node, subscriber: $velocity_smoother_cmd_vel_nav_sub) isa has_topic;


## bt_navigator node (from generated.tql)

$bt_navigator_node_sub isa Subscriber,
has interface_name "goal_pose",
has interface_type "geometry_msgs/PoseStamped";
(node: $bt_navigator_node, subscriber: $bt_navigator_node_sub) isa has_topic;

$bt_navigator_node_sub_1 isa Subscriber,
has interface_name "odom",
has interface_type "nav_msgs/Odometry";
(node: $bt_navigator_node, subscriber: $bt_navigator_node_sub_1) isa has_topic;

$bt_navigator_node_sub_2 isa Subscriber,
has interface_name "tf",
has interface_type "tf2_msgs/TFMessage";
(node: $bt_navigator_node, subscriber: $bt_navigator_node_sub_2) isa has_topic;

$bt_navigator_node_sub_3 isa Subscriber,
has interface_name "tf_static",
has interface_type "tf2_msgs/TFMessage";
(node: $bt_navigator_node, subscriber: $bt_navigator_node_sub_3) isa has_topic;

$bt_navigator_node_pub isa Publisher,
has interface_name "~/transition_event",
has interface_type "lifecycle_msgs/TransitionEvent";
(node: $bt_navigator_node, publisher: $bt_navigator_node_pub) isa has_topic;

$bt_navigator_node_service_server isa ServiceServer,
has interface_name "~/change_state",
has interface_type "lifecycle_msgs/ChangeState";
(node: $bt_navigator_node, server: $bt_navigator_node_service_server) isa has_service;

