# Add 10 benchmark ROS node/interface families for action/subnode/topic fetch combinations.
$bench_node_01 isa ROSNode,
    has node_name "bench_node_01",
    has namespace "",
    has running true;

$bench_subnode_01 isa ROSNode,
    has node_name "bench_node_01_sub",
    has namespace "",
    has running true;

(node: $bench_node_01, subnode: $bench_subnode_01) isa subnode;

$bench_action_client_01 isa ActionClient,
    has interface_name "/bench_action_01",
    has interface_type "nav2_msgs/action/NavigateToPose";

(node: $bench_node_01, client: $bench_action_client_01) isa has_action;

$bench_action_server_01 isa ActionServer,
    has interface_name "/bench_action_01",
    has interface_type "nav2_msgs/action/NavigateToPose";

(node: $bench_host_node, server: $bench_action_server_01) isa has_action;

$bench_publisher_01 isa Publisher,
    has interface_name "/bench_topic_01",
    has interface_type "std_msgs/msg/String";

(node: $bench_node_01, publisher: $bench_publisher_01) isa has_topic;
(interface: $bench_publisher_01, qos: $bench_qos_profile) isa has_qos;

$bench_subscriber_01 isa Subscriber,
    has interface_name "/bench_topic_01",
    has interface_type "std_msgs/msg/String";

(node: $bench_host_node, subscriber: $bench_subscriber_01) isa has_topic;

$bench_measure_01 isa Measure,
    has measure_name "bench_measure_01";

(measure: $bench_measure_01, measurement_value: $double_0_10) isa measurement,
    has measurement_time 2025-09-06T12:57:56.666,
    has latest true;

(measure: $bench_measure_01, source: $bench_publisher_01) isa measurement_interface,
    has measurement_function_name "bench_measure_fn_01",
    has measurement_function_lib "bench_measure_lib",
    has measurement_function_args "bench_measure_args_01";

