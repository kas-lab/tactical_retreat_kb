(node: $bt_navigator_node, server: $bt_navigator_node_service_server_4) isa has_service;

# Stage 1: match velocity_smoother_node, insert all safe entities/relations
# and all anonymous leaf relations (no var used as both creator and role player).
# match

# $velocity_smoother_node isa LifeCycleNode,
# 	has node_name "velocity_smoother";

# insert

# context model
$nearest_object_measure isa Measure, has measure_name "nearest_object_measure"; # meter
$movement_power_measure isa Measure, has measure_name "movement_power_measure"; # watt?
$current_linear_velocity_measure isa Measure, has measure_name "current_linear_velocity_measure"; # m/s

$mvalueonine isa  ValueSingleton,
    has double_value 0.09;

## example measurement
(measure: $nearest_object_measure, measurement_value:$mvalueonine) isa measurement,
        has measurement_time 2025-09-06T12:57:56.666, has latest true;

$current_mv_pwer isa ValueSingleton, has double_value 0.3;
(measure:$movement_power_measure , measurement_value: $current_mv_pwer) isa measurement,
	has measurement_time 2025-08-06T10:57:56.666, has latest true;

$current_vel isa ValueSingleton, has double_value 0.22221;
(measure:$current_linear_velocity_measure , measurement_value: $current_vel) isa measurement,
	has measurement_time 2025-08-06T10:57:56.666, has latest true;

## Nearest object
$scan_filtered_pub isa Publisher,
	has interface_name '/scan_filtered',
    	has interface_type 'sensor_msgs/msg/LaserScan';
$sensor_qos isa QoSProfile,
	has reliability 'BEST_EFFORT',
	has history 'KEEP_LAST',
	has depth 5,
	has durability 'VOLATILE',
	has lifespan 0,
	has deadline 0,
	has liveliness 'SYSTEM_DEFAULT',
	has lease_duration 0;

$nearest_object_pub isa Publisher,
	has interface_name '/nearest_object',
	has interface_type 'std_msgs/msg/Float32';


(interface: $scan_filtered_pub, qos: $sensor_qos) isa has_qos;

(measure: $nearest_object_measure, source: $scan_filtered_pub, output: $nearest_object_pub) isa measurement_interface,
    has measurement_function_name 'get_nearest_scan_distance_in_base',
    has measurement_function_lib 'ros_monitors.laser_scan_functions',
    has measurement_function_args 'base_link';

# define Feature Model
$f_max_speed isa Feature, has feature_name "MAX_SPEED";
$f_low_speed isa Feature, has feature_name "LOW_SPEED";
$f_hi_speed isa Feature, has feature_name "HIGH_SPEED";
$f_med_speed isa Feature, has feature_name "MED_SPEED";
$alternative isa alternative,
    links (parent: $f_max_speed, child: $f_low_speed, child: $f_med_speed, child: $f_hi_speed);

$fa_low_speed isa feature_adaptation,
    links (activation: $f_low_speed);
$fa_med_speed isa feature_adaptation,
    links (activation: $f_med_speed);
$fa_hi_speed isa feature_adaptation,
    links (activation: $f_hi_speed);

# define MaxSpeedInternal Tactic
$ta_max_speed isa Tactic, has tactic_name "MaxSpeedInternal";

# nearest_object < 0.1
$litdouble isa ValueSingleton,
    has double_value 0.1;

$litdoublefoury isa ValueSingleton,
    has double_value 40.0;

$litdoublefifteen isa ValueSingleton,
    has double_value 0.15;

$litdoublethreenine isa ValueSingleton,
    has double_value 39.0;

# anonymous leaf expressions (identified by expression_name for later stages)
$ineq_nearest_lower_than_10 isa less_than,
    links (lhs_value: $nearest_object_measure, rhs_value: $litdouble),
    has expression_name 'ineq_nearest_lower_than_10';
# movement power > 40.0
$ineq_mv_pwer_greater_than_40 isa greater_than,
    links (lhs_value: $movement_power_measure, rhs_value: $litdoublefoury),
    has expression_name 'ineq_mv_pwer_greater_than_40';
# nearest_object > 0.15  (anonymous, identified by expression_name)
$ineq_nearest_greater_than_15 isa greater_than,
    links (lhs_value: $nearest_object_measure, rhs_value: $litdoublefifteen),
    has expression_name 'ineq_nearest_greater_than_15';
# movement power < 39.0  (anonymous, identified by expression_name)
$ineq_mv_pwer_lower_than_39 isa less_than,
    links (lhs_value: $movement_power_measure, rhs_value: $litdoublethreenine),
    has expression_name 'ineq_mv_pwer_lower_than_39';

### tactic rules effects (anonymous — identified by measure_name + effect_value)
$double_0_05 isa ValueSingleton,
    has double_value 0.05;
$double_0_07 isa ValueSingleton,
    has double_value 0.07;
$double_0_10 isa ValueSingleton,
    has double_value 0.10;
$eff_mp_005 isa relative_effect,
    links (measure: $movement_power_measure, effect_value: $double_0_05);
$eff_mp_007 isa relative_effect,
    links (measure: $movement_power_measure, effect_value: $double_0_07);
$eff_mp_010 isa relative_effect,
    links (measure: $movement_power_measure, effect_value: $double_0_10);

# define parameter max_speed
$p_max_speed isa ParameterDoubleArray, has parameter_name "max_velocity";

# define parameter values low
$p_max_velocity_x_low isa ValueSingleton, has double_value 0.10;
$p_max_velocity_y_low isa ValueSingleton, has double_value 0.0;
$p_max_velocity_z_low isa ValueSingleton, has double_value 1.0;
# define parameter array low
$p_max_speed_low_array isa ValueArray;
(array: $p_max_speed_low_array, array_value: $p_max_velocity_x_low) isa at_index, has index 0;
(array: $p_max_speed_low_array, array_value: $p_max_velocity_y_low) isa at_index, has index 1;
(array: $p_max_speed_low_array, array_value: $p_max_velocity_z_low) isa at_index, has index 2;

# define parameter values med
$p_max_velocity_x_med isa ValueSingleton, has double_value 0.18;
$p_max_velocity_y_med isa ValueSingleton, has double_value 0.0;
$p_max_velocity_z_med isa ValueSingleton, has double_value 1.0;
# define parameter array med
$p_max_speed_med_array isa ValueArray;
(array: $p_max_speed_med_array, array_value: $p_max_velocity_x_med) isa at_index, has index 0;
(array: $p_max_speed_med_array, array_value: $p_max_velocity_y_med) isa at_index, has index 1;
(array: $p_max_speed_med_array, array_value: $p_max_velocity_z_med) isa at_index, has index 2;

# define parameter values high
$p_max_velocity_x_high isa ValueSingleton, has double_value 0.26;
$p_max_velocity_y_high isa ValueSingleton, has double_value 0.0;
$p_max_velocity_z_high isa ValueSingleton, has double_value 1.0;
# define parameter array high
$p_max_speed_high_array isa ValueArray;
(array: $p_max_speed_high_array, array_value: $p_max_velocity_x_high) isa at_index, has index 0;
(array: $p_max_speed_high_array, array_value: $p_max_velocity_y_high) isa at_index, has index 1;
(array: $p_max_speed_high_array, array_value: $p_max_velocity_z_high) isa at_index, has index 2;

# anonymous absolute_effects for linear velocity (identified by measure_name + effect_value)
$eff_vel_x_low isa absolute_effect,
    links (measure: $current_linear_velocity_measure, effect_value: $p_max_velocity_x_low);
$eff_vel_x_med isa absolute_effect,
    links (measure: $current_linear_velocity_measure, effect_value: $p_max_velocity_x_med);
$eff_vel_x_high isa absolute_effect,
    links (measure: $current_linear_velocity_measure, effect_value: $p_max_velocity_x_high);

# anonymous set_nodes_parameters (identified by node + parameter + array's first element value)
$set_nodes_params_low isa set_nodes_parameters,
    links (node: $velocity_smoother_node, parameter: $p_max_speed, parameter_value: $p_max_speed_low_array);
$set_nodes_params_med isa set_nodes_parameters,
    links (node: $velocity_smoother_node, parameter: $p_max_speed, parameter_value: $p_max_speed_med_array);
$set_nodes_params_high isa set_nodes_parameters,
    links (node: $velocity_smoother_node, parameter: $p_max_speed, parameter_value: $p_max_speed_high_array);

# Stage 2: match+insert or_expression
$or_rebetmc isa or_expression,
    links (expression: $ineq_nearest_lower_than_10, expression: $ineq_mv_pwer_greater_than_40),
    has expression_name 'rebetmc_or_expression';

# Stage 3: match+insert and_expression
$and_rebetmc isa and_expression,
    links (expression: $ineq_nearest_greater_than_15, expression: $ineq_mv_pwer_lower_than_39),
    has expression_name 'rebetmc_and_expression';

# Stage 4a: match+insert tactic_rule MIN
$tr_min isa tactic_rule,
    links (tactic: $ta_max_speed, antecedent: $or_rebetmc, consequent: $fa_low_speed, effect: $eff_mp_005, effect: $eff_vel_x_low),
    has rule_name "MIN";

# Stage 4b: match+tactic_rule MED
$tr_med isa tactic_rule,
    links (tactic: $ta_max_speed, antecedent: $ineq_nearest_greater_than_15, consequent: $fa_med_speed, effect: $eff_mp_007, effect: $eff_vel_x_med),
    has rule_name "MED";

# Stage 4c: match+tactic_rule MAX
$tr_max isa tactic_rule,
    links (tactic: $ta_max_speed, antecedent: $and_rebetmc, consequent: $fa_hi_speed, effect: $eff_mp_010, effect: $eff_vel_x_high),
    has rule_name "MAX";

# Stage 5a: match+variant_activation for LOW_SPEED
$vr_low isa variant_activation,
    links (resolution_action: $set_nodes_params_low, variant: $f_low_speed);

# Stage 5b: match+variant_activation for MED_SPEED
$vr_med isa variant_activation,
    links (resolution_action: $set_nodes_params_med, variant: $f_med_speed);

# Stage 5c: match+variant_activation for HIGH_SPEED
$vr_high isa variant_activation,
    links (resolution_action: $set_nodes_params_high, variant: $f_hi_speed);

# Stage 6: match+resolution_model
$res_model isa resolution_model,
    links (tactic: $ta_max_speed, variant_resolution: $vr_low, variant_resolution: $vr_med, variant_resolution: $vr_high),
    has resolution_model_name "rebetmc", has ros_system "nav2";

# match

# $nearest_object_measure isa Measure,
# 	has measure_name "nearest_object_measure";

# $movement_power_measure isa Measure,
# 	has measure_name "movement_power_measure";

# $current_linear_velocity_measure isa Measure,
# 	has measure_name "current_linear_velocity_measure";

# insert

## Examples Mirte's MVP use case
$mirte isa System, has system_name "Mirte";

## Measures + measurements

$double_0_18 isa ValueSingleton,
    has double_value 0.18;

## Layer 1: leaf relations (anonymous), entities, and value objects

# object is too close if nearest_object < 0.18
# with current measurement 0.10 -> 0.10 < 0.18 -> true
$objects_close_measure_expr isa less_than,
    links (lhs_value: $nearest_object_measure, rhs_value: $double_0_18),
    has expression_name "objects_close_measure_expr";

# R1.1 Velocity

$velocity_set isa FuzzyTriangular,
	has a -0.5,
	has b 0.0,
	has c 0.5;

$velocity_as_close_expression isa as_close_as_possible_expression,
    links (fuzzy_set: $velocity_set, term: $current_linear_velocity_measure),
    has required_value 0.26,
    has expression_name "velocity_as_close_expression";

## R1.2 Velocity with obstacles

# tactic MIN -> vel = 0.10, mv_pwr = 0.05 -> 0.84
# tactic MED -> vel = 0.18, mv_pwr = 0.07 -> 1.0
# tactic MAX -> vel = 0.26, mv_pwr = 0.10 -> 0.84
$velocity_as_close_expression_2 isa as_close_as_possible_expression,
    links (fuzzy_set: $velocity_set, term: $current_linear_velocity_measure),
    has required_value 0.18,
    has expression_name 'velocity_as_close_expression_2';

# fake mirte requirement
$mv_pwr_fuzzy_set isa FuzzyExponentialDecay,
	has exponent 0.2;

$as_few_mv_pwr_as_possible isa as_few_as_possible_expression,
    links (fuzzy_set: $mv_pwr_fuzzy_set, term: $movement_power_measure),
    has expression_name "as_few_mv_pwr_as_possible";

## Layer 2: relations that depend on Layer 1 (fetched via match)

# not true -> false
$not_objects_close_exp isa not_expression,
    links (expression: $objects_close_measure_expr),
    has expression_name "not_objects_close_exp";

# R1.1 Velocity shall expression
$velocity_shall_expression isa shall_expression,
    links (expression: $velocity_as_close_expression),
    has expression_name 'velocity_shall_expression';  # used for tests only

# R1.2 as_few shall expression
$mv_pwr_shall_expression isa shall_expression,
    links (expression: $as_few_mv_pwr_as_possible),
    has expression_name "mv_pwr_shall_expression";

## Layer 3: relations that depend on Layer 2

# tactic MIN -> 0.0 or 0.84 -> 0.84
# tactic MED -> 0.0 or 1.0  -> 1.0
# tactic MAX -> 0.0 or 0.84 -> 0.84
$not_objects_or_velocity isa fuzzy_or,
    links (expression: $not_objects_close_exp, expression: $velocity_as_close_expression_2),
    has expression_name "not_objects_or_velocity";

## Layer 4: relations that depend on Layer 3

# tactic MIN -> 0.84
# tactic MED -> 1.0
# tactic MAX -> 0.84
$velocity_shall_expression_2 isa shall_expression,
    links (expression: $not_objects_or_velocity),
    has expression_name 'velocity_shall_expression_2';  # used for tests only

## Layer 5: relaxed_requirements (depend on shall_expressions + mirte)

# expected fulfillment 0.92442
$req_r1_1 isa relaxed_requirement,
    links (system: $mirte, expression: $velocity_shall_expression),
    has requirement_name "R1.1 Velocity",
    has in_effect true,
    has description "The robot SHALL maintain its velocity AS CLOSE AS POSSIBLE TO 0.26 m/s.";

# expected fulfillment max(1- 1.0, m(0.22221 - 0.18)  ) = max(0.0, 0.91558) = 0.91558
# tactic MIN -> 0.84
# tactic MED -> 1.0
# tactic MAX -> 0.84
$req_r1_2 isa relaxed_requirement,
    links (system: $mirte, expression: $velocity_shall_expression_2),
    has requirement_name "R1.2 Velocity with obstacles",
    has in_effect true,
    has description "The robot SHALL, when objects are too close, bring its velocity AS CLOSE AS POSSIBLE TO 0.18 m/s";

# fake mirte requirement
$req_r1_3 isa relaxed_requirement,
    links (system: $mirte, expression: $mv_pwr_shall_expression),
    has requirement_name "R1.3 Movement Power",
    has in_effect true,
    has description "The robot SHALL maintain its movement power AS FEW AS POSSIBLE.";

$benchmark_out_of_effect_requirement isa relaxed_requirement,
    links (system: $mirte, expression: $velocity_shall_expression),
    has requirement_name "Benchmark Out Of Effect",
    has in_effect false,
    has description "Benchmark-only requirement that stays out of effect.";

# BEGIN BENCHMARK COMBO EXPANSION

# Shared host and QoS profile for benchmark-only ROS interfaces.
$bench_host_node isa ROSNode,
    has node_name "bench_host_node",
    has namespace "",
    has running true;

$bench_qos_profile isa QoSProfile,
    has reliability "RELIABLE",
    has history "KEEP_LAST",
    has depth 10,
    has durability "VOLATILE";

# Add extra resolution models so fetch_tactics/fetch_resolution_model_tactic_rule_targets
# have at least 10 valid model inputs.
$bench_res_model_1 isa resolution_model,
    links (tactic: $ta_max_speed,
           variant_resolution: $vr_low,
           variant_resolution: $vr_med,
           variant_resolution: $vr_high),
    has resolution_model_name "bench_rebetmc_1",
    has ros_system "nav2";

$bench_res_model_2 isa resolution_model,
    links (tactic: $ta_max_speed,
