 	has parameter_name "use_sim_time";
 $use_sim_time_param_pvalue isa ValueBool, has bool_value true;
 (node: $map_server_node,
 parameter: $use_sim_time_param,
 parameter_value: $use_sim_time_param_pvalue)
 	isa has_parameter_value, has default_value true;
 $yaml_filename_param isa ParameterString,
 	has parameter_name "yaml_filename";
 $yaml_filename_param_pvalue isa ValueString, has string_value "/home/ega/rebet_ws/install/rebet_frog/share/rebet_frog/config/acsos2024_map.yaml";
 (node: $map_server_node,
 parameter: $yaml_filename_param,
 parameter_value: $yaml_filename_param_pvalue)
 	isa has_parameter_value, has default_value true;

 $map_server_node_parameters (
 	node: $map_server_node,
 	parameter: $bond_disable_heartbeat_timeout_param,
 	parameter: $frame_id_param,
 	parameter: $topic_name_param,
 	parameter: $use_sim_time_param,
 	parameter: $yaml_filename_param
 	) isa has_parameter;
 $map_server_node_sub isa Subscriber,
 has interface_name "bond",
 has interface_type "bond/Status";

 (node: $map_server_node, subscriber: $map_server_node_sub) isa has_topic;

 $map_server_node_sub_1 isa Subscriber,
 has interface_name "clock",
 has interface_type "rosgraph_msgs/Clock";

 (node: $map_server_node, subscriber: $map_server_node_sub_1) isa has_topic;

 $map_server_nodepub isa Publisher,
 has interface_name "bond",
 has interface_type "bond/Status";

 $map_server_nodepub_qos isa QoSProfile,
     	   	has reliability "RELIABLE",
     	   	has history "KEEP_ALL",
     	   	has durability "VOLATILE"
 ;

 $map_server_nodepub_qos_rel (interface: $map_server_nodepub, qos: $map_server_nodepub_qos) isa has_qos;

 (node: $map_server_node, publisher: $map_server_nodepub) isa has_topic;
 $map_server_nodepub_1 isa Publisher,
 has interface_name "map",
 has interface_type "nav_msgs/OccupancyGrid";

 $map_server_nodepub_1_qos isa QoSProfile,
     	   	has reliability "RELIABLE",
     	   	has history "KEEP_ALL",
     	   	has durability "TRANSIENT_LOCAL"
 ;

 $map_server_nodepub_1_qos_rel (interface: $map_server_nodepub_1, qos: $map_server_nodepub_1_qos) isa has_qos;

 (node: $map_server_node, publisher: $map_server_nodepub_1) isa has_topic;
 $map_server_nodepub_2 isa Publisher,
 has interface_name "map_server/transition_event",
 has interface_type "lifecycle_msgs/TransitionEvent";

 $map_server_nodepub_2_qos isa QoSProfile,
     	   	has reliability "RELIABLE",
     	   	has history "KEEP_ALL",
     	   	has durability "VOLATILE"
 ;

 $map_server_nodepub_2_qos_rel (interface: $map_server_nodepub_2, qos: $map_server_nodepub_2_qos) isa has_qos;

 (node: $map_server_node, publisher: $map_server_nodepub_2) isa has_topic;
