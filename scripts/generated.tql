 $map_server_node isa LifeCycleNode,
 has node_name "/map_server",
 has namespace "";
 $bond_disable_heartbeat_timeout_param isa ParameterBool,
 	has parameter_name "/bond_disable_heartbeat_timeout";
 $bond_disable_heartbeat_timeout_param_pvalue isa ValueBool, has bool_value true;
 (node: $map_server_node,
 parameter: $bond_disable_heartbeat_timeout_param,
 parameter_value: $bond_disable_heartbeat_timeout_param_pvalue)
 	isa has_parameter_value, has default_value true;
