 has interface_type "lifecycle_msgs/GetState";
 (node: $detect_object_node, server: $detect_object_node_service_server_3) isa has_service;
 $detect_object_node_service_server_4 isa ServiceServer,
 has interface_name "detect_object/get_transition_graph",
 has interface_type "lifecycle_msgs/GetAvailableTransitions";
 (node: $detect_object_node, server: $detect_object_node_service_server_4) isa has_service;
 $detect_object_node_service_server_5 isa ServiceServer,
 has interface_name "detect_object_srv",
 has interface_type "rebet_msgs/DetectObject";
 (node: $detect_object_node, server: $detect_object_node_service_server_5) isa has_service;

 $ta_frogmaxspeed isa Tactic, has tactic_name "FROGMaxSpeed";

 # define Feature Model
 $f_low_speed isa Feature, has feature_name "LOW_SPEED", has mandatory false;
 $f_med_speed isa Feature, has feature_name "MED_SPEED", has mandatory false;
 $f_hi_speed isa Feature, has feature_name "HI_SPEED", has mandatory false;


 $t_measured_nearest_object isa Measure, has measure_name "nearest_object";

 (measure: $t_measured_nearest_object, source: $turtlebot3_laserscan_nodepub) isa measurement_interface,
 	    has measurement_function_name 'get_nearest_laser_scan_ratio';
 $t_measured_too_close isa Measure, has measure_name "too_close";

 (measure: $t_measured_too_close, source: $turtlebot3_laserscan_nodepub) isa measurement_interface,
 	    has measurement_function_name 'is_too_close';
 $t_measured_current_velocity isa Measure, has measure_name "current_velocity";

 (measure: $t_measured_current_velocity, source: $turtlebot3_diff_drive_nodepub) isa measurement_interface,
 	    has measurement_function_name 'calc_linear_velocity';
 $t_measured_power_draw isa Measure, has measure_name "power_draw";

 (measure: $t_measured_power_draw, source: $turtlebot3_diff_drive_nodepub) isa measurement_interface,
 	    has measurement_function_name 'MovementPowerDraw';
 $t_measured_power_budget isa Measure, has measure_name "power_budget";

 (measure: $t_measured_power_budget, source: $detect_object_node_service_server_5) isa measurement_interface,
 	    has measurement_proxy true,
 	    has measurement_function_name 'PowerBudget';

 $is_selected_f_hi_speed_1 (atom: $f_hi_speed) isa propositional_expression;
 $nearest_object_less_val isa ValueDouble, has double_value 0.10;
 $nearest_object_less (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_less_val) isa less_than,
    has expression_name 'nearest_object_less';

 $power_draw_greater_val isa ValueDouble, has double_value 40.0;
 $power_draw_greater (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_greater_val) isa greater_than,
    has expression_name 'power_draw_greater';

 $expr_ (
 expression:$nearest_object_less,
 expression:$power_draw_greater
 ) isa or_expression, has expression_name 'expr_';
 $expr__1 (
 		    	expression:$is_selected_f_hi_speed_1,
 		    	expression:$expr_
 		    	) isa and_expression, has expression_name 'expr__1';
 $decrease_to_medfa (
 activation: $f_med_speed
 ) isa feature_adaptation;
 $tactic_rule_decrease_to_med (tactic:$ta_frogmaxspeed, antecedent:$expr__1, consequent:$decrease_to_medfa ) isa tactic_rule, has rule_name "DECREASE_TO_MED";
 $is_selected_f_med_speed_1 (atom: $f_med_speed) isa propositional_expression;
 $nearest_object_less_1_val isa ValueDouble, has double_value 0.10;
 $nearest_object_less_1 (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_less_1_val) isa less_than,
    has expression_name 'nearest_object_less_1';

 $power_draw_greater_1_val isa ValueDouble, has double_value 40.0;
 $power_draw_greater_1 (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_greater_1_val) isa greater_than,
  has expression_name 'power_draw_greater_1';

 $expr__2 (
 expression:$nearest_object_less_1,
 expression:$power_draw_greater_1
 ) isa or_expression, has expression_name 'expr__2';
 $expr__3 (
 		    	expression:$is_selected_f_med_speed_1,
 		    	expression:$expr__2
 		    	) isa and_expression, has expression_name 'expr__3';
 $decrease_to_lowfa (
 activation: $f_low_speed
 ) isa feature_adaptation;
 $tactic_rule_decrease_to_low (tactic:$ta_frogmaxspeed, antecedent:$expr__3, consequent:$decrease_to_lowfa ) isa tactic_rule, has rule_name "DECREASE_TO_LOW";
 $is_selected_f_low_speed_1 (atom: $f_low_speed) isa propositional_expression;
 $nearest_object_greater_val isa ValueDouble, has double_value 0.15;
 $nearest_object_greater (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_greater_val) isa greater_than,
    has expression_name 'nearest_object_greater';

 $power_draw_leq_val isa ValueDouble, has double_value 40.0;
 $power_draw_leq (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_leq_val) isa less_than_equal,
    has expression_name 'power_draw_leq';

 $current_velocity_less_val isa ValueDouble, has double_value 0.40;
 $current_velocity_less (lhs_value:$t_measured_current_velocity, rhs_value: $current_velocity_less_val) isa less_than,
    has expression_name 'current_velocity_less';

 $expr__4 (
 expression:$nearest_object_greater,
 expression:$power_draw_leq,
 expression:$current_velocity_less
 ) isa or_expression, has expression_name 'expr__4';
 $expr__5 (
 		    	expression:$is_selected_f_low_speed_1,
 		    	expression:$expr__4
 		    	) isa and_expression, has expression_name 'expr__5';
 $increase_to_medfa (
 activation: $f_med_speed
 ) isa feature_adaptation;
 $tactic_rule_increase_to_med (tactic:$ta_frogmaxspeed, antecedent:$expr__5, consequent:$increase_to_medfa ) isa tactic_rule, has rule_name "INCREASE_TO_MED";
 $is_selected_f_med_speed_2 (atom: $f_med_speed) isa propositional_expression;
 $nearest_object_greater_1_val isa ValueDouble, has double_value 0.15;
 $nearest_object_greater_1 (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_greater_1_val) isa greater_than;

 $power_draw_leq_1_val isa ValueDouble, has double_value 40.0;
 $power_draw_leq_1 (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_leq_1_val) isa less_than_equal;

 $current_velocity_less_1_val isa ValueDouble, has double_value 0.40;
 $current_velocity_less_1 (lhs_value:$t_measured_current_velocity, rhs_value: $current_velocity_less_1_val) isa less_than;

 $expr__6 (
 expression:$nearest_object_greater_1,
 expression:$power_draw_leq_1,
 expression:$current_velocity_less_1
 ) isa or_expression, has expression_name 'expr__6';
 $expr__7 (
 		    	expression:$is_selected_f_med_speed_2,
 		    	expression:$expr__6
 		    	) isa and_expression, has expression_name 'expr__7';
 $increase_to_maxfa (
 activation: $f_hi_speed
 ) isa feature_adaptation;
 $tactic_rule_increase_to_max (tactic:$ta_frogmaxspeed, antecedent:$expr__7, consequent:$increase_to_maxfa ) isa tactic_rule, has rule_name "INCREASE_TO_MAX";
 $sp_max_velocity_p_array_value isa ValueArray;
 $sp_max_velocity_pvalue isa ValueDouble, has double_value 0.1;
 $sp_max_velocity_p_array_value_elem_0 (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue) isa at_index, has index 0;
 $sp_max_velocity_pvalue_1 isa ValueDouble, has double_value 0;
 $sp_max_velocity_p_array_value_elem_1 (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue_1) isa at_index, has index 1;
 $sp_max_velocity_pvalue_2 isa ValueDouble, has double_value 1;
 $sp_max_velocity_p_array_value_elem_2 (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue_2) isa at_index, has index 2;

 $sp_max_velocity (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $sp_max_velocity_p_array_value) isa set_nodes_parameters;
 $low_speed_resolution_act (
 	resolution_action: $sp_max_velocity
 , variant: $f_low_speed) isa variant_activation;
 $sp_max_velocity_1_p_array_value isa ValueArray;
 $sp_max_velocity_1_pvalue isa ValueDouble, has double_value 0.18;
 $sp_max_velocity_1_p_array_value_elem_0 (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue) isa at_index, has index 0;
 $sp_max_velocity_1_pvalue_1 isa ValueDouble, has double_value 0;
 $sp_max_velocity_1_p_array_value_elem_1 (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue_1) isa at_index, has index 1;
 $sp_max_velocity_1_pvalue_2 isa ValueDouble, has double_value 1;
 $sp_max_velocity_1_p_array_value_elem_2 (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue_2) isa at_index, has index 2;

 $sp_max_velocity_1 (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $sp_max_velocity_1_p_array_value) isa set_nodes_parameters;
 $med_speed_resolution_act (
 	resolution_action: $sp_max_velocity_1
 , variant: $f_med_speed) isa variant_activation;
 $sp_max_velocity_2 (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $max_velocity_param_p_array_value) isa set_nodes_parameters;
 $hi_speed_resolution_act (
 	resolution_action: $sp_max_velocity_2
 , variant: $f_hi_speed) isa variant_activation;
 $res_rebet_frog (tactic: $ta_frogmaxspeed,
 variant_resolution:$low_speed_resolution_act,
  variant_resolution:$med_speed_resolution_act,
  variant_resolution:$hi_speed_resolution_act
  )
  isa resolution_model,
     has resolution_model_name "rebet_frog", has ros_system "rebet_frog";

# benchmark aliases with leading slash to match runtime API inputs
 $bt_navigator_node_action_server_1 has interface_name "/navigate_to_pose";
 $controller_server_node_action_server has interface_name "/follow_path";
 $planner_server_node_action_server_1 has interface_name "/compute_path_to_pose";


 $rebetmc isa System, has system_name "rebetmc";
 $movequickly_as_close_set isa FuzzyTriangular,
 	has a -0.5,
 	has b 0.0,
 	has c 0.5;

 $movequickly_as_close (fuzzy_set: $movequickly_as_close_set, term: $t_measured_current_velocity) isa as_close_as_possible_expression,
 	has required_value 0.26,
	has expression_name "movequickly_as_close";

 $movequickly_as_close_shall (expression: $movequickly_as_close) isa shall_expression, has expression_name "movequickly_as_close_shall";

 $movequickly_requirement (system: $rebetmc, expression: $movequickly_as_close_shall) isa relaxed_requirement,
 	has requirement_name "MoveQuickly",
 	has in_effect false,
 	has description "Move as quickly as possible to 0.26 m/s";

 $t_measured_too_close_prop_exp (atom: $t_measured_too_close) isa propositional_expression;

 $t_measured_too_close_prop_exp_neg (expression: $t_measured_too_close_prop_exp) isa fuzzy_not,
 	has expression_name "t_measured_too_close_prop_exp_neg";
#  $t_measured_current_velocity_prop_exp (atom: $t_measured_current_velocity) isa propositional_expression;
 $movesafely_as_close_set isa FuzzyTriangular,
 	has a -0.5,
 	has b 0.0,
 	has c 0.5;

 $movesafely_as_close (fuzzy_set: $movesafely_as_close_set, term: $t_measured_current_velocity) isa as_close_as_possible_expression,
 	has required_value 0.18, has expression_name "movesafely_as_close";

 $t_measured_too_close_prop_exp_neg_movesafely_as_close_or (expression: $t_measured_too_close_prop_exp_neg, expression: $movesafely_as_close) isa fuzzy_or, has expression_name "t_measured_too_close_prop_exp_neg_movesafely_as_close_or";

 $t_measured_too_close_prop_exp_neg_movesafely_as_close_or_shall (expression: $t_measured_too_close_prop_exp_neg_movesafely_as_close_or) isa shall_expression, has expression_name "t_measured_too_close_prop_exp_neg_movesafely_as_close_or_shall";

 $movesafely_requirement (system: $rebetmc, expression: $t_measured_too_close_prop_exp_neg_movesafely_as_close_or_shall) isa relaxed_requirement,
 	has requirement_name "MoveSafely",
 	has in_effect false,
 	has description "Try to keep a velocity of below 0.18m/s while an object is within the first 10% of the range of the LIDAR.";

# benchmark-focused in-effect requirements for potential fulfillment coverage
 $benchmark_movequickly_requirement (
     system: $rebetmc,
     expression: $movequickly_as_close_shall
 ) isa relaxed_requirement,
    has requirement_name "BenchmarkMoveQuickly",
    has in_effect true,
    has description "Benchmark requirement using existing MoveQuickly expression.";

 $benchmark_movesafely_requirement (
     system: $rebetmc,
     expression: $t_measured_too_close_prop_exp_neg_movesafely_as_close_or_shall
 ) isa relaxed_requirement,
    has requirement_name "BenchmarkMoveSafely",
    has in_effect true,
    has description "Benchmark requirement using existing MoveSafely expression.";
