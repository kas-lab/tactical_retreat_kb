 $ta_frogmaxspeed isa Tactic, has tactic_name "FROGMaxSpeed";

 # define Feature Model
 $f_low_speed isa Feature, has feature_name "LOW_SPEED", has mandatory false;
 $f_med_speed isa Feature, has feature_name "MED_SPEED", has mandatory false;
 $f_hi_speed isa Feature, has feature_name "HI_SPEED", has mandatory false;


 $t_measured_nearest_object isa Measure, has measure_name "nearest_object";

 $measurement_interface_1 isa measurement_interface,
    links (measure: $t_measured_nearest_object, source: $turtlebot3_laserscan_nodepub),
 	    has measurement_function_name 'get_nearest_laser_scan_ratio';
 $t_measured_too_close isa Measure, has measure_name "too_close";

 $measurement_interface_2 isa measurement_interface,
    links (measure: $t_measured_too_close, source: $turtlebot3_laserscan_nodepub),
 	    has measurement_function_name 'is_too_close';
 $t_measured_current_velocity isa Measure, has measure_name "current_velocity";

 $measurement_interface_3 isa measurement_interface,
    links (measure: $t_measured_current_velocity, source: $turtlebot3_diff_drive_nodepub),
 	    has measurement_function_name 'calc_linear_velocity';
 $t_measured_power_draw isa Measure, has measure_name "power_draw";

 $measurement_interface_4 isa measurement_interface,
    links (measure: $t_measured_power_draw, source: $turtlebot3_diff_drive_nodepub),
 	    has measurement_function_name 'MovementPowerDraw';
 $t_measured_power_budget isa Measure, has measure_name "power_budget";

 $measurement_interface_5 isa measurement_interface,
    links (measure: $t_measured_power_budget, source: $detect_object_node_service_server_5),
 	    has measurement_proxy true,
 	    has measurement_function_name 'PowerBudget';

 $is_selected_f_hi_speed_1 isa propositional_expression,
    links (atom: $f_hi_speed);
 $nearest_object_less_val isa ValueSingleton, has double_value 0.10;
 $nearest_object_less isa less_than, links (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_less_val) ,
    has expression_name 'nearest_object_less';

 $power_draw_greater_val isa ValueSingleton, has double_value 40.0;
 $power_draw_greater isa greater_than, links (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_greater_val) ,
    has expression_name 'power_draw_greater';

 $expr_ isa or_expression,
    links (expression: $nearest_object_less,
 expression:$power_draw_greater),
    has expression_name 'expr_';
 $expr__1 isa and_expression,
    links (expression: $is_selected_f_hi_speed_1,
 		    	expression:$expr_),
    has expression_name 'expr__1';
 $decrease_to_medfa isa feature_adaptation,
    links (activation: $f_med_speed);
 $tactic_rule_decrease_to_med isa tactic_rule,
    links (tactic: $ta_frogmaxspeed, antecedent: $expr__1, consequent: $decrease_to_medfa),
    has rule_name "DECREASE_TO_MED";
 $is_selected_f_med_speed_1 isa propositional_expression,
    links (atom: $f_med_speed);
 $nearest_object_less_1_val isa ValueSingleton, has double_value 0.10;
 $nearest_object_less_1 isa less_than, links (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_less_1_val) ,
    has expression_name 'nearest_object_less_1';

 $power_draw_greater_1_val isa ValueSingleton, has double_value 40.0;
 $power_draw_greater_1 isa greater_than, links (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_greater_1_val) ,
  has expression_name 'power_draw_greater_1';

 $expr__2 isa or_expression,
    links (expression: $nearest_object_less_1,
 expression:$power_draw_greater_1),
    has expression_name 'expr__2';
 $expr__3 isa and_expression,
    links (expression: $is_selected_f_med_speed_1,
 		    	expression:$expr__2),
    has expression_name 'expr__3';
 $decrease_to_lowfa isa feature_adaptation,
    links (activation: $f_low_speed);
 $tactic_rule_decrease_to_low isa tactic_rule,
    links (tactic: $ta_frogmaxspeed, antecedent: $expr__3, consequent: $decrease_to_lowfa),
    has rule_name "DECREASE_TO_LOW";
 $is_selected_f_low_speed_1 isa propositional_expression,
    links (atom: $f_low_speed);
 $nearest_object_greater_val isa ValueSingleton, has double_value 0.15;
 $nearest_object_greater isa greater_than, links (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_greater_val) ,
    has expression_name 'nearest_object_greater';

 $power_draw_leq_val isa ValueSingleton, has double_value 40.0;
 $power_draw_leq isa less_than_equal, links (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_leq_val) ,
    has expression_name 'power_draw_leq';

 $current_velocity_less_val isa ValueSingleton, has double_value 0.40;
 $current_velocity_less isa less_than, links (lhs_value:$t_measured_current_velocity, rhs_value: $current_velocity_less_val) ,
    has expression_name 'current_velocity_less';

 $expr__4 isa or_expression,
    links (expression: $nearest_object_greater,
 expression:$power_draw_leq,
 expression:$current_velocity_less),
    has expression_name 'expr__4';
 $expr__5 isa and_expression,
    links (expression: $is_selected_f_low_speed_1,
 		    	expression:$expr__4),
    has expression_name 'expr__5';
 $increase_to_medfa isa feature_adaptation,
    links (activation: $f_med_speed);
 $tactic_rule_increase_to_med isa tactic_rule,
    links (tactic: $ta_frogmaxspeed, antecedent: $expr__5, consequent: $increase_to_medfa),
    has rule_name "INCREASE_TO_MED";
 $is_selected_f_med_speed_2 isa propositional_expression,
    links (atom: $f_med_speed);
 $nearest_object_greater_1_val isa ValueSingleton, has double_value 0.15;
 $nearest_object_greater_1 isa greater_than,
    links (lhs_value: $t_measured_nearest_object, rhs_value: $nearest_object_greater_1_val);

 $power_draw_leq_1_val isa ValueSingleton, has double_value 40.0;
 $power_draw_leq_1 isa less_than_equal,
    links (lhs_value: $t_measured_power_draw, rhs_value: $power_draw_leq_1_val);

 $current_velocity_less_1_val isa ValueSingleton, has double_value 0.40;
 $current_velocity_less_1 isa less_than,
    links (lhs_value: $t_measured_current_velocity, rhs_value: $current_velocity_less_1_val);

 $expr__6 isa or_expression,
    links (expression: $nearest_object_greater_1,
 expression:$power_draw_leq_1,
 expression:$current_velocity_less_1),
    has expression_name 'expr__6';
 $expr__7 isa and_expression,
    links (expression: $is_selected_f_med_speed_2,
 		    	expression:$expr__6),
    has expression_name 'expr__7';
 $increase_to_maxfa isa feature_adaptation,
    links (activation: $f_hi_speed);
 $tactic_rule_increase_to_max isa tactic_rule,
    links (tactic: $ta_frogmaxspeed, antecedent: $expr__7, consequent: $increase_to_maxfa),
    has rule_name "INCREASE_TO_MAX";
 $sp_max_velocity_p_array_value isa ValueArray;
 $sp_max_velocity_pvalue isa ValueSingleton, has double_value 0.1;
 $sp_max_velocity_p_array_value_elem_0 isa at_index,
    links (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue),
    has index 0;
 $sp_max_velocity_pvalue_1 isa ValueSingleton, has double_value 0;
 $sp_max_velocity_p_array_value_elem_1 isa at_index,
    links (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue_1),
    has index 1;
 $sp_max_velocity_pvalue_2 isa ValueSingleton, has double_value 1;
 $sp_max_velocity_p_array_value_elem_2 isa at_index,
    links (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue_2),
    has index 2;

 $sp_max_velocity isa set_nodes_parameters,
    links (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $sp_max_velocity_p_array_value);
 $low_speed_resolution_act isa variant_activation,
    links (resolution_action: $sp_max_velocity, variant: $f_low_speed);
 $sp_max_velocity_1_p_array_value isa ValueArray;
 $sp_max_velocity_1_pvalue isa ValueSingleton, has double_value 0.18;
 $sp_max_velocity_1_p_array_value_elem_0 isa at_index,
    links (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue),
    has index 0;
 $sp_max_velocity_1_pvalue_1 isa ValueSingleton, has double_value 0;
 $sp_max_velocity_1_p_array_value_elem_1 isa at_index,
    links (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue_1),
    has index 1;
 $sp_max_velocity_1_pvalue_2 isa ValueSingleton, has double_value 1;
 $sp_max_velocity_1_p_array_value_elem_2 isa at_index,
    links (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue_2),
    has index 2;

 $sp_max_velocity_1 isa set_nodes_parameters,
    links (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $sp_max_velocity_1_p_array_value);
 $med_speed_resolution_act isa variant_activation,
    links (resolution_action: $sp_max_velocity_1, variant: $f_med_speed);
 $sp_max_velocity_2 isa set_nodes_parameters,
    links (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $max_velocity_param_p_array_value);
 $hi_speed_resolution_act isa variant_activation,
    links (resolution_action: $sp_max_velocity_2, variant: $f_hi_speed);
 $sys_rebet_frog isa System, has system_name "rebet_frog";
 $res_rebet_frog isa resolution_model,
    links (tactic: $ta_frogmaxspeed, variant_resolution: $low_speed_resolution_act,
  variant_resolution:$med_speed_resolution_act,
  variant_resolution:$hi_speed_resolution_act, system: $sys_rebet_frog),
    has resolution_model_name "rebet_frog";

 $rebetmc isa System, has system_name "rebetmc";
 $movequickly_as_close_set isa FuzzyTriangular,
 	has a -0.5,
 	has b 0.0,
 	has c 0.5;

 $movequickly_as_close isa as_close_as_possible_expression, links (fuzzy_set: $movequickly_as_close_set, term: $t_measured_current_velocity),
 	has required_value 0.26,
	has expression_name "movequickly_as_close";

 $movequickly_as_close_shall isa shall_expression,
    links (expression: $movequickly_as_close),
    has expression_name "movequickly_as_close_shall";

 $movequickly_requirement isa relaxed_requirement,
    links (system: $rebetmc, expression: $movequickly_as_close_shall),
 	has requirement_name "MoveQuickly",
 	has in_effect false,
 	has description "Move as quickly as possible to 0.26 m/s";

 $t_measured_too_close_prop_exp isa propositional_expression,
    links (atom: $t_measured_too_close);

 $t_measured_too_close_prop_exp_neg isa fuzzy_not,
    links (expression: $t_measured_too_close_prop_exp),
    has expression_name "t_measured_too_close_prop_exp_neg";
 $movesafely_as_close_set isa FuzzyTriangular,
 	has a -0.5,
 	has b 0.0,
 	has c 0.5;

 $movesafely_as_close  isa as_close_as_possible_expression, links (fuzzy_set: $movesafely_as_close_set, term: $t_measured_current_velocity),
 	has required_value 0.18, has expression_name "movesafely_as_close";

 $t_measured_too_close_prop_exp_neg_movesafely_as_close_or isa fuzzy_or,
    links (expression: $t_measured_too_close_prop_exp_neg, expression: $movesafely_as_close),
    has expression_name "t_measured_too_close_prop_exp_neg_movesafely_as_close_or";

 $t_measured_too_close_prop_exp_neg_movesafely_as_close_or_shall isa shall_expression,
    links (expression: $t_measured_too_close_prop_exp_neg_movesafely_as_close_or),
    has expression_name "t_measured_too_close_prop_exp_neg_movesafely_as_close_or_shall";

 $movesafely_requirement isa relaxed_requirement,
    links (system: $rebetmc, expression: $t_measured_too_close_prop_exp_neg_movesafely_as_close_or_shall),
 	has requirement_name "MoveSafely",
 	has in_effect false,
 	has description "Try to keep a velocity of below 0.18m/s while an object is within the first 10% of the range of the LIDAR.";

# benchmark-focused in-effect requirements for potential fulfillment coverage
 $benchmark_movequickly_requirement isa relaxed_requirement,
    links (system: $rebetmc, expression: $movequickly_as_close_shall),
    has requirement_name "BenchmarkMoveQuickly",
    has in_effect true,
    has description "Benchmark requirement using existing MoveQuickly expression.";

 $benchmark_movesafely_requirement isa relaxed_requirement,
    links (system: $rebetmc, expression: $t_measured_too_close_prop_exp_neg_movesafely_as_close_or_shall),
    has requirement_name "BenchmarkMoveSafely",
    has in_effect true,
    has description "Benchmark requirement using existing MoveSafely expression.";
