insert

### Nodes
$node_1 isa ROSNode,
	has node_name "node_1",
	has start_time 2025-09-06T11:57:56.666;
$node_2 isa ROSNode,
	has node_name "node_2",
	has start_time 2025-09-06T11:57:56.666;
$node_3 isa ROSNode,
	has node_name "node_3",
	has start_time 2025-09-06T11:57:56.666;

# $node_not_running isa ROSNode,
# 	has node_name "node_not_running",
# 	has start_time 2025-09-06T11:57:56.666,
# 	has end_time 2025-09-07T11:57:56.666;

# $parameter isa ParameterDouble, has parameter_name "parameter";
# $parameter_value isa ValueDouble, has double_value 0.10;

### Resolution actions

$res_action_set_node_1_lc_active (node: $node_1) isa set_lifecycle_state,
	has lifecycle_state 'active', has action_name 'res_action_set_node_1_lc_active';
$res_action_set_node_1_lc_inactive (node: $node_1) isa set_lifecycle_state,
	has lifecycle_state 'inactive', has action_name 'res_action_set_node_1_lc_inactive';

$res_action_set_node_2_lc_active (node: $node_2) isa set_lifecycle_state,
	has lifecycle_state 'active', has action_name 'res_action_set_node_2_lc_active';
$res_action_set_node_2_lc_inactive (node: $node_2) isa set_lifecycle_state,
	has lifecycle_state 'inactive', has action_name 'res_action_set_node_2_lc_inactive';

$res_action_set_node_3_lc_active (node: $node_3) isa set_lifecycle_state,
	has lifecycle_state 'active', has action_name 'res_action_set_node_3_lc_active';
$res_action_set_node_3_lc_inactive (node: $node_3) isa set_lifecycle_state,
	has lifecycle_state 'inactive', has action_name 'res_action_set_node_3_lc_inactive';

### Feature hierarchy

$feature_parent_alternative isa Feature, has feature_name "feature_parent_alternative", has mandatory true;
$f_alternative_child_1 isa Feature, has feature_name "f_alternative_child_1";
$f_alternative_child_2 isa Feature, has feature_name "f_alternative_child_2";
$f_alternative_child_3 isa Feature, has feature_name "f_alternative_child_3", has selected true;
(parent: $feature_parent_alternative, child: $f_alternative_child_1, child: $f_alternative_child_2, child: $f_alternative_child_3) isa alternative;

# $feature_parent_or_group isa Feature, has feature_name "feature_parent_or_group", has mandatory true;
# $f_or_group_child_1 isa Feature, has feature_name "f_or_group_child_1";
# $f_or_group_child_2 isa Feature, has feature_name "f_or_group_child_2";
# $f_or_group_child_3 isa Feature, has feature_name "f_or_group_child_3", has selected true;
# (parent: $feature_parent_or_group, child: $f_or_group_child_1, child: $f_or_group_child_2, child: $f_or_group_child_3) isa or_group;

$f_req_constraint isa Feature, has feature_name "f_req_constraint";
$f_req_constrained isa Feature, has feature_name "f_req_constrained";
(constrained: $f_req_constrained, constraint: $f_req_constraint) isa requires_constraint;

$f_exc_constraint isa Feature, has feature_name "f_exc_constraint", has selected true;
$f_exc_constrained isa Feature, has feature_name "f_exc_constrained";
(constrained: $f_exc_constrained, constraint: $f_exc_constraint) isa excludes_constraint;

### Variant resolutions
$vr_ac_1_act (resolution_action: $res_action_set_node_1_lc_active, variant: $f_alternative_child_1) isa variant_activation;
$vr_ac_1_deact (resolution_action: $res_action_set_node_1_lc_inactive, variant: $f_alternative_child_1) isa variant_deactivation;

$vr_ac_2_act (resolution_action: $res_action_set_node_2_lc_active, variant: $f_alternative_child_2) isa variant_activation;
$vr_ac_2_deact (resolution_action: $res_action_set_node_2_lc_inactive, variant: $f_alternative_child_2) isa variant_deactivation;

$vr_ac_3_act (resolution_action: $res_action_set_node_3_lc_active, variant: $f_alternative_child_3) isa variant_activation;
$vr_ac_3_deact (resolution_action: $res_action_set_node_3_lc_inactive, variant: $f_alternative_child_3) isa variant_deactivation;

$vr_req_constraint_act (resolution_action: $res_action_set_node_1_lc_active, variant: $f_req_constraint) isa variant_activation;
$vr_req_constrained_act (resolution_action: $res_action_set_node_2_lc_active, variant: $f_req_constrained) isa variant_activation;

$vr_exc_constraint_act (resolution_action: $res_action_set_node_1_lc_inactive, variant: $f_exc_constraint) isa variant_deactivation;
$vr_exc_constrained_act (resolution_action: $res_action_set_node_2_lc_active, variant: $f_exc_constrained) isa variant_activation;

### Feature adaptations
$fa1 (activation: $f_alternative_child_1) isa feature_adaptation, has feature_adaptation_name 'fa1';

$fa2 (activation: $f_req_constrained) isa feature_adaptation, has feature_adaptation_name 'fa2';
$fa3 (activation: $f_exc_constrained) isa feature_adaptation, has feature_adaptation_name 'fa3';

$t isa Tactic, has tactic_name "tactic";

(tactic:$t, consequent: $fa1) isa tactic_rule, has rule_name "tactic_rule_1";
(tactic:$t, consequent: $fa2) isa tactic_rule, has rule_name "tr_activate_req_constrained";
(tactic:$t, consequent: $fa3) isa tactic_rule, has rule_name "tr_activate_exc_constrained";
# (tactic:$t, consequent: $fa_vr_2) isa tactic_rule, has rule_name "tr_variant_resolution_unfeasible_1"; # rule_valid false
# (tactic:$t, consequent: $fa_vr_3) isa tactic_rule, has rule_name "tr_variant_resolution_unfeasible_2"; # rule_valid false

# $vr2 (resolution_action: $res_action_unfeasible, variant: $f_vr_2) isa variant_activation; # feasible false
# $vr3 (resolution_action: $res_action_set_node_1_param_1, resolution_action: $res_action_unfeasible, variant: $f_vr_3) isa variant_activation; # feasible false


# $f_selected_1 isa Feature, has feature_name "f_selected_1", has selected true;
# $f_selected_2 isa Feature, has feature_name "f_selected_2", has selected true;

# $f_not_selected_1 isa Feature, has feature_name "f_not_selected_1", has selected false;
# $f_not_selected_2 isa Feature, has feature_name "f_not_selected_2";

# $f_req_constrained_1 isa Feature, has feature_name "f_req_constrained_1";
# $f_req_constrained_2 isa Feature, has feature_name "f_req_constrained_2";
# $f_req_constrained_3 isa Feature, has feature_name "f_req_constrained_3";
# $f_req_constrained_4 isa Feature, has feature_name "f_req_constrained_4";
# $f_req_constrained_5 isa Feature, has feature_name "f_req_constrained_5";

# (constrained: $f_req_constrained_1, constraint: $f_selected_1) isa requires_constraint;      # selectable true
# (constrained: $f_req_constrained_2, constraint: $f_not_selected_1) isa requires_constraint;  # selectable false

# (constrained: $f_req_constrained_3, constraint: $f_selected_1, constraint: $f_selected_2) isa requires_constraint;          # selectable true
# (constrained: $f_req_constrained_4, constraint: $f_not_selected_1, constraint: $f_not_selected_2) isa requires_constraint;  # selectable false
# (constrained: $f_req_constrained_5, constraint: $f_selected_1, constraint: $f_not_selected_1) isa requires_constraint;      # selectable false

# $f_excl_constrained_1 isa Feature, has feature_name "f_excl_constrained_1";
# $f_excl_constrained_2 isa Feature, has feature_name "f_excl_constrained_2";
# $f_excl_constrained_3 isa Feature, has feature_name "f_excl_constrained_3";
# $f_excl_constrained_4 isa Feature, has feature_name "f_excl_constrained_4";
# $f_excl_constrained_5 isa Feature, has feature_name "f_excl_constrained_5";

# (constrained: $f_excl_constrained_1, constraint: $f_selected_1) isa excludes_constraint;      # selectable false
# (constrained: $f_excl_constrained_2, constraint: $f_not_selected_1) isa excludes_constraint;  # selectable true

# (constrained: $f_excl_constrained_3, constraint: $f_selected_1, constraint: $f_selected_2) isa excludes_constraint;          # selectable false
# (constrained: $f_excl_constrained_4, constraint: $f_not_selected_1, constraint: $f_not_selected_2) isa excludes_constraint;  # selectable true
# (constrained: $f_excl_constrained_5, constraint: $f_selected_1, constraint: $f_not_selected_1) isa excludes_constraint;      # selectable false

