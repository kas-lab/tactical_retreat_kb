insert

# crisp variables
## measures bool
$bool_false isa ValueSingleton, has bool_value false;
$bool_true isa ValueSingleton, has bool_value true;

$double_0_10 isa ValueSingleton,
    has double_value 0.10;
$double_0_18 isa ValueSingleton,
    has double_value 0.18;
$double_0_20 isa ValueSingleton,
    has double_value 0.20;

$measure_bool_false isa Measure, has measure_name 'measure_bool_false';
(measure: $measure_bool_false, measurement_value: $bool_false) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666, has latest true;

$measure_bool_true isa Measure, has measure_name 'measure_bool_true';
(measure: $measure_bool_true, measurement_value: $bool_true) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666, has latest true;

$measure_double_0_10 isa Measure, has measure_name 'measure_double_0_10';
(measure: $measure_double_0_10, measurement_value: $double_0_10) isa measurement,
    has measurement_time 2025-09-06T11:57:56.666, has latest true;
$measure_double_0_20 isa Measure, has measure_name 'measure_double_0_20';
(measure: $measure_double_0_20, measurement_value: $double_0_20) isa measurement,
    has measurement_time 2025-09-06T11:57:56.666, has latest true;

# logical expressions
$bool_false_prop_exp isa propositional_expression,
    links (atom: $bool_false),
    has expression_name 'bool_false_prop_exp'; # False
$bool_true_prop_exp isa propositional_expression,
    links (atom: $bool_true),
    has expression_name 'bool_true_prop_exp';  # True

$false_measure_prop_exp isa propositional_expression,
    links (atom: $measure_bool_false),
    has expression_name 'false_measure_prop_exp'; # False
$true_measure_prop_exp isa propositional_expression,
    links (atom: $measure_bool_true),
    has expression_name 'true_measure_prop_exp'; # True

$md_0_10_less_v_0_18 isa less_than,
    links (lhs_value: $measure_double_0_10, rhs_value: $double_0_18),
    has expression_name 'md_0_10_less_v_0_18'; # True
$md_0_20_less_v_0_18 isa less_than,
    links (lhs_value: $measure_double_0_20, rhs_value: $double_0_18),
    has expression_name 'md_0_20_less_v_0_18'; # False

$not_false_expr isa not_expression,
    links (expression: $bool_false_prop_exp),
    has expression_name 'not_false_expr'; # True
$not_true_expr isa not_expression,
    links (expression: $bool_true_prop_exp),
    has expression_name 'not_true_expr'; # False

$or_expression_1 isa or_expression,
    links (expression: $md_0_10_less_v_0_18, expression: $md_0_20_less_v_0_18, expression: $not_false_expr),
    has expression_name 'or_expression_1'; # True
$or_expression_2 isa or_expression,
    links (expression: $md_0_20_less_v_0_18, expression: $bool_false_prop_exp),
    has expression_name 'or_expression_2'; # False

$and_expression_1 isa and_expression,
    links (expression: $md_0_10_less_v_0_18, expression: $bool_true_prop_exp),
    has expression_name 'and_expression_1'; # True
$and_expression_2 isa and_expression,
    links (expression: $md_0_10_less_v_0_18, expression: $md_0_20_less_v_0_18),
    has expression_name 'and_expression_2'; # False

# Fuzzy logic

## fuzzy ascend
$fuzzy_ascend_measure isa Measure,
	has measure_name "fuzzy_ascend_measure",
	has description "amount of foodpackages";

# just an example, the measurement should be inserted at runtime
$current_fuzzy_ascend_measure isa ValueSingleton, has double_value 9.0;
(measure:$fuzzy_ascend_measure, measurement_value: $current_fuzzy_ascend_measure) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666, has latest true;

$fuzzy_ascend_sigmoid_set isa FuzzySigmoid,
	has inflection_point 5.0,
	has exponent 0.5889;

$fuzzy_ascend_exponential_saturation_set isa FuzzyExponentialSaturation,
	has exponent 0.2;

$fuzzy_ascend_blf_set isa FuzzyBoundedLinearFraction,
	has curvature 0.5;

# expected membership 0.913378192
$fuzzy_ascend_sigmoid_expression isa fuzzy_ascend_expression,
    links (fuzzy_set: $fuzzy_ascend_sigmoid_set, term: $fuzzy_ascend_measure),
    has expression_name 'fuzzy_ascend_sigmoid_expression';

# expected memberhsip 0.834700912
$fuzzy_ascend_exponential_saturation_expression isa fuzzy_ascend_expression,
    links (fuzzy_set: $fuzzy_ascend_exponential_saturation_set, term: $fuzzy_ascend_measure),
    has expression_name 'fuzzy_ascend_exp_saturation_expression';

# expected memberhsip 0.947368421
$fuzzy_ascend_blf_expression isa fuzzy_ascend_expression,
    links (fuzzy_set: $fuzzy_ascend_blf_set, term: $fuzzy_ascend_measure),
    has expression_name 'fuzzy_ascend_blf_expression';

## fuzzy unimodal
$fuzzy_unimodal_measure isa Measure,
	has measure_name "fuzzy_unimodal_measure",
	has description "The robot's velocity";

# just an example, the measurement should be inserted at runtime
$current_fuzzy_unimodal_measure isa ValueSingleton, has double_value 0.03779;
(measure:$fuzzy_unimodal_measure, measurement_value: $current_fuzzy_unimodal_measure) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666, has latest true;

$fuzzy_unimodal_triangular_set isa FuzzyTriangular,
	has a -0.5,
	has b 0.0,
	has c 0.5;

$fuzzy_unimodal_gaussian_set isa FuzzyGaussian,
	has center 0.0,
    has sigma 0.1;

# expected membership 0.92442
$fuzzy_unimodal_triangular_expression isa fuzzy_unimodal_expression,
    links (fuzzy_set: $fuzzy_unimodal_triangular_set, term: $fuzzy_unimodal_measure),
    has expression_name 'fuzzy_unimodal_triangular_expression';

# expected membership 0.931085511
$fuzzy_unimodal_gaussian_expression isa fuzzy_unimodal_expression,
    links (fuzzy_set: $fuzzy_unimodal_gaussian_set, term: $fuzzy_unimodal_measure),
    has expression_name 'fuzzy_unimodal_gaussian_expression';

## fuzzy decay

$fuzzy_decay_measure isa Measure,
	has measure_name "fuzzy_decay_measure",
	has description "The system consumes energy during normal operation";
$current_fuzzy_decay_measure isa ValueSingleton, has double_value 500;
(measure:$fuzzy_decay_measure, measurement_value: $current_fuzzy_decay_measure) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666, has latest true;

$fuzzy_decay_exp_set isa FuzzyExponentialDecay,
	has exponent 0.0002107;

$fuzzy_decay_rational_set isa FuzzyRationalDecay,
	has curvature 2000;

# expected membership 0.9
$fuzzy_decay_exp_expression isa fuzzy_decay_expression,
    links (fuzzy_set: $fuzzy_decay_exp_set, term: $fuzzy_decay_measure),
    has expression_name 'fuzzy_decay_exp_expression';

# expected membership 0.8
$fuzzy_decay_rational_expression isa fuzzy_decay_expression,
    links (fuzzy_set: $fuzzy_decay_rational_set, term: $fuzzy_decay_measure),
    has expression_name 'fuzzy_decay_rational_expression';

## Fuzzy membership offset

$fuzzy_unimodal_offset_measure isa Measure,
	has measure_name "fuzzy_unimodal_offset_measure",
	has description "The robot's velocity";

# just an example, the measurement should be inserted at runtime
$current_fuzzy_unimodal_offset_measure isa ValueSingleton, has double_value 0.22221;
(measure:$fuzzy_unimodal_offset_measure, measurement_value: $current_fuzzy_unimodal_offset_measure) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666, has latest true;

$fuzzy_unimodal_triangular_set_offset isa FuzzyTriangular,
	has a -0.5,
	has b 0.0,
	has c 0.5;

# expected membership 0.92442
$fuzzy_unimodal_offset_triangular_expression isa fuzzy_unimodal_expression,
    links (fuzzy_set: $fuzzy_unimodal_triangular_set_offset, term: $fuzzy_unimodal_offset_measure),
    has expression_name 'fuzzy_unimodal_offset_triangular_expression',
    has offset_value -0.26;


# expected membership (1 - 0.913378192) = 0.086621808
$fuzzy_not_0 isa fuzzy_not,
    links (expression: $fuzzy_ascend_sigmoid_expression),
    has expression_name 'fuzzy_not_0';

# match $n1_expr isa fuzzy_decay_expression, has expression_name 'fuzzy_decay_rational_expression';
# expected membership (1 - 0.8) = 0.2
$fuzzy_not_1 isa fuzzy_not,
    links (expression: $fuzzy_decay_rational_expression),
    has expression_name 'fuzzy_not_1';

# expected membership (1 - 1.0) = 0.0
(expression: $bool_true_prop_exp) isa fuzzy_not, has expression_name 'fuzzy_not_2';

# expected membership (1 - 0.0) = 1.0
(expression: $bool_false_prop_exp) isa fuzzy_not, has expression_name 'fuzzy_not_3';

# expected membership (1 - 1.0) = 0.0
$fuzzy_not_4 isa fuzzy_not, links (expression: $true_measure_prop_exp), has expression_name 'fuzzy_not_4';

# expected membership (1 - 0.0) = 1.0
$fuzzy_not_5 isa fuzzy_not, links (expression: $false_measure_prop_exp), has expression_name 'fuzzy_not_5';

(expression: $md_0_10_less_v_0_18) isa fuzzy_not, has expression_name 'fuzzy_not_less_than_negated_true';

(expression: $md_0_20_less_v_0_18) isa fuzzy_not, has expression_name 'fuzzy_not_less_than_negated_false';

# Layer 3 — fuzzy_or/and that only reference leaf expressions

# expected membership 0.931085511
$fuzzy_or_0 isa fuzzy_or,
    links (expression: $fuzzy_unimodal_gaussian_expression),
    has expression_name 'fuzzy_or_0';

# expected membership 0.931085511
$fuzzy_or_1  isa fuzzy_or, links
    (expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression),
    has expression_name 'fuzzy_or_1';

# expected membership 0.947368421
(expression: $fuzzy_ascend_sigmoid_expression,
    expression: $fuzzy_ascend_exponential_saturation_expression,
    expression: $fuzzy_ascend_blf_expression,
    expression: $fuzzy_unimodal_triangular_expression,
    expression: $fuzzy_unimodal_gaussian_expression,
    expression: $fuzzy_decay_exp_expression,
    expression: $fuzzy_decay_rational_expression) isa fuzzy_or,
    has expression_name 'fuzzy_or_2';

# expected membership 0.2
$fuzzy_or_3 isa fuzzy_or,
    links (expression: $fuzzy_not_0, expression: $fuzzy_not_1),
    has expression_name 'fuzzy_or_3';

# expected membership 1.0
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression, expression: $bool_true_prop_exp) isa fuzzy_or,
    has expression_name 'fuzzy_or_4';

# expected membership 0.931085511
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression, expression: $bool_false_prop_exp) isa fuzzy_or,
    has expression_name 'fuzzy_or_5';

# expected membership 1.0
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression, expression: $true_measure_prop_exp) isa fuzzy_or,
    has expression_name 'fuzzy_or_6';

# expected membership 0.931085511
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression, expression: $false_measure_prop_exp) isa fuzzy_or,
    has expression_name 'fuzzy_or_7';

# expected membership 0.931085511
(expression: $fuzzy_unimodal_gaussian_expression) isa fuzzy_and, has expression_name 'fuzzy_and_0';

# expected membership 0.92442
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression) isa fuzzy_and, has expression_name 'fuzzy_and_1';

# expected membership 0.8
(expression: $fuzzy_ascend_sigmoid_expression, expression: $fuzzy_ascend_exponential_saturation_expression, expression: $fuzzy_ascend_blf_expression, expression: $fuzzy_unimodal_triangular_expression,
    expression: $fuzzy_unimodal_gaussian_expression, expression: $fuzzy_decay_exp_expression, expression: $fuzzy_decay_rational_expression) isa fuzzy_and,
    has expression_name 'fuzzy_and_2';

# expected membership 0.92442
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression, expression: $bool_true_prop_exp) isa fuzzy_and,
    has expression_name 'fuzzy_and_6';

# expected membership 0.0
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression, expression: $bool_false_prop_exp) isa fuzzy_and,
    has expression_name 'fuzzy_and_7';

# expected membership 0.92442
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression, expression: $true_measure_prop_exp) isa fuzzy_and,
    has expression_name 'fuzzy_and_8';

# expected membership 0.0
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_unimodal_gaussian_expression, expression: $false_measure_prop_exp) isa fuzzy_and,
    has expression_name 'fuzzy_and_9';

# expected membership 0.086621808
(expression: $fuzzy_not_0, expression: $fuzzy_not_1) isa fuzzy_and, has expression_name 'fuzzy_and_3';

# expected membership 0.92442
(expression: $fuzzy_unimodal_triangular_expression, expression: $fuzzy_or_1) isa fuzzy_and, has expression_name 'fuzzy_and_4';

# expected membership 0.0
(expression: $fuzzy_not_4, expression: $fuzzy_unimodal_gaussian_expression) isa fuzzy_and, has expression_name 'fuzzy_and_10';

# expected membership 0.931085511
(expression: $fuzzy_not_5, expression: $fuzzy_unimodal_gaussian_expression) isa fuzzy_and, has expression_name 'fuzzy_and_11';

# expected membership 0.2
(expression: $fuzzy_or_0, expression: $fuzzy_or_3) isa fuzzy_and, has expression_name 'fuzzy_and_5';

## quantified_value_fuzzy_expression — ValueSingleton double as direct term
# (branch: ValueSingleton + double_value)
# Uses same FuzzySigmoid and x=9.0, so expected membership 0.913378192
$fuzzy_vs_double_9 isa ValueSingleton, has double_value 9.0;
$fuzzy_ascend_sigmoid_vs_double_expression isa fuzzy_ascend_expression,
    links (fuzzy_set: $fuzzy_ascend_sigmoid_set, term: $fuzzy_vs_double_9),
    has expression_name 'fuzzy_ascend_sigmoid_vs_double_expression';

## quantified_value_fuzzy_expression — ValueSingleton integer as direct term
# (branch: ValueSingleton + integer_value)
# x=9 (int) cast to 9.0, same FuzzySigmoid, expected membership 0.913378192
$fuzzy_vs_integer_9 isa ValueSingleton, has integer_value 9;
$fuzzy_ascend_sigmoid_vs_integer_expression isa fuzzy_ascend_expression,
    links (fuzzy_set: $fuzzy_ascend_sigmoid_set, term: $fuzzy_vs_integer_9),
    has expression_name 'fuzzy_ascend_sigmoid_vs_integer_expression';

## quantified_value_fuzzy_expression — Measure with integer measurement
# (branch: Measure + integer_value)
# x=500 (int) cast to 500.0, FuzzyRationalDecay curvature=2000, expected 0.8
$measure_int_500 isa Measure, has measure_name 'measure_int_500';
$current_measure_int_500 isa ValueSingleton, has integer_value 500;
(measure: $measure_int_500, measurement_value: $current_measure_int_500) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666, has latest true;
$fuzzy_decay_rational_int_measure_expression isa fuzzy_decay_expression,
    links (fuzzy_set: $fuzzy_decay_rational_set, term: $measure_int_500),
    has expression_name 'fuzzy_decay_rational_int_measure_expression';

## fuzzy_triangular_membership — below range branch (x < a)
# x=-0.6 < a=-0.5, expected membership 0.0
$fuzzy_vs_neg_0_6 isa ValueSingleton, has double_value -0.6;
$fuzzy_unimodal_triangular_below_expression isa fuzzy_unimodal_expression,
    links (fuzzy_set: $fuzzy_unimodal_triangular_set, term: $fuzzy_vs_neg_0_6),
    has expression_name 'fuzzy_unimodal_triangular_below_expression';

## fuzzy_triangular_membership — above range branch (x > c)
# x=0.6 > c=0.5, expected membership 0.0
$fuzzy_vs_0_6 isa ValueSingleton, has double_value 0.6;
$fuzzy_unimodal_triangular_above_expression isa fuzzy_unimodal_expression,
    links (fuzzy_set: $fuzzy_unimodal_triangular_set, term: $fuzzy_vs_0_6),
    has expression_name 'fuzzy_unimodal_triangular_above_expression';

## fuzzy_triangular_membership — peak (x = b)
# x=0.0=b, ascending branch: m=(b-a)/(b-a)=1.0; gaussian peak also gives 1.0
$fuzzy_vs_0_0 isa ValueSingleton, has double_value 0.0;
$fuzzy_unimodal_triangular_peak_expression isa fuzzy_unimodal_expression,
    links (fuzzy_set: $fuzzy_unimodal_triangular_set, term: $fuzzy_vs_0_0),
    has expression_name 'fuzzy_unimodal_triangular_peak_expression';
$fuzzy_unimodal_gaussian_peak_expression isa fuzzy_unimodal_expression,
    links (fuzzy_set: $fuzzy_unimodal_gaussian_set, term: $fuzzy_vs_0_0),
    has expression_name 'fuzzy_unimodal_gaussian_peak_expression';

## Offset on ascend expression
# FuzzyExponentialSaturation exponent=0.2, x=9.0, offset=-4.0
# quantified=5.0, m=1-e^(-0.2*5.0)=1-e^(-1.0)=0.632120559
$fuzzy_ascend_exp_sat_offset_expression isa fuzzy_ascend_expression,
    links (fuzzy_set: $fuzzy_ascend_exponential_saturation_set, term: $fuzzy_ascend_measure),
    has expression_name 'fuzzy_ascend_exp_sat_offset_expression',
    has offset_value -4.0;

## Offset on decay expression
# FuzzyRationalDecay curvature=2000, x=500, offset=1500
# quantified=2000, m=2000/(2000+2000)=0.5
$fuzzy_decay_rational_offset_expression isa fuzzy_decay_expression,
    links (fuzzy_set: $fuzzy_decay_rational_set, term: $fuzzy_decay_measure),
    has expression_name 'fuzzy_decay_rational_offset_expression',
    has offset_value 1500.0;

## fuzzy_not wrapping unimodal expressions
# expected 1 - 0.92442 = 0.07558
$fuzzy_not_unimodal_triangular isa fuzzy_not,
    links (expression: $fuzzy_unimodal_triangular_expression),
    has expression_name 'fuzzy_not_unimodal_triangular';

# expected 1 - 0.931085511 = 0.068914489
$fuzzy_not_unimodal_gaussian isa fuzzy_not,
    links (expression: $fuzzy_unimodal_gaussian_expression),
    has expression_name 'fuzzy_not_unimodal_gaussian';

