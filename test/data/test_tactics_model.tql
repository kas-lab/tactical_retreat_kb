insert

### measurements
$m isa Measure, has measure_name "measure", has description "measure for tests";

$mvalue1 isa ValueDouble,
    has double_value 1.0;
$mvalue2 isa  ValueDouble,
    has double_value 1.1;
$mvalue3 isa  ValueDouble,
    has double_value 1.2;


(measure: $m, measurement_value: $mvalue1) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666;

(measure: $m, measurement_value: $mvalue2) isa measurement,
    has measurement_time 2025-09-06T10:57:56.666;

(measure: $m, measurement_value: $mvalue3) isa measurement,
    has measurement_time 2025-09-06T11:57:56.666;

(measure: $m) isa measurement,
    has measurement_time 2025-09-06T12:57:56.666;


$m_no_measurement isa Measure,
    has measure_name "measure_no_measurement",
    has description "measure for tests";

$m_no_valid_measurement isa Measure,
    has measure_name "measure_no_valid_measurement",
    has description "measure for tests";
(measure: $m_no_valid_measurement) isa measurement,
    has measurement_time 2025-09-06T12:57:56.666;


$litdouble isa ValueDouble,
    has double_value 1.3;

$litdoubletwo isa ValueDouble,
    has double_value 1.2;

$litdoublethree isa ValueDouble,
    has double_value 1.0;

### expressions

#### inequality expressions
$exp1 (lhs_value:$m, rhs_value:$litdouble) isa inequality_expression, has operator "<"; # True
$exp2 (lhs_value:$m, rhs_value:$litdoubletwo) isa inequality_expression, has operator "<"; # False
$exp3 (lhs_value:$m, rhs_value:$litdoublethree) isa inequality_expression, has operator "<"; # False

$exp4 (lhs_value:$m_no_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator "<";
$exp5 (lhs_value:$m_no_valid_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator "<";

$exp6 (lhs_value:$m, rhs_value:$litdouble) isa inequality_expression, has operator "<=";
$exp7 (lhs_value:$m, rhs_value:$litdoubletwo) isa inequality_expression, has operator "<=";
$exp8 (lhs_value:$m, rhs_value:$litdoublethree) isa inequality_expression, has operator "<=";
$exp9 (lhs_value:$m_no_measurement,  rhs_value:$litdoublethree) isa inequality_expression, has operator "<=";
$exp10 (lhs_value:$m_no_valid_measurement,  rhs_value:$litdoublethree) isa inequality_expression, has operator "<=";

$exp11 (lhs_value:$m, rhs_value:$litdouble) isa inequality_expression, has operator ">";
$exp12 (lhs_value:$m, rhs_value:$litdoubletwo) isa inequality_expression, has operator ">";
$exp13 (lhs_value:$m, rhs_value:$litdoublethree) isa inequality_expression, has operator ">"; # true
$exp14 (lhs_value:$m_no_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator ">";
$exp15 (lhs_value:$m_no_valid_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator ">";

(lhs_value:$m, rhs_value:$litdouble) isa inequality_expression, has operator ">=";
(lhs_value:$m, rhs_value:$litdoubletwo) isa inequality_expression, has operator ">=";
(lhs_value:$m, rhs_value:$litdoublethree) isa inequality_expression, has operator ">=";
(lhs_value:$m_no_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator ">=";
(lhs_value:$m_no_valid_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator ">=";

(lhs_value:$m, rhs_value:$litdouble) isa inequality_expression, has operator "==";
(lhs_value:$m, rhs_value:$litdoubletwo) isa inequality_expression, has operator "==";
(lhs_value:$m, rhs_value:$litdoublethree) isa inequality_expression, has operator "==";
(lhs_value:$m_no_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator "==";
(lhs_value:$m_no_valid_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator "==";

(lhs_value:$m, rhs_value:$litdouble) isa inequality_expression, has operator "!=";
(lhs_value:$m, rhs_value:$litdoubletwo) isa inequality_expression, has operator "!=";
(lhs_value:$m, rhs_value:$litdoublethree) isa inequality_expression, has operator "!=";
(lhs_value:$m_no_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator "!=";
(lhs_value:$m_no_valid_measurement, rhs_value:$litdoublethree) isa inequality_expression, has operator "!=";

### tactic rules

(antecedent:$exp1) isa tactic_rule, has rule_name "tr1"; # true
(antecedent:$exp2) isa tactic_rule, has rule_name "tr2"; # false

$and_exp1 (expression: $exp1, expression:$exp2) isa and_expression; # true && false -> false
(antecedent:$and_exp1) isa tactic_rule, has rule_name "tr3";

$and_exp2 (expression: $exp1, expression:$exp13) isa and_expression; # true && true -> true
(antecedent:$and_exp2) isa tactic_rule, has rule_name "tr4";

$or_exp1 (expression: $exp1, expression:$exp2) isa or_expression; # true || false -> true
(antecedent:$or_exp1) isa tactic_rule, has rule_name "tr5";

$or_exp2 (expression: $exp1, expression:$exp13) isa or_expression; # true || true -> true
(antecedent:$or_exp2) isa tactic_rule, has rule_name "tr6";

$or_exp3 (expression: $exp2, expression:$exp3) isa or_expression; # false || false -> false
(antecedent:$or_exp3) isa tactic_rule, has rule_name "tr7";

