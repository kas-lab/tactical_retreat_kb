insert

### measurements
$m isa Measure, has measure_name "measure", has description "measure for tests";

(measure: $m) isa measurement,
	has measurement_value 1.0,
	has measurement_time 2025-08-06T10:57:56.666;

(measure: $m) isa measurement,
	has measurement_value 1.1,
	has measurement_time 2025-09-06T10:57:56.666;

(measure: $m) isa measurement,
	has measurement_value 1.2,
	has measurement_time 2025-09-06T11:57:56.666;

(measure: $m) isa measurement,
	has measurement_time 2025-09-06T12:57:56.666;


$m_no_measurement isa Measure, has measure_name "measure_no_measurement", has description "measure for tests";

$m_no_valid_measurement isa Measure, has measure_name "measure_no_valid_measurement", has description "measure for tests";
(measure: $m_no_valid_measurement) isa measurement,
	has measurement_time 2025-09-06T12:57:56.666;


### expressions

#### inequality expressions
$exp1 (lhs_value:$m) isa inequality_expression, has operator "<", has rhs_value 1.3; # True
$exp2 (lhs_value:$m) isa inequality_expression, has operator "<", has rhs_value 1.2; # False
$exp3 (lhs_value:$m) isa inequality_expression, has operator "<", has rhs_value 1.0; # False
$exp4 (lhs_value:$m_no_measurement) isa inequality_expression, has operator "<", has rhs_value 1.0;
$exp5 (lhs_value:$m_no_valid_measurement) isa inequality_expression, has operator "<", has rhs_value 1.0;

$exp6 (lhs_value:$m) isa inequality_expression, has operator "<=", has rhs_value 1.3;
$exp7 (lhs_value:$m) isa inequality_expression, has operator "<=", has rhs_value 1.2;
$exp8 (lhs_value:$m) isa inequality_expression, has operator "<=", has rhs_value 1.0;
$exp9 (lhs_value:$m_no_measurement) isa inequality_expression, has operator "<=", has rhs_value 1.0;
$exp10 (lhs_value:$m_no_valid_measurement) isa inequality_expression, has operator "<=", has rhs_value 1.0;

$exp11 (lhs_value:$m) isa inequality_expression, has operator ">", has rhs_value 1.3;
$exp12 (lhs_value:$m) isa inequality_expression, has operator ">", has rhs_value 1.2;
$exp13 (lhs_value:$m) isa inequality_expression, has operator ">", has rhs_value 1.0; # true
$exp14 (lhs_value:$m_no_measurement) isa inequality_expression, has operator ">", has rhs_value 1.0;
$exp15 (lhs_value:$m_no_valid_measurement) isa inequality_expression, has operator ">", has rhs_value 1.0;

(lhs_value:$m) isa inequality_expression, has operator ">=", has rhs_value 1.3;
(lhs_value:$m) isa inequality_expression, has operator ">=", has rhs_value 1.2;
(lhs_value:$m) isa inequality_expression, has operator ">=", has rhs_value 1.0;
(lhs_value:$m_no_measurement) isa inequality_expression, has operator ">=", has rhs_value 1.0;
(lhs_value:$m_no_valid_measurement) isa inequality_expression, has operator ">=", has rhs_value 1.0;

(lhs_value:$m) isa inequality_expression, has operator "==", has rhs_value 1.3;
(lhs_value:$m) isa inequality_expression, has operator "==", has rhs_value 1.2;
(lhs_value:$m) isa inequality_expression, has operator "==", has rhs_value 1.0;
(lhs_value:$m_no_measurement) isa inequality_expression, has operator "==", has rhs_value 1.0;
(lhs_value:$m_no_valid_measurement) isa inequality_expression, has operator "==", has rhs_value 1.0;

(lhs_value:$m) isa inequality_expression, has operator "!=", has rhs_value 1.3;
(lhs_value:$m) isa inequality_expression, has operator "!=", has rhs_value 1.2;
(lhs_value:$m) isa inequality_expression, has operator "!=", has rhs_value 1.0;
(lhs_value:$m_no_measurement) isa inequality_expression, has operator "!=", has rhs_value 1.0;
(lhs_value:$m_no_valid_measurement) isa inequality_expression, has operator "!=", has rhs_value 1.0;

### tactic rules

(antecedent:$exp1) isa tactic_rule, has rule_name "tr1"; # true
(antecedent:$exp2) isa tactic_rule, has rule_name "tr2"; # false

$and_exp1 (expression: $exp1, expression:$exp2) isa and_expression; # true && false -> false
(antecedent:$and_exp1) isa tactic_rule, has rule_name "tr3";

$and_exp2 (expression: $exp1, expression:$exp13) isa and_expression; # true && true -> true
(antecedent:$and_exp2) isa tactic_rule, has rule_name "tr4";

$or_exp1 (expression: $exp1, expression:$exp2) isa or_expression; # true || false -> true
(antecedent:$or_exp1) isa tactic_rule, has rule_name "tr5";

$or_exp2 (expression: $exp1, expression:$exp13) isa or_expression; # true || true -> true
(antecedent:$or_exp2) isa tactic_rule, has rule_name "tr6";

$or_exp3 (expression: $exp2, expression:$exp3) isa or_expression; # false || false -> false
(antecedent:$or_exp3) isa tactic_rule, has rule_name "tr7";

