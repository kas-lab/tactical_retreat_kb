# Stage 1: insert all safe entities/relations and anonymous leaf expressions
insert

### measurements
$m isa Measure, has measure_name "measure", has description "measure for tests";

$mvalue1 isa ValueSingleton,
    has double_value 1.0;
$mvalue2 isa  ValueSingleton,
    has double_value 1.1;
$mvalue3 isa  ValueSingleton,
    has double_value 1.2;

(measure: $m, measurement_value: $mvalue3) isa measurement,
    has measurement_time 2025-09-06T11:57:56.666, has latest true;

$double_1_3 isa ValueSingleton,
    has double_value 1.3;

$double_1_2 isa ValueSingleton,
    has double_value 1.2;

$double_1_0 isa ValueSingleton,
    has double_value 1.0;

### expressions

#### anonymous leaf expressions (identified by expression_name for later pipeline stages)
# measurement is 1.2
$exp1 isa less_than,
    links (lhs_value: $m, rhs_value: $double_1_3),
    has expression_name 'exp1'; # True
$exp2 isa less_than,
    links (lhs_value: $m, rhs_value: $double_1_2),
    has expression_name 'exp2'; # False

# 1.2 < 1.0
$exp3 isa less_than,
    links (lhs_value: $m, rhs_value: $double_1_0),
    has expression_name 'exp3'; # False
$exp4 isa greater_than,
    links (lhs_value: $m, rhs_value: $double_1_0),
    has expression_name 'exp4'; # True

### resolution actions
$node_running isa ROSNode,
	has node_name "node_running",
	has start_time 2025-09-06T11:57:56.666;
$node_not_running isa ROSNode,
	has node_name "node_not_running",
	has start_time 2025-09-06T11:57:56.666,
	has end_time 2025-09-07T11:57:56.666;

$parameter isa Parameter, has parameter_name "parameter";
$parameter_value isa ValueSingleton, has double_value 0.10;
# anonymous set_nodes_parameters (identified later by node_name)
$set_nodes_params_running isa set_nodes_parameters,
    links (node: $node_running, parameter: $parameter, parameter_value: $parameter_value);
$set_nodes_params_not_running isa set_nodes_parameters,
    links (node: $node_not_running, parameter: $parameter, parameter_value: $parameter_value);

$lifecycle_node_active isa LifeCycleNode,
	has node_name "lifecycle_node_active",
	has start_time 2025-09-06T11:57:56.666,
    has lifecycle_state "active";

$lifecycle_node_inactive isa LifeCycleNode,
	has node_name "lifecycle_node_inactive",
	has start_time 2025-09-06T11:57:56.666,
    has lifecycle_state "inactive";

$lifecycle_node_unconfigured isa LifeCycleNode,
	has node_name "lifecycle_node_unconfigured",
	has start_time 2025-09-06T11:57:56.666,
    has lifecycle_state "unconfigured";

$lifecycle_node_finalized isa LifeCycleNode,
	has node_name "lifecycle_node_finalized",
	has start_time 2025-09-06T11:57:56.666,
    has lifecycle_state "finalized";

(node: $lifecycle_node_active) isa set_lifecycle_state, has target_lifecycle_state "active";       # feasible is true
(node: $lifecycle_node_active) isa set_lifecycle_state, has target_lifecycle_state "inactive";     # feasible is true
(node: $lifecycle_node_active) isa set_lifecycle_state, has target_lifecycle_state "unconfigured"; # feasible is false
(node: $lifecycle_node_active) isa set_lifecycle_state, has target_lifecycle_state "finalized";    # feasible is true

(node: $lifecycle_node_inactive) isa set_lifecycle_state, has target_lifecycle_state "active";       # feasible is true
(node: $lifecycle_node_inactive) isa set_lifecycle_state, has target_lifecycle_state "inactive";     # feasible is true
(node: $lifecycle_node_inactive) isa set_lifecycle_state, has target_lifecycle_state "unconfigured"; # feasible is true
(node: $lifecycle_node_inactive) isa set_lifecycle_state, has target_lifecycle_state "finalized";    # feasible is true

(node: $lifecycle_node_unconfigured) isa set_lifecycle_state, has target_lifecycle_state "active";       # feasible is false
(node: $lifecycle_node_unconfigured) isa set_lifecycle_state, has target_lifecycle_state "inactive";     # feasible is true
(node: $lifecycle_node_unconfigured) isa set_lifecycle_state, has target_lifecycle_state "unconfigured"; # feasible is true
(node: $lifecycle_node_unconfigured) isa set_lifecycle_state, has target_lifecycle_state "finalized";    # feasible is true

(node: $lifecycle_node_finalized) isa set_lifecycle_state, has target_lifecycle_state "active";       # feasible is false
(node: $lifecycle_node_finalized) isa set_lifecycle_state, has target_lifecycle_state "inactive";     # feasible is false
(node: $lifecycle_node_finalized) isa set_lifecycle_state, has target_lifecycle_state "unconfigured"; # feasible is false
(node: $lifecycle_node_finalized) isa set_lifecycle_state, has target_lifecycle_state "finalized";    # feasible is true

## test tactic_rule_consequent_unfeasible
$f_selectable isa Feature, has feature_name "f_selectable", has selectable true;
$f_not_selectable isa Feature, has feature_name "f_not_selectable", has selectable false;

# anonymous feature_adaptations (used as consequent in tactic_rule — cannot be named here)
$fa_sel isa feature_adaptation,
    links (activation: $f_selectable);
$fa_not_sel isa feature_adaptation,
    links (activation: $f_not_selectable);

## tactic_rule_consequent_variant_resolution_unfeasible
$f_vr_1 isa Feature, has feature_name "f_vr_1";
$f_vr_2 isa Feature, has feature_name "f_vr_2";
$f_vr_3 isa Feature, has feature_name "f_vr_3";

# anonymous feature_adaptations for variant resolution
$fa_vr1 isa feature_adaptation,
    links (activation: $f_vr_1);
$fa_vr2 isa feature_adaptation,
    links (activation: $f_vr_2);
$fa_vr3 isa feature_adaptation,
    links (activation: $f_vr_3);

$t isa Tactic, has tactic_name "tactic";

$tr1 isa tactic_rule,
    links (tactic: $t, antecedent: $exp1),
    has rule_name "tr1"; # true
$tr2 isa tactic_rule,
    links (tactic: $t, antecedent: $exp2),
    has rule_name "tr2"; # false

$and_exp1 isa and_expression,
    links (expression: $exp1, expression: $exp2),
    has expression_name 'and_exp1'; # true && false -> false

$and_exp2 isa and_expression,
    links (expression: $exp1, expression: $exp4),
    has expression_name 'and_exp2'; # true && true -> true

$or_exp1 isa or_expression,
    links (expression: $exp1, expression: $exp2),
    has expression_name 'or_exp1'; # true || false -> true

$or_exp2 isa or_expression,
    links (expression: $exp1, expression: $exp4),
    has expression_name 'or_exp2'; # true || true -> true

$or_exp3 isa or_expression,
    links (expression: $exp2, expression: $exp3),
    has expression_name 'or_tr7'; # false || false -> false

$tr3 isa tactic_rule,
    links (tactic: $t,antecedent: $and_exp1),
    has rule_name "tr3";

$tr4 isa tactic_rule,
    links (tactic: $t, antecedent: $and_exp2),
    has rule_name "tr4";


$tr5 isa tactic_rule,
    links (tactic: $t, antecedent: $or_exp1),
    has rule_name "tr5";


$tr6 isa tactic_rule,
    links (tactic: $t, antecedent: $or_exp2),
    has rule_name "tr6";


$tr7 isa tactic_rule,
    links (tactic: $t, antecedent: $or_exp3),
    has rule_name "tr7";

$tr_consq_feas isa tactic_rule,
    links (tactic: $t, consequent: $fa_sel),
    has rule_name "tr_consequent_feasible";   # rule_valid true


$tr_consq_unfeas isa tactic_rule,
    links (tactic: $t, consequent: $fa_not_sel),
    has rule_name "tr_consequent_unfeasible"; # rule_valid false


$tr_vr_feas isa tactic_rule,
    links (tactic: $t, consequent: $fa_vr1),
    has rule_name "tr_variant_resolution_feasible";   # rule_valid true


$tr_vr_unfeas_1 isa tactic_rule,
    links (tactic: $t, consequent: $fa_vr2),
    has rule_name "tr_variant_resolution_unfeasible_1"; # rule_valid false


$tr_vr_unfeas_2 isa tactic_rule,
    links (tactic: $t, consequent: $fa_vr3),
    has rule_name "tr_variant_resolution_unfeasible_2"; # rule_valid false

$vr1 isa variant_activation,
    links (resolution_action: $set_nodes_params_running, variant: $f_vr_1); # feasible true

$vr2 isa variant_activation,
    links (resolution_action: $set_nodes_params_not_running, variant: $f_vr_2); # feasible false

$vr3 isa variant_activation,
    links (resolution_action: $set_nodes_params_running, resolution_action: $set_nodes_params_not_running, variant: $f_vr_3); # feasible false

$res_model isa resolution_model,
    links (tactic: $t, variant_resolution: $vr1, variant_resolution: $vr2, variant_resolution: $vr3),
    has resolution_model_name "res_model", has ros_system "system";

## Additional coverage: variant_resolution with set_lifecycle_state resolution actions

$lifecycle_node_vr_test isa LifeCycleNode,
    has node_name "lifecycle_node_vr_test",
    has start_time 2025-09-06T11:57:56.666,
    has lifecycle_state "active";

$f_vr_lcs_feas isa Feature, has feature_name "f_vr_lcs_feas";
$f_vr_lcs_unfeas isa Feature, has feature_name "f_vr_lcs_unfeas";
$f_vr_zero_ra isa Feature, has feature_name "f_vr_zero_ra";

$fa_vr_lcs_feas isa feature_adaptation, links (activation: $f_vr_lcs_feas);
$fa_vr_lcs_unfeas isa feature_adaptation, links (activation: $f_vr_lcs_unfeas);
$fa_vr_zero_ra isa feature_adaptation, links (activation: $f_vr_zero_ra);

# set_lifecycle_state resolution actions for variant_resolution tests
$lcs_ra_feas isa set_lifecycle_state,
    links (node: $lifecycle_node_vr_test), has target_lifecycle_state "inactive";       # active→inactive: feasible
$lcs_ra_unfeas isa set_lifecycle_state,
    links (node: $lifecycle_node_vr_test), has target_lifecycle_state "unconfigured";   # active→unconfigured: infeasible

# variant_resolutions
$vr_lcs_feas isa variant_activation,
    links (resolution_action: $lcs_ra_feas, variant: $f_vr_lcs_feas);
$vr_lcs_unfeas isa variant_activation,
    links (resolution_action: $lcs_ra_unfeas, variant: $f_vr_lcs_unfeas);
$vr_zero_ra isa variant_activation,
    links (variant: $f_vr_zero_ra); # zero resolution_actions — vacuously feasible

# tactic_rules
$tr_vr_lcs_feas isa tactic_rule,
    links (tactic: $t, consequent: $fa_vr_lcs_feas),
    has rule_name "tr_vr_lcs_feasible";    # valid: lcs RA feasible
$tr_vr_lcs_unfeas isa tactic_rule,
    links (tactic: $t, consequent: $fa_vr_lcs_unfeas),
    has rule_name "tr_vr_lcs_unfeasible";  # invalid: lcs RA infeasible
$tr_vr_zero_ra isa tactic_rule,
    links (tactic: $t, consequent: $fa_vr_zero_ra),
    has rule_name "tr_vr_zero_ra_feasible"; # valid: zero RAs — vacuously feasible
