insert

## define Feature Model
$f_parent isa Feature, has feature_name "f_parent";
$f1 isa Feature, has feature_name "f1";
$f2 isa Feature, has feature_name "f2";
$f3 isa Feature, has feature_name "f3";
$f4 isa Feature, has feature_name "f4";
(
	parent: $f_parent,
	child: $f1,
	child: $f2,
	child: $f3,
	child: $f4) isa alternative;

## define tactic
$tactic1 isa Tactic, has tactic_name "tactic1";

# define measures
$measure_mock isa Measure, has measure_name "measure_mock";
$double_0_09 isa ValueSingleton,
    has double_value 0.09;
(measure: $measure_mock, measurement_value:$double_0_09) isa measurement,
        has measurement_time 2025-09-06T12:57:56.666;

$double_0_25 isa ValueSingleton,
    has double_value 0.25;

## define expression
$less_than isa less_than, links (lhs_value:$measure_mock, rhs_value: $double_0_25);

## define feature adaptation
$fa isa feature_adaptation, links (deactivation: $f1, activation: $f2, activation: $f3);

## define tactic rule
(tactic:$tactic1, antecedent:$less_than, consequent:$fa ) isa tactic_rule, has rule_name "rule1";

## define mock node
$mock_node1 isa ROSNode,
	has node_name "mock_node1",
	has namespace "mock_ns",
	has start_time 2025-08-06T10:57:56.666;

$mock_node2 isa ROSNode,
	has node_name "mock_node2",
	has namespace "mock_ns",
	has start_time 2025-08-06T10:57:56.666;

$mock_node3 isa ROSNode,
	has node_name "mock_node3",
	has namespace "mock_ns",
	has start_time 2025-08-06T10:57:56.666;

## define resolution action
$set_lifecycle_mock_node1_active isa set_lifecycle_state, links (node: $mock_node1), has lifecycle_state 'active';
$set_lifecycle_mock_node1_inactive isa set_lifecycle_state, links (node: $mock_node1), has lifecycle_state 'inactive';

$set_lifecycle_mock_node2_active isa set_lifecycle_state, links (node: $mock_node2), has lifecycle_state 'active';
$set_lifecycle_mock_node2_inactive isa set_lifecycle_state, links (node: $mock_node2), has lifecycle_state 'inactive';

$set_lifecycle_mock_node3_active isa set_lifecycle_state, links (node: $mock_node3), has lifecycle_state 'active';
$set_lifecycle_mock_node3_inactive isa set_lifecycle_state, links (node: $mock_node3), has lifecycle_state 'inactive';

## define variant resolutions

$f1_res_activate isa variant_activation, links (resolution_action: $set_lifecycle_mock_node1_active, variant: $f1);
$f1_res_inactive isa variant_deactivation, links (resolution_action: $set_lifecycle_mock_node1_inactive, variant: $f1);

$f2_res_active isa variant_activation, links (resolution_action: $set_lifecycle_mock_node2_active, variant: $f2);
$f2_res_inactive isa variant_deactivation, links (resolution_action: $set_lifecycle_mock_node2_inactive, variant: $f2);

$f3_res_active isa variant_activation, links (resolution_action: $set_lifecycle_mock_node3_active, variant: $f3);
$f3_res_inactive isa variant_deactivation, links (resolution_action: $set_lifecycle_mock_node3_inactive, variant: $f3);

$res_mock isa resolution_model,
	links (
		tactic: $tactic1,
		variant_resolution:$f1_res_activate,
		variant_resolution:$f1_res_inactive,
		variant_resolution:$f2_res_active,
		variant_resolution:$f2_res_inactive,
		variant_resolution:$f3_res_active,
		variant_resolution:$f3_res_inactive),
    has resolution_model_name "res_mock", has ros_system "mock";

# test add_measurements
$measure_string isa Measure, has measure_name "measure_string";
$measure_double isa Measure, has measure_name "measure_double";
$measure_integer isa Measure, has measure_name "measure_integer";
$measure_bool isa Measure, has measure_name "measure_bool";

$measure_string_array isa Measure, has measure_name "measure_string_array";
$measure_double_array isa Measure, has measure_name "measure_double_array";
$measure_integer_array isa Measure, has measure_name "measure_integer_array";
$measure_bool_array isa Measure, has measure_name "measure_bool_array";
