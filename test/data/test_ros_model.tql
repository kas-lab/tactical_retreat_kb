insert

$node_has_start_time isa ROSNode,
	has node_name "node_has_start_time",
	has start_time 2025-09-06T11:57:56.666;
$node_no_start_time isa ROSNode,
	has node_name "node_no_start_time";
$node_has_end_time isa ROSNode,
	has node_name "node_has_end_time",
	has start_time 2025-09-06T11:57:56.666,
	has end_time 2025-09-07T11:57:56.666;

## measurement interface
$measure_test_topic isa Measure, has measure_name 'measure_test_topic';
$measure_test_topic_pub isa Publisher,
	has interface_name '/measure_test_topic',
    has interface_type 'std_msgs/msg/Float64';
$qos_test isa QoSProfile,
	has reliability 'RELIABLE',
	has history 'KEEP_LAST',
	has depth 10,
	has durability 'TRANSIENT_LOCAL',
	has lifespan 2,
	has deadline 2,
	has liveliness 'MANUAL_BY_TOPIC',
	has lease_duration 2;
(interface: $measure_test_topic_pub, qos: $qos_test) isa has_qos;

(measure: $measure_test_topic, source: $measure_test_topic_pub) isa measurement_interface,
    has measurement_function_name 'get_data_field',
    has measurement_function_lib 'ros_monitors_functions.monitor_functions',
    has measurement_function_args 'data';

### measure_nearest_object measurement interface
$measure_nearest_object isa Measure, has measure_name "measure_nearest_object";

$scan_filtered_pub isa Publisher,
	has interface_name '/scan_filtered',
    has interface_type 'sensor_msgs/msg/LaserScan';
$sensor_qos isa QoSProfile,
	has reliability 'BEST_EFFORT',
	has history 'KEEP_LAST',
	has depth 5,
	has durability 'VOLATILE',
	has lifespan 0,
	has deadline 0,
	has liveliness 'SYSTEM_DEFAULT',
	has lease_duration 0;
(interface: $scan_filtered_pub, qos: $sensor_qos) isa has_qos;

$nearest_object_pub isa Publisher,
	has interface_name '/nearest_object',
	has interface_type 'std_msgs/msg/Float32';

(measure: $measure_nearest_object, source: $scan_filtered_pub, output: $nearest_object_pub) isa measurement_interface,
    has measurement_function_name 'get_nearest_scan_distance_in_base',
    has measurement_function_lib 'ros_monitors_functions.laser_scan_functions',
    has measurement_function_args 'base_link';

### measure_mean_velocity measurement interface
$measure_mean_velocity isa Measure, has measure_name "measure_mean_velocity";

$odom_pub isa Publisher,
	has interface_name '/odom',
    has interface_type 'nav_msgs/msg/Odometry';
$sensor_qos isa QoSProfile,
	has reliability 'BEST_EFFORT',
	has history 'KEEP_LAST',
	has depth 5,
	has durability 'VOLATILE',
	has lifespan 0,
	has deadline 0,
	has liveliness 'SYSTEM_DEFAULT',
	has lease_duration 0;
(interface: $odom_pub, qos: $sensor_qos) isa has_qos;

(measure: $measure_mean_velocity, source: $odom_pub) isa measurement_interface,
    has measurement_function_name 'MeanLinearVelocity',
    has measurement_function_lib 'ros_monitors_functions.odom_functions',
	has measurement_function_args '5.0';
	
	
$measure_test_service isa Measure, has measure_name "measure_test_service";

$measure_test_service_server isa ServiceServer,
	has interface_name '/measure_test_service',
    has interface_type 'std_srvs/srv/Trigger';
(measure: $measure_test_service, source: $measure_test_service_server) isa measurement_interface,
    has measurement_function_name 'get_data_field',
    has measurement_function_lib 'ros_monitors_functions.odom_functions',
    has measurement_function_lib 'ros_monitors_functions.monitor_functions',
    has measurement_function_args 'success';
