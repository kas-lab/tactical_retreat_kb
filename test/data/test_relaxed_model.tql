insert

$fake_system isa System, has system_name 'system';
$fake_req (system: $fake_system) isa relaxed_requirement,
    has requirement_name 'fake_req';


# Fuzzy logic

## fuzzy ascend
$fuzzy_ascend_measure isa Measure,
	has measure_name "fuzzy_ascend_measure",
	has description "amount of foodpackages";
$fuzzy_ascend_measure_expr (proposition: $fuzzy_ascend_measure) isa propositional_expression;

# just an example, the measurement should be inserted at runtime
$current_fuzzy_ascend_measure isa ValueDouble, has double_value 9.0;
(measure:$fuzzy_ascend_measure, measurement_value: $current_fuzzy_ascend_measure) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666;

$fuzzy_ascend_sigmoid_set isa FuzzySigmoid,
	has inflection_point 5.0,
	has exponent 0.5889;

$fuzzy_ascend_exponential_saturation_set isa FuzzyExponentialSaturation,
	has exponent 0.2;

$fuzzy_ascend_blf_set isa FuzzyBoundedLinearFraction,
	has curvature 0.5;

# expected membership 0.913378192
$fuzzy_ascend_expression_1 (ascend_membership: $fuzzy_ascend_sigmoid_set, proposition: $fuzzy_ascend_measure_expr) isa fuzzy_ascend_expression,
    has relaxed_expression_name 'fuzzy_ascend_sigmoid_expression';

# expected memberhsip 0.834700912
$fuzzy_ascend_expression_2 (ascend_membership: $fuzzy_ascend_exponential_saturation_set, proposition: $fuzzy_ascend_measure_expr) isa fuzzy_ascend_expression,
    has relaxed_expression_name 'fuzzy_ascend_exp_saturation_expression';

# expected memberhsip 0.947368421
$fuzzy_ascend_expression_3 (ascend_membership: $fuzzy_ascend_blf_set, proposition: $fuzzy_ascend_measure_expr) isa fuzzy_ascend_expression,
    has relaxed_expression_name 'fuzzy_ascend_blf_expression';

## fuzzy unimodal
$fuzzy_unimodal_measure isa Measure,
	has measure_name "fuzzy_unimodal_measure",
	has description "The robot's velocity";
$fuzzy_unimodal_measure_expr (proposition: $fuzzy_unimodal_measure) isa propositional_expression;

# just an example, the measurement should be inserted at runtime
$current_fuzzy_unimodal_measure isa ValueDouble, has double_value 0.03779;
(measure:$fuzzy_unimodal_measure, measurement_value: $current_fuzzy_unimodal_measure) isa measurement,
    has measurement_time 2025-08-06T10:57:56.666;

$fuzzy_unimodal_triangular_set isa FuzzyTriangular,
	has a -0.5,
	has b 0.0,
	has c 0.5;

$fuzzy_unimodal_gaussian_set isa FuzzyGaussian,
	has center 0.0,
    has sigma 0.1;

# expected membership 0.92442
$fuzzy_unimodal_expr_1 (unimodal_membership: $fuzzy_unimodal_triangular_set, proposition: $fuzzy_unimodal_measure_expr) isa fuzzy_unimodal_expression,
    has relaxed_expression_name 'fuzzy_unimodal_triangular_expression';

# expected membership 0.931085511
$fuzzy_unimodal_expr_2 (unimodal_membership: $fuzzy_unimodal_gaussian_set, proposition: $fuzzy_unimodal_measure_expr) isa fuzzy_unimodal_expression,
    has relaxed_expression_name 'fuzzy_unimodal_gaussian_expression';

## fuzzy decay

$fuzzy_decay_measure isa Measure,
	has measure_name "fuzzy_decay_measure",
	has description "The system consumes energy during normal operation";
$fuzzy_decay_measure_expr (proposition: $fuzzy_decay_measure) isa propositional_expression;
$current_fuzzy_decay_measure isa ValueDouble, has double_value 500;
(measure:$fuzzy_decay_measure, measurement_value: $current_fuzzy_decay_measure) isa measurement, has measurement_time 2025-08-06T10:57:56.666;

$fuzzy_decay_exp_set isa FuzzyExponentialDecay,
	has exponent 0.0002107;

$fuzzy_decay_rational_set isa FuzzyRationalDecay,
	has curvature 2000;

# expected membership 0.9
$fuzzy_decay_expr_1 (decay_membership: $fuzzy_decay_exp_set, proposition: $fuzzy_decay_measure_expr) isa fuzzy_decay_expression,
    has relaxed_expression_name 'fuzzy_decay_exp_expression';

# expected membership 0.8
$fuzzy_decay_expr_2 (decay_membership: $fuzzy_decay_rational_set, proposition: $fuzzy_decay_measure_expr) isa fuzzy_decay_expression,
    has relaxed_expression_name 'fuzzy_decay_rational_expression';


## Fuzzy operators

### fuzzy not

# expected membership (1 - 0.913378192) = 0.086621808
$fuzzy_not_0 (expression: $fuzzy_ascend_expression_1) isa fuzzy_not, has relaxed_expression_name 'fuzzy_not_0';

# expected membership (1 - 0.8) = 0.2
$fuzzy_not_1 (expression: $fuzzy_decay_expr_2) isa fuzzy_not, has relaxed_expression_name 'fuzzy_not_1';

### fuzzy or
# expected membership 0.931085511
$fuzzy_or_0 (expression: $fuzzy_unimodal_expr_2) isa fuzzy_or,
    has relaxed_expression_name 'fuzzy_or_0';

# expected membership 0.931085511
$fuzzy_or_1 (expression: $fuzzy_unimodal_expr_1, expression: $fuzzy_unimodal_expr_2) isa fuzzy_or,
    has relaxed_expression_name 'fuzzy_or_1';

# expected membership 0.947368421
$fuzzy_or_2 (
        expression: $fuzzy_ascend_expression_1,
        expression: $fuzzy_ascend_expression_2,
        expression: $fuzzy_ascend_expression_3,
        expression: $fuzzy_unimodal_expr_1,
        expression: $fuzzy_unimodal_expr_2,
        expression: $fuzzy_decay_expr_1,
        expression: $fuzzy_decay_expr_2
    ) isa fuzzy_or,
    has relaxed_expression_name 'fuzzy_or_2';

# expected membership 0.2
$fuzzy_or_3 (expression: $fuzzy_not_0, expression: $fuzzy_not_1) isa fuzzy_or,
    has relaxed_expression_name 'fuzzy_or_3';

### fuzzy and

# expected membership 0.931085511
$fuzzy_and_0 (expression: $fuzzy_unimodal_expr_2) isa fuzzy_and,
    has relaxed_expression_name 'fuzzy_and_0';

# expected membership 0.92442
$fuzzy_and_1 (expression: $fuzzy_unimodal_expr_1, expression: $fuzzy_unimodal_expr_2) isa fuzzy_and,
    has relaxed_expression_name 'fuzzy_and_1';

# expected membership 0.8
$fuzzy_and_2 (
        expression: $fuzzy_ascend_expression_1,
        expression: $fuzzy_ascend_expression_2,
        expression: $fuzzy_ascend_expression_3,
        expression: $fuzzy_unimodal_expr_1,
        expression: $fuzzy_unimodal_expr_2,
        expression: $fuzzy_decay_expr_1,
        expression: $fuzzy_decay_expr_2
    ) isa fuzzy_and,
    has relaxed_expression_name 'fuzzy_and_2';

# expected membership 0.086621808
$fuzzy_and_3 (expression: $fuzzy_not_0, expression: $fuzzy_not_1) isa fuzzy_and,
    has relaxed_expression_name 'fuzzy_and_3';

# expected membership 0.92442
$fuzzy_and_4 (expression: $fuzzy_unimodal_expr_1, expression: $fuzzy_or_1) isa fuzzy_and,
    has relaxed_expression_name 'fuzzy_and_4';

# expected membership 0.2
$fuzzy_and_5 (expression: $fuzzy_or_0, expression: $fuzzy_or_3) isa fuzzy_and,
    has relaxed_expression_name 'fuzzy_and_5';