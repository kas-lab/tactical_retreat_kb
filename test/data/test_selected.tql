has interface_name "detect_object_srv",
has interface_type "rebet_msgs/DetectObject";
(node: $detect_object_node, server: $detect_object_node_service_server_5) isa has_service;

$ta_frogmaxspeed isa Tactic, has tactic_name "FROGMaxSpeed";

# define Feature Model
$f_low_speed isa Feature, has feature_name "LOW_SPEED", has mandatory false;
$f_med_speed isa Feature, has feature_name "MED_SPEED", has mandatory false;
$f_hi_speed isa Feature, has feature_name "HI_SPEED", has mandatory false;


$t_measured_nearest_object isa Measure, has measure_name "nearest_object";

(measure: $t_measured_nearest_object, source: $ros_gz_bridge_node_pub_9) isa measurement_interface,
	    has measurement_function_name 'get_nearest_laser_scan_distance';
$t_measured_current_velocity isa Measure, has measure_name "current_velocity";

(measure: $t_measured_current_velocity, source: $ros_gz_bridge_node_pub_3) isa measurement_interface,
	    has measurement_function_name 'calc_linear_velocity';
$t_measured_power_draw isa Measure, has measure_name "power_draw";

(measure: $t_measured_power_draw, source: $ros_gz_bridge_node_pub_3) isa measurement_interface,
	    has measurement_function_name 'MovementPowerDraw';
$t_measured_power_budget isa Measure, has measure_name "power_budget";

(measure: $t_measured_power_budget, source: $detect_object_node_service_server_5) isa measurement_interface,
	    has service_request_kwargs '""',
	    has measurement_proxy true,
	    has measurement_function_name 'PowerBudget';

$nearest_object_less_val isa ValueDouble, has double_value 0.10;
$nearest_object_less (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_less_val) isa less_than;

$power_draw_greater_val isa ValueDouble, has double_value 40.0;
$power_draw_greater (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_greater_val) isa greater_than;

$expr_ (
expression:$nearest_object_less,
expression:$power_draw_greater
) isa or_expression;
$decrease_to_medfa (
activation: $f_med_speed
) isa feature_adaptation;
$tactic_rule_decrease_to_med (tactic:$ta_frogmaxspeed, antecedent:$expr_, consequent:$decrease_to_medfa ) isa tactic_rule, has rule_name "DECREASE_TO_MED";
$nearest_object_less_1_val isa ValueDouble, has double_value 0.10;
$nearest_object_less_1 (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_less_1_val) isa less_than;

$power_draw_greater_1_val isa ValueDouble, has double_value 40.0;
$power_draw_greater_1 (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_greater_1_val) isa greater_than;

$expr__1 (
expression:$nearest_object_less_1,
expression:$power_draw_greater_1
) isa or_expression;
$decrease_to_lowfa (
activation: $f_low_speed
) isa feature_adaptation;
$tactic_rule_decrease_to_low (tactic:$ta_frogmaxspeed, antecedent:$expr__1, consequent:$decrease_to_lowfa ) isa tactic_rule, has rule_name "DECREASE_TO_LOW";
$nearest_object_greater_val isa ValueDouble, has double_value 0.15;
$nearest_object_greater (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_greater_val) isa greater_than;

$power_draw_leq_val isa ValueDouble, has double_value 40.0;
$power_draw_leq (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_leq_val) isa less_than_equal;

$current_velocity_less_val isa ValueDouble, has double_value 0.40;
$current_velocity_less (lhs_value:$t_measured_current_velocity, rhs_value: $current_velocity_less_val) isa less_than;

$expr__2 (
expression:$nearest_object_greater,
expression:$power_draw_leq,
expression:$current_velocity_less
) isa or_expression;
$increase_to_medfa (
activation: $f_med_speed
) isa feature_adaptation;
$tactic_rule_increase_to_med (tactic:$ta_frogmaxspeed, antecedent:$expr__2, consequent:$increase_to_medfa ) isa tactic_rule, has rule_name "INCREASE_TO_MED";
$nearest_object_greater_1_val isa ValueDouble, has double_value 0.15;
$nearest_object_greater_1 (lhs_value:$t_measured_nearest_object, rhs_value: $nearest_object_greater_1_val) isa greater_than;

$power_draw_leq_1_val isa ValueDouble, has double_value 40.0;
$power_draw_leq_1 (lhs_value:$t_measured_power_draw, rhs_value: $power_draw_leq_1_val) isa less_than_equal;

$current_velocity_less_1_val isa ValueDouble, has double_value 0.40;
$current_velocity_less_1 (lhs_value:$t_measured_current_velocity, rhs_value: $current_velocity_less_1_val) isa less_than;

$expr__3 (
expression:$nearest_object_greater_1,
expression:$power_draw_leq_1,
expression:$current_velocity_less_1
) isa or_expression;
$increase_to_maxfa (
activation: $f_hi_speed
) isa feature_adaptation;
$tactic_rule_increase_to_max (tactic:$ta_frogmaxspeed, antecedent:$expr__3, consequent:$increase_to_maxfa ) isa tactic_rule, has rule_name "INCREASE_TO_MAX";
$sp_max_velocity_p_array_value isa ValueArray;
$sp_max_velocity_pvalue isa ValueDouble, has double_value 0.1;
$sp_max_velocity_p_array_value_elem_0 (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue) isa at_index, has index 0;
$sp_max_velocity_pvalue_1 isa ValueDouble, has double_value 0;
$sp_max_velocity_p_array_value_elem_1 (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue_1) isa at_index, has index 1;
$sp_max_velocity_pvalue_2 isa ValueDouble, has double_value 1;
$sp_max_velocity_p_array_value_elem_2 (array: $sp_max_velocity_p_array_value, array_value: $sp_max_velocity_pvalue_2) isa at_index, has index 2;

$sp_max_velocity (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $sp_max_velocity_p_array_value) isa set_nodes_parameters;
$low_speed_resolution_act (
	resolution_action: $sp_max_velocity
, variant: $f_low_speed) isa variant_activation;
$sp_max_velocity_1_p_array_value isa ValueArray;
$sp_max_velocity_1_pvalue isa ValueDouble, has double_value 0.18;
$sp_max_velocity_1_p_array_value_elem_0 (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue) isa at_index, has index 0;
$sp_max_velocity_1_pvalue_1 isa ValueDouble, has double_value 0;
$sp_max_velocity_1_p_array_value_elem_1 (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue_1) isa at_index, has index 1;
$sp_max_velocity_1_pvalue_2 isa ValueDouble, has double_value 1;
$sp_max_velocity_1_p_array_value_elem_2 (array: $sp_max_velocity_1_p_array_value, array_value: $sp_max_velocity_1_pvalue_2) isa at_index, has index 2;

$sp_max_velocity_1 (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $sp_max_velocity_1_p_array_value) isa set_nodes_parameters;
$med_speed_resolution_act (
	resolution_action: $sp_max_velocity_1
, variant: $f_med_speed) isa variant_activation;
$sp_max_velocity_2_p_array_value isa ValueArray;
$sp_max_velocity_2_pvalue isa ValueDouble, has double_value 0.26;
$sp_max_velocity_2_p_array_value_elem_0 (array: $sp_max_velocity_2_p_array_value, array_value: $sp_max_velocity_2_pvalue) isa at_index, has index 0;
$sp_max_velocity_2_pvalue_1 isa ValueDouble, has double_value 0;
$sp_max_velocity_2_p_array_value_elem_1 (array: $sp_max_velocity_2_p_array_value, array_value: $sp_max_velocity_2_pvalue_1) isa at_index, has index 1;
$sp_max_velocity_2_pvalue_2 isa ValueDouble, has double_value 1;
$sp_max_velocity_2_p_array_value_elem_2 (array: $sp_max_velocity_2_p_array_value, array_value: $sp_max_velocity_2_pvalue_2) isa at_index, has index 2;

$sp_max_velocity_2 (node: $velocity_smoother_node, parameter: $max_velocity_param, parameter_value: $max_velocity_param_p_array_value) isa set_nodes_parameters;
$hi_speed_resolution_act (
	resolution_action: $sp_max_velocity_2
, variant: $f_hi_speed) isa variant_activation;
$res_rebetmc (tactic: $ta_frogmaxspeed,
variant_resolution:$low_speed_resolution_act,
 variant_resolution:$med_speed_resolution_act,
 variant_resolution:$hi_speed_resolution_act
 )
 isa resolution_model,
    has resolution_model_name "rebetmc", has ros_system "rebet_mirte";