insert


$map_server_node isa LifeCycleNode,
has node_name "map_server",
has namespace "";
$bond_disable_heartbeat_timeout_param isa ParameterBool,
	has parameter_name "bond_disable_heartbeat_timeout";
$bond_disable_heartbeat_timeout_param_pvalue isa ValueBool, has bool_value true;
(node: $map_server_node,
parameter: $bond_disable_heartbeat_timeout_param,
parameter_value: $bond_disable_heartbeat_timeout_param_pvalue)
	isa has_parameter_value, has default_value true;
$frame_id_param isa ParameterString,
	has parameter_name "frame_id";
$frame_id_param_pvalue isa ValueString, has string_value "map";
(node: $map_server_node,
parameter: $frame_id_param,
parameter_value: $frame_id_param_pvalue)
	isa has_parameter_value, has default_value true;
$topic_name_param isa ParameterString,
	has parameter_name "topic_name";
$topic_name_param_pvalue isa ValueString, has string_value "map";
(node: $map_server_node,
parameter: $topic_name_param,
parameter_value: $topic_name_param_pvalue)
	isa has_parameter_value, has default_value true;
$use_sim_time_param isa ParameterBool,
	has parameter_name "use_sim_time";
$use_sim_time_param_pvalue isa ValueBool, has bool_value false;
(node: $map_server_node,
parameter: $use_sim_time_param,
parameter_value: $use_sim_time_param_pvalue)
	isa has_parameter_value, has default_value true;
$yaml_filename_param isa ParameterString,
	has parameter_name "yaml_filename";
$yaml_filename_param_pvalue isa ValueString, has string_value "/home/ega/rebetmc_ws/install/mirte_navigation/share/mirte_navigation/maps/map.yaml";
(node: $map_server_node,
parameter: $yaml_filename_param,
parameter_value: $yaml_filename_param_pvalue)
	isa has_parameter_value, has default_value true;

$map_server_node_parameters (
	node: $map_server_node,
	parameter: $bond_disable_heartbeat_timeout_param,
	parameter: $frame_id_param,
	parameter: $topic_name_param,
	parameter: $use_sim_time_param,
	parameter: $yaml_filename_param
	) isa has_parameter;
$map_server_node_pub isa Publisher,
has interface_name "map",
has interface_type "nav_msgs/OccupancyGrid";

(node: $map_server_node, publisher: $map_server_node_pub) isa has_topic;
$map_server_node_pub_1 isa Publisher,
has interface_name "~/transition_event",
has interface_type "lifecycle_msgs/TransitionEvent";

(node: $map_server_node, publisher: $map_server_node_pub_1) isa has_topic;
$map_server_node_service_server isa ServiceServer,
has interface_name "~/change_state",
has interface_type "lifecycle_msgs/ChangeState";
(node: $map_server_node, server: $map_server_node_service_server) isa has_service;
$map_server_node_service_server_1 isa ServiceServer,
has interface_name "~/get_available_states",
has interface_type "lifecycle_msgs/GetAvailableStates";
(node: $map_server_node, server: $map_server_node_service_server_1) isa has_service;
$map_server_node_service_server_2 isa ServiceServer,
has interface_name "~/get_available_transitions",
has interface_type "lifecycle_msgs/GetAvailableTransitions";
(node: $map_server_node, server: $map_server_node_service_server_2) isa has_service;
$map_server_node_service_server_3 isa ServiceServer,
has interface_name "~/get_state",
has interface_type "lifecycle_msgs/GetState";
(node: $map_server_node, server: $map_server_node_service_server_3) isa has_service;
$map_server_node_service_server_4 isa ServiceServer,
has interface_name "~/get_transition_graph",
has interface_type "lifecycle_msgs/GetAvailableTransitions";
(node: $map_server_node, server: $map_server_node_service_server_4) isa has_service;
$map_server_node_service_server_5 isa ServiceServer,
has interface_name "~/load_map",
has interface_type "nav2_msgs/LoadMap";
(node: $map_server_node, server: $map_server_node_service_server_5) isa has_service;
$map_server_node_service_server_6 isa ServiceServer,
has interface_name "~/map",
has interface_type "nav_msgs/GetMap";
(node: $map_server_node, server: $map_server_node_service_server_6) isa has_service;
