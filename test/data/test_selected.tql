(node: $detect_object_node,
parameter: $image_topic_name_param,
parameter_value: $image_topic_name_param_pvalue)
	isa has_parameter_value, has default_value true;
$num_predictions_param isa ParameterInteger,
	has parameter_name "num_predictions";
$num_predictions_param_pvalue isa ValueInteger, has integer_value 1;
(node: $detect_object_node,
parameter: $num_predictions_param,
parameter_value: $num_predictions_param_pvalue)
	isa has_parameter_value, has default_value true;
$use_sim_time_param_11 isa ParameterBool,
	has parameter_name "use_sim_time";
$use_sim_time_param_11_pvalue isa ValueBool, has bool_value false;
(node: $detect_object_node,
parameter: $use_sim_time_param_11,
parameter_value: $use_sim_time_param_11_pvalue)
	isa has_parameter_value, has default_value true;

$detect_object_node_parameters (
	node: $detect_object_node,
	parameter: $image_topic_name_param,
	parameter: $num_predictions_param,
	parameter: $use_sim_time_param_11
	) isa has_parameter;
